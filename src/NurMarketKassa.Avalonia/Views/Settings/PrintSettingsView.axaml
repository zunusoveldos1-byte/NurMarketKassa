<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.PrintSettingsView"
             x:CompileBindings="False"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="RadioButton.PrintModePill">
      <Setter Property="Foreground" Value="#0F172A"/>
      <Setter Property="Background" Value="#F8FAFC"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="RadioButton">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="0"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.PrintModePill:checked">
      <Setter Property="Background" Value="#FEF3C7"/>
      <Setter Property="BorderBrush" Value="#EAB308"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.PrintGoldButton">
      <Setter Property="Background" Value="#FFDB1F"/>
      <Setter Property="BorderBrush" Value="#E6C400"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="24,8"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost">
    <ScrollViewer Classes="SettingsPageScroll">
      <StackPanel Classes="SettingsCardList">

        <Border Classes="SettingsHeaderCard">
          <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="10" Background="#FEF3C7"
                    BorderBrush="#F59E0B" BorderThickness="1" Margin="0,0,12,0">
              <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="Печать" Classes="SettingsPageTitle"/>
              <TextBlock Text="Принтер чеков, режимы и параметры ESC/POS" Classes="SettingsPageSubtitle"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Основные параметры" Classes="SettingsCardTitle" VerticalAlignment="Center"/>
            <CheckBox x:Name="ReceiptEnabledCheck" x:FieldModifier="public"
                      Content="Печатать чек после оплаты" Classes="ToggleSwitch" Foreground="#0F172A"/>
          </Grid>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="10">
            <TextBlock Text="LPT-порт или путь" Classes="FieldLabel"/>
            <TextBox x:Name="ReceiptLptBox" x:FieldModifier="public" Classes="ModernTextBox"/>
            <TextBlock x:Name="StatusPortText" x:FieldModifier="public"
                       Text="○ LPT не найден в системе (нет драйвера)"
                       FontSize="11" Foreground="#DC2626"/>
            <Button x:Name="BtnPhysicalPrint" x:FieldModifier="public"
                    Content="🖨️  Печать" Classes="PrintGoldButton"/>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="0">
            <TextBlock Text="Повторы печати при сбое" Classes="FieldLabel"/>
            <TextBox x:Name="ReceiptRetryBox" x:FieldModifier="public" Classes="ModernTextBox" MaxWidth="280" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="12">
            <StackPanel Spacing="0">
              <TextBlock Text="Ширина ленты" Classes="FieldLabel"/>
              <ComboBox x:Name="ReceiptPaperWidthCombo" x:FieldModifier="public" Classes="TouchComboBox">
                <ComboBoxItem Content="58 мм (32 симв., 384 точки)" Tag="58"/>
                <ComboBoxItem Content="80 мм (48 симв., 576 точек)" Tag="80"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="0">
              <TextBlock Text="Ширина графики (точки)" Classes="FieldLabel"/>
              <TextBox x:Name="GraphicWidthBox" x:FieldModifier="public"
                       Text="384" Classes="ModernTextBox" IsReadOnly="True"
                       ToolTip.Tip="Задаётся автоматически по ширине ленты: 384 (58 мм) или 576 (80 мм)"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="12">
            <TextBlock Text="Режим печати" Classes="SettingsCardTitle"/>
            <Grid ColumnDefinitions="*,*">
              <RadioButton x:Name="TextModeRadio" x:FieldModifier="public"
                           Content="Текстовый (ESC/POS)" GroupName="PrintMode"
                           Classes="PrintModePill" Margin="0,0,-1,0" Foreground="#0F172A"
                           IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
              <RadioButton Grid.Column="1" x:Name="GraphicModeRadio" x:FieldModifier="public"
                           Content="Графический чек" GroupName="PrintMode"
                           Classes="PrintModePill" Foreground="#0F172A"
                           IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding #TextModeRadio.IsChecked}">
          <StackPanel Spacing="14">
            <TextBlock Text="ESC/POS" Classes="SettingsCardTitle"/>
            <StackPanel Spacing="0">
              <TextBlock Text="Кодировка текста" Classes="FieldLabel"/>
              <ComboBox x:Name="ReceiptEncCombo" x:FieldModifier="public" Classes="TouchComboBox">
                <ComboBoxItem Content="cp866 — кириллица DOS/OEM" Tag="cp866"/>
                <ComboBoxItem Content="cp1251 / windows-1251" Tag="cp1251"/>
                <ComboBoxItem Content="wpc1251 (слот 46)" Tag="wpc1251"/>
                <ComboBoxItem Content="iso-8859-5 (Кириллица ISO)" Tag="iso-8859-5"/>
                <ComboBoxItem Content="koi8-r (Unix-кодировка)" Tag="koi8-r"/>
                <ComboBoxItem Content="utf-8 (Юникод)" Tag="utf-8"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="0">
              <TextBlock Text="Таблица ESC t" Classes="FieldLabel"/>
              <ComboBox x:Name="ReceiptTableCombo" x:FieldModifier="public" Classes="TouchComboBox">
                <ComboBoxItem Content="Авто" Tag=""/>
                <ComboBoxItem Content="17 — CP866 / OEM" Tag="17"/>
                <ComboBoxItem Content="46 — CP1251 / WPC1251" Tag="46"/>
                <ComboBoxItem Content="73" Tag="73"/>
                <ComboBoxItem Content="26 — ISO 8859-5" Tag="26"/>
                <ComboBoxItem Content="53 — KOI8-R" Tag="53"/>
                <ComboBoxItem Content="0 — UTF-8 (редко)" Tag="0"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="0">
              <TextBlock Text="ESC R (0–255)" Classes="FieldLabel"/>
              <TextBox x:Name="ReceiptEscRBox" x:FieldModifier="public" Classes="ModernTextBox"/>
            </StackPanel>
            <Button x:Name="TestTextPrintButton" x:FieldModifier="public"
                    Content="👁  Предпросмотр текстового чека"
                    Classes="SettingsFlatButton" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard" IsVisible="{Binding #GraphicModeRadio.IsChecked}">
          <StackPanel Spacing="14">
            <TextBlock Text="Графический чек" Classes="SettingsCardTitle"/>
            <CheckBox x:Name="GraphicReceiptEnabledCheck" x:FieldModifier="public"
                      Content="Включить графический чек" Classes="ToggleSwitch"
                      Foreground="#0F172A"/>
            <StackPanel Spacing="0">
              <TextBlock Text="Шрифт" Classes="FieldLabel"/>
              <ComboBox x:Name="GraphicFontCombo" x:FieldModifier="public" Classes="TouchComboBox">
                <ComboBoxItem Content="Consolas (рекомендуется)" Tag="Consolas"/>
                <ComboBoxItem Content="Lucida Console" Tag="Lucida Console"/>
                <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                <ComboBoxItem Content="Arial" Tag="Arial"/>
                <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="0">
              <TextBlock Text="Размер шрифта (пиксели)" Classes="FieldLabel"/>
              <ComboBox x:Name="GraphicFontSizeCombo" x:FieldModifier="public" Classes="TouchComboBox">
                <ComboBoxItem Content="6" Tag="6"/>
                <ComboBoxItem Content="8" Tag="8"/>
                <ComboBoxItem Content="10" Tag="10"/>
                <ComboBoxItem Content="12" Tag="12"/>
                <ComboBoxItem Content="14" Tag="14"/>
                <ComboBoxItem Content="16" Tag="16"/>
                <ComboBoxItem Content="18" Tag="18"/>
                <ComboBoxItem Content="20" Tag="20"/>
                <ComboBoxItem Content="22" Tag="22"/>
                <ComboBoxItem Content="24" Tag="24"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="Элементы чека" Classes="FieldLabel" Margin="0,0,0,0"/>
            <StackPanel Spacing="8">
              <CheckBox x:Name="ShowStoreNameCheck" x:FieldModifier="public" Content="Название магазина" Classes="ToggleSwitch" Foreground="#0F172A"/>
              <CheckBox x:Name="ShowAddressCheck" x:FieldModifier="public" Content="Адрес" Classes="ToggleSwitch" Foreground="#0F172A"/>
              <CheckBox x:Name="ShowReceiptNumberCheck" x:FieldModifier="public" Content="Номер чека" Classes="ToggleSwitch" Foreground="#0F172A"/>
              <CheckBox x:Name="ShowDateCheck" x:FieldModifier="public" Content="Дата и время" Classes="ToggleSwitch" Foreground="#0F172A"/>
              <CheckBox x:Name="ShowItemsCheck" x:FieldModifier="public" Content="Список товаров" Classes="ToggleSwitch" Foreground="#0F172A"/>
              <CheckBox x:Name="ShowTotalCheck" x:FieldModifier="public" Content="Итог (сумма)" Classes="ToggleSwitch" Foreground="#0F172A"/>
              <CheckBox x:Name="ShowQrCodeCheck" x:FieldModifier="public" Content="QR-код" Classes="ToggleSwitch" Foreground="#0F172A"/>
            </StackPanel>
            <TextBlock Text="QR-код" Classes="FieldLabel"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="LoadGraphicQrButton" x:FieldModifier="public"
                      Content="📷  Загрузить QR-код" Classes="SettingsFlatButton" Height="36"/>
              <Button x:Name="DeleteGraphicQrButton" x:FieldModifier="public"
                      Content="🗑️  Удалить" Classes="SettingsFlatButton" Height="36"/>
            </StackPanel>
            <TextBlock x:Name="GraphicQrStatusText" x:FieldModifier="public"
                       Text="QR-код не загружен" FontSize="12" Foreground="#64748B"/>
            <Button x:Name="TestGraphicPrintButton" x:FieldModifier="public"
                    Content="👁  Предпросмотр графического чека"
                    Classes="SettingsFlatButton" HorizontalAlignment="Stretch"/>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="12">
            <TextBlock Text="Статус печати" Classes="SettingsCardTitle"/>
            <TextBox x:Name="StatusText" x:FieldModifier="public"
                     Classes="ModernTextBox" Height="72"
                     IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                     Foreground="#0F172A" Background="#F8FAFC"/>
            <Border x:Name="PrintErrorPanel" x:FieldModifier="public"
                    IsVisible="False"
                    CornerRadius="8" Padding="10"
                    Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1"
                    VerticalAlignment="Top">
              <StackPanel Spacing="6">
                <TextBlock Text="Подробности ошибки печати"
                           FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C"/>
                <TextBox x:Name="TxtPrintErrorDetails" x:FieldModifier="public"
                         IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12" MaxHeight="160"
                         BorderThickness="0" Background="Transparent" Foreground="#7F1D1D"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
