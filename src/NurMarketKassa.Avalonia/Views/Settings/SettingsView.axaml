<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Settings"
             xmlns:conv="using:NurMarketKassa.AvaloniaHost.Converters"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:CompileBindings="True"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

  <UserControl.Resources>
    <conv:AssetPathToBitmapConverter x:Key="AssetPathToBitmap"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views/Settings/SettingsSharedStyles.axaml"/>

    <Style Selector="Button.btn-primary">
      <Setter Property="Background" Value="#EAB308"/>
      <Setter Property="Foreground" Value="#111827"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#CA8A04"/>
      <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style Selector="Button.btn-secondary">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E2E8F0"/>
      <Setter Property="Foreground" Value="#334155"/>
    </Style>
  </UserControl.Styles>

  <Border Classes="SettingsContentHost">
    <ScrollViewer Classes="SettingsPageScroll">
      <StackPanel Classes="SettingsCardList">

        <Border Classes="SettingsHeaderCard">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Width="40" Height="40" CornerRadius="10" Background="#FCE7F3">
              <TextBlock Text="🎨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="Кастомизация" Classes="SettingsPageTitle"/>
              <TextBlock Text="Фон правой панели настроек и прозрачность подложки" Classes="SettingsPageSubtitle"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="14">
            <TextBlock Text="Обои" Classes="SettingsCardTitle"/>
            <TextBlock Text="Выберите изображение (PNG, JPG, JPEG, WEBP). Изменения применяются сразу."
                       Classes="SettingsCardBody"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Classes="main-primary"
                      Content="Выбрать изображение"
                      Command="{Binding PickBackgroundCommand}"
                      MinHeight="40" Padding="16,8"
                      VerticalAlignment="Top"/>
              <Button Classes="main-secondary"
                      Content="Сбросить"
                      Command="{Binding ClearBackgroundCommand}"
                      IsEnabled="{Binding HasBackgroundImage}"
                      MinHeight="40" Padding="16,8"
                      VerticalAlignment="Top"/>
            </StackPanel>
            <TextBlock Text="{Binding BackgroundImagePath}"
                       FontSize="11"
                       Foreground="#64748B"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasBackgroundImage}"/>
          </StackPanel>
        </Border>

        <Border Classes="SettingsCard">
          <StackPanel Spacing="12">
            <TextBlock Text="Прозрачность подложки" Classes="SettingsCardTitle"/>
            <TextBlock Text="От 5% до 80%. Чем выше значение, тем плотнее белая подложка поверх обоев. Сами обои остаются яркими."
                       Classes="SettingsCardBody"/>
            <Slider Minimum="0.05"
                    Maximum="0.8"
                    Value="{Binding BackgroundOpacity}"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    VerticalAlignment="Top"/>
            <TextBlock Text="{Binding BackgroundOpacityPercent}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#0F172A"
                       HorizontalAlignment="Right"/>
          </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Spacing="12"
                    VerticalAlignment="Top">
          <Button Content="Сохранить"
                  Classes="btn-primary"
                  Width="130"
                  Height="40"
                  Click="Save_Click"/>
          <Button Content="Закрыть"
                  Classes="btn-secondary"
                  Width="110"
                  Height="40"
                  Click="Close_Click"/>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
