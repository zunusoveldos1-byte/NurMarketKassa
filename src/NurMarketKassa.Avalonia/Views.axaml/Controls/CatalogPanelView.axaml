<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             xmlns:pos="using:NurMarketKassa.Models.Pos"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.CatalogPanelView"
             x:DataType="vm:CatalogPanelViewModel"
             x:CompileBindings="True">

    <Border Classes="main-panel"
            BorderThickness="0,0,1,0"
            Padding="16,14"
            HorizontalAlignment="Stretch">
        <Grid RowDefinitions="Auto,Auto,Auto,*"
              HorizontalAlignment="Stretch">
            <TabControl Grid.Row="0"
                        SelectedIndex="{Binding SelectedTabIndex}"
                        Margin="0,0,0,10">
                <TabItem Header="Все товары"/>
                <TabItem Header="Весовые"/>
                <TabItem Header="Штучные"/>
            </TabControl>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto,Auto,Auto"
                  Margin="0,0,0,10"
                  HorizontalAlignment="Stretch">
                <Border Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource BrushInput}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,0">
                    <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">
                        <TextBlock Classes="mdl2"
                                   Text="&#xE721;"
                                   FontSize="15"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText}"
                                 Watermark="Поиск товара..."
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 MinWidth="0"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        Classes="main-secondary"
                        Width="40" Height="40"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Фильтр"
                        Command="{Binding OpenFilterCommand}">
                    <TextBlock Text="⫶" FontSize="16"/>
                </Button>
                <Button Grid.Column="2"
                        Classes="main-primary"
                        Margin="8,0,0,0"
                        Command="{Binding OpenWarehouseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="+" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Товар" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Classes="main-ghost"
                        Width="36" Height="36"
                        Padding="0"
                        Margin="8,0,0,0"
                        ToolTip.Tip="Обновить каталог"
                        Command="{Binding RefreshCatalogCommand}">
                    <TextBlock Classes="mdl2" Text="&#xE72C;" FontSize="15"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,6" Spacing="4">
                <Border IsVisible="{Binding IsOfflineBannerVisible}"
                        Background="#FFF7ED"
                        BorderBrush="#FDBA74"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10,6">
                    <TextBlock Text="Работа в автономном режиме (из локальной БД)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#9A3412"
                               TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSoft}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="3"
                    Background="{DynamicResource BrushInputAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16">
                <Grid>
                    <Border Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="24,20"
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsCatalogEmpty}">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="📦"
                                       FontSize="36"
                                       HorizontalAlignment="Center"
                                       Opacity="0.45"/>
                            <TextBlock Text="Тут пока пусто.&#x0a;Идёт загрузка каталога из базы данных или с сервера..."
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSoft}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding IsLoading}"/>
                            <TextBlock Text="Тут пока пусто.&#x0a;Проверьте подключение и обновите каталог."
                                       FontSize="14"
                                       Foreground="{DynamicResource BrushTextSoft}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding !IsLoading}"/>
                            <Button Classes="main-secondary"
                                    Content="Обновить каталог"
                                    MinWidth="140"
                                    MinHeight="36"
                                    HorizontalAlignment="Center"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding RefreshCatalogCommand}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasProducts}">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pos:CatalogProductTileVm">
                                    <Grid Width="180" Margin="6" MinHeight="155">
                                        <Button Classes="main-ghost"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Command="{Binding $parent[UserControl].((vm:CatalogPanelViewModel)DataContext).SelectProductCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{DynamicResource BrushCatalogTileBg}"
                                                    BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12,10,12,0"
                                                    ClipToBounds="True"
                                                    Cursor="Hand"
                                                    MinHeight="155">
                                                <Grid RowDefinitions="*,18">
                                                    <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,4">
                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushText}"
                                                                   TextWrapping="Wrap"
                                                                   MaxLines="2"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,0,26,0"/>
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0" Spacing="4">
                                                            <TextBlock Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}}"
                                                                       FontSize="22"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource BrushCatalogPrice}"
                                                                       VerticalAlignment="Bottom"/>
                                                            <TextBlock Text="сом"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource BrushCatalogMeta}"
                                                                       Margin="0,0,0,2"
                                                                       VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding StockInfo}"
                                                                   FontSize="14"
                                                                   Margin="0,4,0,0"
                                                                   Foreground="{Binding StockForeground, Converter={StaticResource HexToBrushConverter}}"/>
                                                        <TextBlock Grid.Row="3"
                                                                   Text="{Binding Barcode, StringFormat=ШК: {0}}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource BrushCatalogMeta}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"/>
                                                    </Grid>
                                                    <Border Grid.Row="1"
                                                            Margin="-12,0,-12,0"
                                                            CornerRadius="0,0,12,12"
                                                            Background="{Binding TypeBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding TypeBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="White"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>

                                        <Button Width="28" Height="28"
                                                Padding="0"
                                                Margin="0,6,6,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                ZIndex="1"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ToolTip.Tip="Избранное"
                                                Command="{Binding $parent[UserControl].((vm:CatalogPanelViewModel)DataContext).ToggleFavoriteCommand}"
                                                CommandParameter="{Binding}">
                                            <Panel Width="16" Height="16">
                                                <Path Width="15" Height="15"
                                                      Stretch="Uniform"
                                                      Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z"
                                                      Fill="Transparent"
                                                      Stroke="{DynamicResource BrushCatalogFavoriteStroke}"
                                                      StrokeThickness="1.3"
                                                      IsVisible="{Binding !IsFavorite}"/>
                                                <Path Width="15" Height="15"
                                                      Stretch="Uniform"
                                                      Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z"
                                                      Fill="{DynamicResource BrushCatalogPrice}"
                                                      Stroke="{DynamicResource BrushCatalogPrice}"
                                                      StrokeThickness="1.3"
                                                      IsVisible="{Binding IsFavorite}"/>
                                            </Panel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
