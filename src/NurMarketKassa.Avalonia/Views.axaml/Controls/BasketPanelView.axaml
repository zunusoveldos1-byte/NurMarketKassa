<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.BasketPanelView"
             x:DataType="vm:BasketPanelViewModel"
             x:CompileBindings="True">

    <Border Classes="main-panel">
        <DockPanel LastChildFill="True">
            <ScrollViewer DockPanel.Dock="Top"
                          
                          
                          Margin="0,0,0,12">
                <ItemsControl ItemsSource="{Binding ReceiptTabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReceiptTabVm">
                            <Border Padding="12,7"
                                    CornerRadius="8"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    Background="{DynamicResource BrushInputAlt}">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Border Grid.Column="0"
                            Background="{DynamicResource BrushInput}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Margin="0,0,8,0"
                            Padding="12,0">
                        <TextBox Text="{Binding BarcodeInput}"
                                 Watermark="Введите код товара или название..."
                                 BorderThickness="0"
                                 Background="Transparent"
                                 MinHeight="42"
                                 FontSize="13"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Column="1"
                            Background="{DynamicResource BrushInputAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Margin="0,0,8,0">
                        <TextBox Text="{Binding ManualQuantity}"
                                 Width="48"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 TextAlignment="Center"
                                 FontWeight="Bold"
                                 VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="2"
                            Classes="main-primary"
                            Content="Добавить"
                            MinWidth="110"
                            Command="{Binding AddByBarcodeCommand}"/>
                </Grid>

            <UniformGrid Columns="3">
              <Button Classes="main-secondary"
                      Margin="0,0,6,0"
                      Command="{Binding DeferCartCommand}"
                      IsEnabled="{Binding HasItems}">
                <TextBlock Text="Отложить чек" HorizontalAlignment="Center"/>
              </Button>
              <Button Classes="main-secondary"
                      Margin="0,0,6,0"
                      Command="{Binding DeleteReceiptCommand}"
                      IsEnabled="{Binding HasItems}">
                <TextBlock Text="Удалить чек" HorizontalAlignment="Center"/>
              </Button>
              <Button Classes="main-secondary"
                      Command="{Binding ToggleMoreActionsCommand}"
                      IsEnabled="{Binding HasItems}">
                <TextBlock Text="Ещё" HorizontalAlignment="Center"/>
              </Button>
            </UniformGrid>

            <StackPanel IsVisible="{Binding IsMoreActionsVisible}" Spacing="8" Margin="0,0,0,4">
              <UniformGrid Columns="2">
                <Button Classes="main-secondary" Margin="0,0,6,0"
                        Content="Список отлож."
                        Command="{Binding OpenDeferredCartsCommand}"/>
                <Button Classes="main-secondary"
                        Content="Скидка %"
                        Command="{Binding ApplyOrderDiscountCommand}"/>
              </UniformGrid>
            </StackPanel>

            <Border Background="{DynamicResource BrushInputAlt}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Text="Итого" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <TextBlock Text="Скидка" Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DiscountDisplay}" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Grid.Row="2" Height="1" Background="{DynamicResource BrushBorder}" Margin="0,4,0,8"/>
                        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                            <TextBlock Text="К оплате" FontWeight="Bold" FontSize="16"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding TotalDisplay}"
                                       FontWeight="Bold"
                                       FontSize="16"
                                       Foreground="{DynamicResource BrushAccentStrong}"/>
                        </Grid>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding CartMessage}"
                           FontSize="11"
                           Foreground="{DynamicResource BrushTextSoft}"
                           TextWrapping="Wrap"/>

                <Button Classes="main-primary"
                        Command="{Binding PayCommand}"
                        MinHeight="48"
                        FontSize="15"
                        FontWeight="Bold"
                        Content="{Binding PayButtonText}"/>
            </StackPanel>

            <Border Background="{DynamicResource BrushInputAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="8"
                    MinHeight="200">
                <Grid>
                    <TextBlock Text="Чек пуст. Добавьте товар по штрихкоду или из каталога."
                               Foreground="{DynamicResource BrushTextSoft}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="16"
                               IsVisible="{Binding IsEmpty}"/>
                    <ListBox ItemsSource="{Binding Lines}"
                             Background="Transparent"
                             IsVisible="{Binding HasLines}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CartLineItemVm">
                                <Border CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,6"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        Background="{DynamicResource BrushCatalogTileBg}">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding PriceQuantityLine}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource BrushTextSoft}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Margin="0,0,8,0"
                                                    Spacing="2">
                                            <TextBlock Text="{Binding QuantityDisplay}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding LineTotalDisplay}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Classes="main-ghost"
                                                Width="32" Height="32"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                Content="❌"
                                                ToolTip.Tip="Удалить позицию"
                                                Command="{Binding $parent[UserControl].((vm:BasketPanelViewModel)DataContext).RemoveLineCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</UserControl>
