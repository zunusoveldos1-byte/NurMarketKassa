<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NurMarketKassa.ViewModels.Main"
             x:Class="NurMarketKassa.AvaloniaHost.Views.Main.Controls.SideMenuView"
             x:DataType="vm:SideMenuViewModel"
             x:CompileBindings="True">

    <Border Width="300"
            Background="{DynamicResource BrushPanel}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,1,0">
        <DockPanel>
            <Border DockPanel.Dock="Top"
                    Padding="16,14"
                    Background="{DynamicResource BrushPanelElevated}">
                <Grid>
                    <TextBlock Text="{Binding CashboxTitle}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center"/>
                    <Button Classes="main-ghost"
                            Content="✕"
                            Width="32" Height="32"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Command="{Binding CloseMenuCommand}"/>
                </Grid>
            </Border>

            <ScrollViewer DockPanel.Dock="Bottom"
                          >
                <StackPanel Margin="0,8,0,16" Spacing="2">
                    <Border Margin="12,0,12,10"
                            Padding="14"
                            CornerRadius="10"
                            Background="{DynamicResource BrushPanel}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Кассовая смена"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSoft}"/>
                            <TextBlock Text="{Binding ShiftBalanceText}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="РАБОТА"
                               Margin="16,4,16,6"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Главная"
                            Command="{Binding NavigateMainCommand}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Склад"
                            Command="{Binding NavigateWarehouseCommand}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Смена"
                            Command="{Binding NavigateShiftsCommand}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Возврат"
                            Command="{Binding NavigateReturnCommand}"/>

                    <TextBlock Text="СИСТЕМА"
                               Margin="16,12,16,6"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextSoft}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Финансы"
                            Command="{Binding NavigateFinanceCommand}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Продажи"
                            Command="{Binding NavigateSalesCommand}"/>
                    <Button Classes="main-ghost"
                            HorizontalAlignment="Stretch"
                            Content="Настройки"
                            Command="{Binding NavigateSettingsCommand}"/>

                    <Button Classes="main-secondary"
                            Margin="12,16,12,0"
                            HorizontalAlignment="Stretch"
                            Content="Выход"
                            Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
