<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NurMarketKassa.AvaloniaHost.Views.Main.Controls"
        xmlns:vm="using:NurMarketKassa.ViewModels.Main"
        xmlns:pos="using:NurMarketKassa.Models.Pos"
        x:Class="NurMarketKassa.AvaloniaHost.Views.MainKassir.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Касса — Nur Market"
        Width="1280"
        Height="840"
        MinWidth="940"
        MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource BrushText}"
        FontFamily="Segoe UI">

    <!-- Фон окна меняется автоматически при переключении Light/Dark темы -->
    <Window.Background>
        <SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
    </Window.Background>

    <Window.Styles>
        <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/MainViewStyles.axaml"/>

        <Style Selector="GridSplitter#CatalogGridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Border x:Name="GripLine"
                                Width="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                CornerRadius="2"
                                Background="#E2E8F0">
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="10">
                            </StackPanel>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter#CatalogGridSplitter:pointerover /template/ Border#GripLine">
            <Setter Property="Background" Value="#F7D617"/>
        </Style>

        <Style Selector="Button.cart-action">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Button.cart-action:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="Button.cart-qty, RepeatButton.cart-qty">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="RepeatButton.cart-qty">
            <Setter Property="Delay" Value="300"/>
            <Setter Property="Interval" Value="100"/>
        </Style>

        <Style Selector="Button.cart-delete">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cart-chip">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cart-accent">
            <Setter Property="Background" Value="#FACC15"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ListBox.cart-list">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="ListBox.cart-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ============================ Шапка ============================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Меню, логотип, название кассы -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="main-ghost"
                            Width="38" Height="38"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Меню"
                            Command="{Binding Toolbar.ToggleSideMenuCommand}">
                        <TextBlock Text="☰" FontSize="18"/>
                    </Button>
                    <Border Width="34" Height="34"
                            CornerRadius="17"
                            ClipToBounds="True">
                        <Image Source="avares://NurMarketKassa.Avalonia/Assets/app-logo.png"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="{Binding Toolbar.UserTitle}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Статус: сеть + баланс кассы/смены -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="18">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource BrushUiStatusOk}"
                                 IsVisible="{Binding Toolbar.Status.IsOnline}"/>
                        <Ellipse Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource BrushUiStatusWarn}"
                                 IsVisible="{Binding !Toolbar.Status.IsOnline}"/>
                        <TextBlock Text="{Binding Toolbar.Status.StatusLabel}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Toolbar.Status.NetworkModeText}"
                               FontSize="12"
                               Foreground="{DynamicResource BrushTextSoft}"
                               TextWrapping="Wrap"
                               MaxWidth="280"
                               VerticalAlignment="Center"/>

                    <!-- Баланс кассы, по умолчанию "Касса: 0.00 сом" -->
                    <TextBlock Text="{Binding Toolbar.Status.ShiftBalanceText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource BrushAccent}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Тема, клавиатура, смена -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <Button Classes="main-ghost"
                            Width="38" Height="38"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{Binding Toolbar.ThemeTooltip}"
                            Click="ToggleTheme_Click">
                        <TextBlock Classes="mdl2" Text="{Binding Toolbar.ThemeGlyph}" FontSize="15"/>
                    </Button>
                    <Button Classes="main-ghost"
                            Width="38" Height="38"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Экранная клавиатура"
                            Command="{Binding Toolbar.ToggleKeyboardCommand}">
                        <TextBlock Classes="mdl2" Text="&#xE92F;" FontSize="15"/>
                    </Button>
                    <Button Classes="main-outline"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="OpenShift_Click"
                            IsEnabled="{Binding Toolbar.CanOpenShift}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔓" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Открыть смену" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="main-primary"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="CloseShift_Click"
                            IsEnabled="{Binding Toolbar.CanCloseShift}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Закрыть смену" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================== Основной контент ======================== -->
        <Grid Grid.Row="1"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <!-- Каталог: разрешаем сжимать до 2 карточек в ряд (MinWidth="400") -->
                <ColumnDefinition Width="*" MinWidth="400"/>

                <!-- Разделитель -->
                <ColumnDefinition Width="Auto"/>

                <!-- Чек: MaxWidth выше, чтобы сплиттер мог сузить каталог до ~3 карточек -->
                <ColumnDefinition Width="380" MinWidth="320" MaxWidth="800"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== Каталог товаров (слева) ==================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0"
                    Padding="16,14">
                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <TabControl Grid.Row="0"
                                SelectedIndex="{Binding Catalog.SelectedTabIndex}"
                                Margin="0,0,0,10">
                        <TabItem Header="Все товары"/>
                        <TabItem Header="Весовые"/>
                        <TabItem Header="Штучные"/>
                    </TabControl>   

                    <!-- Поиск и действия -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto,Auto,Auto"
                          Margin="0,0,0,10">
                        <Border Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource BrushInput}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,0">
                            <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">
                                <TextBlock Classes="mdl2"
                                           Text="&#xE721;"
                                           FontSize="15"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Catalog.SearchText}"
                                         Watermark="Поиск товара..."
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         MinWidth="0"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1"
                                Classes="main-secondary"
                                Width="40" Height="40"
                                Padding="0"
                                Margin="8,0,0,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Фильтр"
                                Command="{Binding Catalog.OpenFilterCommand}">
                            <TextBlock Text="⫶" FontSize="16"/>
                        </Button>
                        <Button Grid.Column="2"
                                Classes="main-primary"
                                Margin="8,0,0,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{Binding Catalog.OpenWarehouseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="+" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="Товар" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="3"
                                Classes="main-ghost"
                                Width="36" Height="36"
                                Padding="0"
                                Margin="8,0,0,0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                ToolTip.Tip="Обновить каталог"
                                Command="{Binding Catalog.RefreshCatalogCommand}">
                            <TextBlock Classes="mdl2" Text="&#xE72C;" FontSize="15"/>
                        </Button>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding Catalog.StatusText}"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSoft}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <!-- Сетка карточек товаров -->
                    <Border Grid.Row="3"
                            Background="{DynamicResource BrushInputAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8">
                        <Grid>
                            <Border Background="{DynamicResource BrushPanel}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="24,20"
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Catalog.IsCatalogEmpty}">
                                <StackPanel Spacing="12" HorizontalAlignment="Center">
                                    <TextBlock Text="📦"
                                               FontSize="36"
                                               HorizontalAlignment="Center"
                                               Opacity="0.45"/>
                                    <TextBlock Text="Тут пока пусто.&#x0a;Идёт загрузка каталога из базы данных или с сервера..."
                                               FontSize="14"
                                               Foreground="{DynamicResource BrushTextSoft}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding Catalog.IsLoading}"/>
                                    <TextBlock Text="Тут пока пусто.&#x0a;Проверьте подключение и обновите каталог."
                                               FontSize="14"
                                               Foreground="{DynamicResource BrushTextSoft}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding !Catalog.IsLoading}"/>
                                    <Button Classes="main-secondary"
                                            Content="Обновить каталог"
                                            MinWidth="140"
                                            MinHeight="36"
                                            HorizontalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            Command="{Binding Catalog.RefreshCatalogCommand}"/>
                                </StackPanel>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding Catalog.HasProducts}">
                                <ItemsControl ItemsSource="{Binding Catalog.Products}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="pos:CatalogProductTileVm">
                                            <Grid Width="180" Margin="6" MinHeight="155">
                                                <!-- Выбор товара: отдельная кнопка, чтобы избранное не было вложенной Button -->
                                                <Button Classes="main-ghost"
                                                        Padding="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalAlignment="Stretch"
                                                        VerticalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Catalog.SelectProductCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Border Background="{DynamicResource BrushCatalogTileBg}"
                                                            BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12,10,12,0"
                                                            ClipToBounds="True"
                                                            Cursor="Hand"
                                                            MinHeight="155">
                                                        <Grid RowDefinitions="*,18">
                                                            <Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,0,0,4">
                                                                <TextBlock Grid.Row="0"
                                                                           Text="{Binding Title}"
                                                                           FontSize="13"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource BrushText}"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="2"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,0,26,0"/>
                                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0" Spacing="4">
                                                                    <TextBlock Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}}"
                                                                               FontSize="22"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource BrushCatalogPrice}"
                                                                               VerticalAlignment="Bottom"/>
                                                                    <TextBlock Text="сом"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource BrushCatalogMeta}"
                                                                               Margin="0,0,0,2"
                                                                               VerticalAlignment="Bottom"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding StockInfo}"
                                                                           FontSize="14"
                                                                           Margin="0,4,0,0"
                                                                           Foreground="{Binding StockForeground, Converter={StaticResource HexToBrushConverter}}"/>
                                                                <TextBlock Grid.Row="3"
                                                                           Text="{Binding Barcode, StringFormat=ШК: {0}}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource BrushCatalogMeta}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,2,0,0"/>
                                                            </Grid>
                                                            <Border Grid.Row="1"
                                                                    Margin="-12,0,-12,0"
                                                                    CornerRadius="0,0,12,12"
                                                                    Background="{Binding TypeBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                                                <TextBlock Text="{Binding TypeBadgeText}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Button>

                                                <!-- Звёздочка избранного — поверх карточки -->
                                                <Button Width="28" Height="28"
                                                        Padding="0"
                                                        Margin="0,6,6,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        ZIndex="1"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        ToolTip.Tip="Избранное"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Catalog.ToggleFavoriteCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Panel Width="16" Height="16">
                                                        <Path Width="15" Height="15"
                                                              Stretch="Uniform"
                                                              Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z"
                                                              Fill="Transparent"
                                                              Stroke="{DynamicResource BrushCatalogFavoriteStroke}"
                                                              StrokeThickness="1.3"
                                                              IsVisible="{Binding !IsFavorite}"/>
                                                        <Path Width="15" Height="15"
                                                              Stretch="Uniform"
                                                              Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z"
                                                              Fill="{DynamicResource BrushCatalogPrice}"
                                                              Stroke="{DynamicResource BrushCatalogPrice}"
                                                              StrokeThickness="1.3"
                                                              IsVisible="{Binding IsFavorite}"/>
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== Разделитель каталог / чек ==================== -->
            <GridSplitter x:Name="CatalogGridSplitter"
                          Grid.Column="1"
                          Width="12"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWestEast"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="False"/>

            <!-- ====================== Панель чека (справа) ====================== -->
            <Border Grid.Column="2"
                    Background="{DynamicResource BrushWindowAlt}"
                    Padding="16,14">
                <DockPanel LastChildFill="True">

                    <!-- Вкладки чеков + кнопка нового чека -->
                    <Grid DockPanel.Dock="Top"
                          ColumnDefinitions="*,Auto"
                          Margin="0,0,0,12">
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Basket.ReceiptTabs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReceiptTabVm">
                                        <Button Padding="0"
                                                BorderThickness="0"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                Command="{Binding SelectCommand}"
                                                CommandParameter="{Binding}">
                                            <Panel>
                                                <Border Padding="12,7"
                                                        CornerRadius="8"
                                                        Background="#FACC15"
                                                        IsVisible="{Binding IsActive}">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="#000000"/>
                                                </Border>
                                                <Border Padding="12,7"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource BrushInputAlt}"
                                                        IsVisible="{Binding !IsActive}">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextMuted}"/>
                                                </Border>
                                            </Panel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Padding="12,7"
                                MinHeight="34"
                                Background="{DynamicResource BrushInputAlt}"
                                BorderThickness="0"
                                CornerRadius="8"
                                Foreground="{DynamicResource BrushTextSoft}"
                                FontSize="12"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                Content="+ Новый чек"
                                Command="{Binding Basket.NewReceiptCommand}"/>
                    </Grid>

                    <!-- Нижний блок: ввод, действия, итоги, оплата -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,2">
                            <Border Grid.Column="0"
                                    Background="{DynamicResource BrushInput}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,0,8,0"
                                    Padding="12,0">
                                <TextBox Text="{Binding Basket.BarcodeInput}"
                                         Watermark="Введите код товара или название..."
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource BrushText}"
                                         MinHeight="42"
                                         FontSize="13"
                                         VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource BrushInputAlt}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0,0,8,0"
                                    Padding="2,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="0">
                                    <RepeatButton Classes="cart-qty"
                                                  Width="34" Height="40"
                                                  Background="Transparent"
                                                  Content="−"
                                                  Delay="300"
                                                  Interval="100"
                                                  Command="{Binding Basket.DecreaseManualQuantityCommand}"/>
                                    <TextBox Text="{Binding Basket.ManualQuantity}"
                                             Width="28"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Foreground="{DynamicResource BrushText}"
                                             TextAlignment="Center"
                                             FontWeight="Bold"
                                             VerticalAlignment="Center"/>
                                    <RepeatButton Classes="cart-qty"
                                                  Width="34" Height="40"
                                                  Background="Transparent"
                                                  Content="+"
                                                  Delay="300"
                                                  Interval="100"
                                                  Command="{Binding Basket.IncreaseManualQuantityCommand}"/>
                                </StackPanel>
                            </Border>
                            <Button Grid.Column="2"
                                    Classes="cart-accent"
                                    MinHeight="42"
                                    MinWidth="110"
                                    FontSize="13"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Content="Добавить"
                                    Command="{Binding Basket.AddByBarcodeCommand}"/>
                        </Grid>

                        <UniformGrid Columns="3">
                            <Button Classes="cart-action"
                                    Command="{Binding Basket.DeferCartCommand}"
                                    IsEnabled="{Binding Basket.HasItems}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Width="14" Height="14"
                                              Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M16.2,16.2L11,13V7H12.5V12.2L17,14.9L16.2,16.2Z"/>
                                    <TextBlock Text="Отложить чек" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="cart-action"
                                    Command="{Binding Basket.DeleteReceiptCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Width="14" Height="14"
                                              Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                    <TextBlock Text="Удалить чек" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="cart-action"
                                    Margin="0,0,0,6"
                                    Command="{Binding Basket.ToggleMoreActionsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Width="14" Height="14"
                                              Data="M12,16A2,2 0 0,1 14,18A2,2 0 0,1 12,20A2,2 0 0,1 10,18A2,2 0 0,1 12,16M12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12A2,2 0 0,1 12,10M12,4A2,2 0 0,1 14,6A2,2 0 0,1 12,8A2,2 0 0,1 10,6A2,2 0 0,1 12,4Z"/>
                                    <TextBlock Text="Ещё" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <UniformGrid Columns="3"
                                     Margin="0,-2,0,0"
                                     IsVisible="{Binding Basket.IsMoreActionsVisible}">
                            <Button Classes="cart-action"
                                    Content="Вернуть"
                                    Command="{Binding Basket.RestoreLastHeldReceiptCommand}"
                                    IsEnabled="{Binding Basket.HasHeldReceipts}"/>
                            <Button Classes="cart-action"
                                    Content="Список отлож."
                                    Command="{Binding Basket.OpenDeferredCartsCommand}"/>
                            <Button Classes="cart-action"
                                    Margin="0,0,0,6"
                                    Content="Скидка %"
                                    Command="{Binding Basket.ApplyOrderDiscountCommand}"
                                    IsEnabled="{Binding Basket.HasItems}"/>
                        </UniformGrid>

                        <TextBlock Text="{Binding Basket.CartMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource BrushUiStatusOk}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding Basket.HasCartMessage}"/>

                        <TextBlock Text="Промежуточный итог"
                                   FontSize="14"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,4">
                            <TextBlock Text="{Binding Basket.TotalAmount}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="#FACC15"/>
                            <TextBlock Text="сом"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushText}"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,6"/>
                        </StackPanel>

                        <Button Classes="cart-accent"
                                Height="52"
                                MinHeight="52"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="18"
                                Command="{Binding Basket.PayCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <PathIcon Width="20" Height="20"
                                          Foreground="#000000"
                                          Data="M20,8H4V6H20M20,18H4V12H20M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"/>
                                <TextBlock Text="{Binding Basket.PayButtonText}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#000000"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Позиции чека -->
                    <Border Background="Transparent"
                            Padding="0"
                            Margin="0,0,0,10"
                            MinHeight="200">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="12"
                                        IsVisible="{Binding Basket.IsEmpty}">
                                <TextBlock Text="🛒"
                                           FontSize="42"
                                           HorizontalAlignment="Center"
                                           Opacity="0.35"/>
                                <TextBlock Text="Добавьте товар или отсканируйте штрихкод"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="16"/>
                            </StackPanel>
                            <ListBox Classes="cart-list"
                                     ItemsSource="{Binding Basket.Lines}"
                                     IsVisible="{Binding Basket.HasLines}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CartLineItemVm">
                                        <Border Background="{DynamicResource BrushCatalogTileBg}"
                                                BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0"
                                                            Spacing="2"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Bold"
                                                               FontSize="15"
                                                               Foreground="{DynamicResource BrushText}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding PriceQuantityLine}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource BrushTextSoft}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            VerticalAlignment="Center">
                                                    <StackPanel Spacing="4"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Right"
                                                                Margin="0,0,2,0">
                                                        <TextBlock Text="{Binding LineTotalAmount}"
                                                                   FontSize="18"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FACC15"
                                                                   HorizontalAlignment="Right"/>
                                                        <Button Width="24" Height="20"
                                                                Padding="0"
                                                                Background="{DynamicResource BrushInputAlt}"
                                                                BorderThickness="0"
                                                                CornerRadius="12"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Скидка на товар"
                                                                Command="{Binding DiscountCommand}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="%"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource BrushTextMuted}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <Button Classes="cart-chip"
                                                            Content="Взвесить"
                                                            IsVisible="{Binding IsWeight}"
                                                            ToolTip.Tip="Указать вес"
                                                            Command="{Binding WeighCommand}"
                                                            CommandParameter="{Binding}"/>

                                                    <RepeatButton Classes="cart-qty"
                                                                  Content="−"
                                                                  Delay="300"
                                                                  Interval="100"
                                                                  ToolTip.Tip="Уменьшить"
                                                                  Command="{Binding DecreaseCommand}"
                                                                  CommandParameter="{Binding}"/>
                                                    <RepeatButton Classes="cart-qty"
                                                                  Content="+"
                                                                  Delay="300"
                                                                  Interval="100"
                                                                  ToolTip.Tip="Увеличить"
                                                                  Command="{Binding IncreaseCommand}"
                                                                  CommandParameter="{Binding}"/>

                                                    <Button Classes="cart-delete"
                                                            ToolTip.Tip="Убрать из чека"
                                                            Command="{Binding RemoveCommand}"
                                                            CommandParameter="{Binding}">
                                                        <PathIcon Width="14" Height="14"
                                                                  Foreground="{DynamicResource BrushDanger}"
                                                                  Data="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ======================= Боковое меню (overlay) ======================= -->
        <Panel Grid.RowSpan="2"
               ZIndex="200"
               IsVisible="{Binding IsSideMenuOpen}">
            <Border Background="#66000000"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    PointerPressed="OnSideMenuBackdropPressed"/>
            <controls:SideMenuView DataContext="{Binding SideMenu}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"/>
        </Panel>
    </Grid>
</Window>
