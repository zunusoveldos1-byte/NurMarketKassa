<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:NurMarketKassa.AvaloniaHost.Views.Main.Controls"
        xmlns:vm="using:NurMarketKassa.ViewModels.Main"
        xmlns:pos="using:NurMarketKassa.Models.Pos"
        x:Class="NurMarketKassa.AvaloniaHost.Views.MainKassir.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Касса — Nur Market"
        Width="1280"
        Height="840"
        MinWidth="900"
        MinHeight="600"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource BrushText}"
        FontFamily="Segoe UI">

  <!-- Фон окна меняется автоматически при переключении Light/Dark темы -->
  <Window.Background>
    <SolidColorBrush Color="{DynamicResource SystemRegionColor}"/>
  </Window.Background>

  <Window.Styles>
    <StyleInclude Source="avares://NurMarketKassa.Avalonia/Views.axaml/Shared/MainViewStyles.axaml"/>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- ============================ Шапка ============================ -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="0,0,0,1"
            Padding="16,10">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Меню, логотип, название кассы -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Spacing="10"
                    VerticalAlignment="Center">
          <Button Classes="main-ghost"
                  Width="38" Height="38"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  ToolTip.Tip="Меню"
                  Command="{Binding Toolbar.ToggleSideMenuCommand}">
            <TextBlock Text="☰" FontSize="18"/>
          </Button>
          <Border Width="34" Height="34"
                  CornerRadius="17"
                  ClipToBounds="True">
            <Image Source="avares://NurMarketKassa.Avalonia/Assets/app-logo.png"
                   Stretch="Uniform"/>
          </Border>
          <TextBlock Text="{Binding Toolbar.UserTitle}"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource BrushText}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Статус: сеть + баланс кассы/смены -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="18">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Ellipse Width="8" Height="8"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource BrushUiStatusOk}"
                     IsVisible="{Binding Toolbar.Status.IsOnline}"/>
            <Ellipse Width="8" Height="8"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource BrushUiStatusWarn}"
                     IsVisible="{Binding !Toolbar.Status.IsOnline}"/>
            <TextBlock Text="{Binding Toolbar.Status.StatusLabel}"
                       FontSize="12"
                       Foreground="{DynamicResource BrushTextSoft}"/>
          </StackPanel>

          <TextBlock Text="{Binding Toolbar.Status.NetworkModeText}"
                     FontSize="12"
                     Foreground="{DynamicResource BrushTextSoft}"
                     TextWrapping="Wrap"
                     MaxWidth="280"
                     VerticalAlignment="Center"/>

          <!-- Баланс кассы, по умолчанию "Касса: 0.00 сом" -->
          <TextBlock Text="{Binding Toolbar.Status.ShiftBalanceText}"
                     FontSize="13"
                     FontWeight="Bold"
                     Foreground="{DynamicResource BrushAccent}"
                     VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Тема, клавиатура, смена -->
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button Classes="main-ghost"
                  Width="38" Height="38"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  ToolTip.Tip="{Binding Toolbar.ThemeTooltip}"
                  Click="ToggleTheme_Click">
            <TextBlock Classes="mdl2" Text="{Binding Toolbar.ThemeGlyph}" FontSize="15"/>
          </Button>
          <Button Classes="main-ghost"
                  Width="38" Height="38"
                  Padding="0"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  ToolTip.Tip="Экранная клавиатура"
                  Command="{Binding Toolbar.ToggleKeyboardCommand}">
            <TextBlock Classes="mdl2" Text="&#xE92F;" FontSize="15"/>
          </Button>
          <Button Classes="main-outline"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Click="OpenShift_Click"
                  IsEnabled="{Binding Toolbar.CanOpenShift}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🔓" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="Открыть смену" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Classes="main-primary"
                  HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center"
                  Click="CloseShift_Click"
                  IsEnabled="{Binding Toolbar.CanCloseShift}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="🔒" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="Закрыть смену" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ======================== Основной контент ======================== -->
    <Grid Grid.Row="1"
          ColumnDefinitions="2*,*"
          MinHeight="0">

      <!-- ==================== Каталог товаров (слева) ==================== -->
      <Border Grid.Column="0"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              BorderBrush="{DynamicResource BrushBorder}"
              BorderThickness="0,0,1,0"
              Padding="16,14"
              MinWidth="400">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

          <TabControl Grid.Row="0"
                      SelectedIndex="{Binding Catalog.SelectedTabIndex}"
                      Margin="0,0,0,10">
            <TabItem Header="Все товары"/>
            <TabItem Header="Весовые"/>
            <TabItem Header="Штучные"/>
          </TabControl>

          <!-- Поиск и действия -->
          <Grid Grid.Row="1"
                ColumnDefinitions="*,Auto,Auto,Auto"
                Margin="0,0,0,10">
            <Border Grid.Column="0"
                    Background="{DynamicResource BrushInput}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10,0">
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock Classes="mdl2"
                           Text="&#xE721;"
                           FontSize="15"
                           Foreground="{DynamicResource BrushTextSoft}"
                           Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Catalog.SearchText}"
                         Watermark="Поиск товара..."
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <Button Grid.Column="1"
                    Classes="main-secondary"
                    Width="40" Height="40"
                    Padding="0"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Фильтр"
                    Command="{Binding Catalog.OpenFilterCommand}">
              <TextBlock Text="⫶" FontSize="16"/>
            </Button>
            <Button Grid.Column="2"
                    Classes="main-primary"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Command="{Binding Catalog.OpenWarehouseCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="+" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Товар" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="3"
                    Classes="main-ghost"
                    Width="36" Height="36"
                    Padding="0"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Обновить каталог"
                    Command="{Binding Catalog.RefreshCatalogCommand}">
              <TextBlock Classes="mdl2" Text="&#xE72C;" FontSize="15"/>
            </Button>
          </Grid>

          <TextBlock Grid.Row="2"
                     Text="{Binding Catalog.StatusText}"
                     FontSize="11"
                     Foreground="{DynamicResource BrushTextSoft}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,6"/>

          <!-- Сетка карточек товаров -->
          <Border Grid.Row="3"
                  Background="{DynamicResource BrushInputAlt}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="8">
            <Grid>
              <Border Background="{DynamicResource BrushPanel}"
                      BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Padding="24,20"
                      MaxWidth="360"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      IsVisible="{Binding Catalog.IsCatalogEmpty}">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                  <TextBlock Text="📦"
                             FontSize="36"
                             HorizontalAlignment="Center"
                             Opacity="0.45"/>
                  <TextBlock Text="Тут пока пусто.&#x0a;Идёт загрузка каталога из базы данных или с сервера..."
                             FontSize="14"
                             Foreground="{DynamicResource BrushTextSoft}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Catalog.IsLoading}"/>
                  <TextBlock Text="Тут пока пусто.&#x0a;Проверьте подключение и обновите каталог."
                             FontSize="14"
                             Foreground="{DynamicResource BrushTextSoft}"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             IsVisible="{Binding !Catalog.IsLoading}"/>
                  <Button Classes="main-secondary"
                          Content="Обновить каталог"
                          MinWidth="140"
                          MinHeight="36"
                          HorizontalAlignment="Center"
                          HorizontalContentAlignment="Center"
                          Command="{Binding Catalog.RefreshCatalogCommand}"/>
                </StackPanel>
              </Border>

              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding Catalog.HasProducts}">
                <ItemsControl ItemsSource="{Binding Catalog.Products}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="pos:CatalogProductTileVm">
                      <Button Classes="main-ghost"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Catalog.SelectProductCommand}"
                              CommandParameter="{Binding}">
                        <Border Margin="6"
                                MinHeight="150"
                                Background="{DynamicResource BrushCatalogTileBg}"
                                BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Cursor="Hand">
                          <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       MaxLines="2"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding PriceLine}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushCatalogPrice}"/>
                            <TextBlock Text="{Binding StockInfo}"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushCatalogMeta}"/>
                            <TextBlock FontSize="10"
                                       Foreground="{DynamicResource BrushCatalogMeta}">
                              <Run Text="Ед.: "/>
                              <Run Text="{Binding Unit}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Category}"
                                       FontSize="10"
                                       Foreground="{DynamicResource BrushCatalogMeta}"/>
                          </StackPanel>
                        </Border>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- ====================== Панель чека (справа) ====================== -->
      <Border Grid.Column="1"
              Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
              Padding="16,14"
              MinWidth="350">
        <DockPanel LastChildFill="True">

          <!-- Вкладки чеков + кнопка нового чека -->
          <Grid DockPanel.Dock="Top"
                ColumnDefinitions="*,Auto"
                Margin="0,0,0,12">
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Basket.ReceiptTabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ReceiptTabVm">
                    <Border Padding="12,7"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BrushBorder}"
                            Background="{DynamicResource BrushInputAlt}">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="12"
                                 FontWeight="SemiBold"/>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="1"
                    Classes="main-secondary"
                    Width="34" Height="34"
                    Padding="0"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    ToolTip.Tip="Новый чек"
                    Click="NewReceipt_Click">
              <TextBlock Text="+" FontSize="18" FontWeight="Bold"/>
            </Button>
          </Grid>

          <!-- Нижний блок: ввод, действия, итоги, оплата -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="10">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <Border Grid.Column="0"
                      Background="{DynamicResource BrushInput}"
                      BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="1"
                      CornerRadius="12"
                      Margin="0,0,8,0"
                      Padding="12,0">
                <TextBox Text="{Binding Basket.BarcodeInput}"
                         Watermark="Введите код товара или название..."
                         BorderThickness="0"
                         Background="Transparent"
                         MinHeight="42"
                         FontSize="13"
                         VerticalAlignment="Center"/>
              </Border>
              <Border Grid.Column="1"
                      Background="{DynamicResource BrushInputAlt}"
                      BorderBrush="{DynamicResource BrushBorder}"
                      BorderThickness="1"
                      CornerRadius="10"
                      Margin="0,0,8,0">
                <TextBox Text="{Binding Basket.ManualQuantity}"
                         Width="48"
                         BorderThickness="0"
                         Background="Transparent"
                         TextAlignment="Center"
                         FontWeight="Bold"
                         VerticalAlignment="Center"/>
              </Border>
              <Button Grid.Column="2"
                      Classes="main-primary"
                      MinHeight="36"
                      Content="Добавить"
                      MinWidth="110"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Command="{Binding Basket.AddByBarcodeCommand}"/>
            </Grid>

            <UniformGrid Columns="3">
              <Button Classes="main-secondary"
                      MinHeight="36"
                      Margin="0,0,6,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Content="Отложить чек"
                      Command="{Binding Basket.DeferCartCommand}"
                      IsEnabled="{Binding Basket.HasItems}"/>
              <Button Classes="main-secondary"
                      MinHeight="36"
                      Margin="0,0,6,0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Content="Удалить чек"
                      Command="{Binding Basket.ClearCartCommand}"
                      IsEnabled="{Binding Basket.HasItems}"/>
              <Button Classes="main-secondary"
                      MinHeight="36"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Content="Ещё"
                      Command="{Binding Basket.ToggleMoreActionsCommand}"
                      IsEnabled="{Binding Basket.HasItems}"/>
            </UniformGrid>

            <StackPanel IsVisible="{Binding Basket.IsMoreActionsVisible}" Spacing="8" Margin="0,0,0,8">
              <UniformGrid Columns="2">
                <Button Classes="main-secondary"
                        Margin="0,0,6,0"
                        Content="Список отлож."
                        Command="{Binding Basket.OpenDeferredCartsCommand}"/>
                <Button Classes="main-secondary"
                        Content="Скидка %"
                        Command="{Binding Basket.ApplyOrderDiscountCommand}"/>
              </UniformGrid>
            </StackPanel>

            <Border Background="{DynamicResource BrushInputAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Text="Итого" Foreground="{DynamicResource BrushTextSoft}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Basket.SubtotalDisplay}" FontWeight="SemiBold"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Text="Скидка" Foreground="{DynamicResource BrushTextSoft}"/>
                  <TextBlock Grid.Column="1" Text="{Binding Basket.DiscountDisplay}" FontWeight="SemiBold"/>
                </Grid>
                <Border Grid.Row="2" Height="1" Background="{DynamicResource BrushBorder}" Margin="0,4,0,8"/>
                <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                  <TextBlock Text="К оплате" FontWeight="Bold" FontSize="16"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding Basket.TotalDisplay}"
                             FontWeight="Bold"
                             FontSize="16"
                             Foreground="{DynamicResource BrushAccentStrong}"/>
                </Grid>
              </Grid>
            </Border>

            <TextBlock Text="{Binding Basket.CartMessage}"
                       FontSize="11"
                       Foreground="{DynamicResource BrushTextSoft}"
                       TextWrapping="Wrap"/>

            <!-- Главная кнопка оплаты -->
            <Button Height="48"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#EAB308"
                    Foreground="Black"
                    CornerRadius="10"
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Content="{Binding Basket.PayButtonText}"
                    Command="{Binding Basket.PayCommand}"/>
          </StackPanel>

          <!-- Позиции чека -->
          <Border Background="{DynamicResource BrushInputAlt}"
                  BorderBrush="{DynamicResource BrushBorder}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="8"
                  Margin="0,0,0,10"
                  MinHeight="200">
            <Grid>
              <StackPanel HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="12"
                          IsVisible="{Binding Basket.IsEmpty}">
                <TextBlock Text="🛒"
                           FontSize="42"
                           HorizontalAlignment="Center"
                           Opacity="0.35"/>
                <TextBlock Text="Добавьте товар или отсканируйте штрихкод"
                           Foreground="{DynamicResource BrushTextSoft}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="16"/>
              </StackPanel>
              <ListBox ItemsSource="{Binding Basket.Lines}"
                       Background="Transparent"
                       IsVisible="{Binding Basket.HasLines}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:CartLineItemVm">
                    <Border CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,6"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Background="{DynamicResource BrushCatalogTileBg}">
                      <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                          <TextBlock Text="{Binding Title}"
                                     FontWeight="SemiBold"
                                     FontSize="13"
                                     TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding PriceQuantityLine}"
                                     FontSize="11"
                                     Foreground="{DynamicResource BrushTextSoft}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,8,0"
                                    Spacing="2">
                          <TextBlock Text="{Binding QuantityDisplay}"
                                     FontWeight="SemiBold"
                                     HorizontalAlignment="Right"/>
                          <TextBlock Text="{Binding LineTotalDisplay}"
                                     FontWeight="Bold"
                                     HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="main-ghost"
                                Width="32" Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                Content="❌"
                                ToolTip.Tip="Удалить позицию"
                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Basket.RemoveLineCommand}"
                                CommandParameter="{Binding}"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ======================= Боковое меню (overlay) ======================= -->
    <Panel Grid.RowSpan="2"
           ZIndex="200"
           IsVisible="{Binding IsSideMenuOpen}">
      <Border Background="#66000000"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              PointerPressed="OnSideMenuBackdropPressed"/>
      <controls:SideMenuView DataContext="{Binding SideMenu}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Stretch"/>
    </Panel>
  </Grid>
</Window>
