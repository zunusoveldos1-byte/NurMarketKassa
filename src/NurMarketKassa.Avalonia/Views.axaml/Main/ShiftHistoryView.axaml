<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NurMarketKassa.Models"
             xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
             x:Class="NurMarketKassa.AvaloniaHost.Views.ShiftHistoryView"
             x:DataType="vm:ShiftHistoryViewModel"
             x:CompileBindings="True"
             FontFamily="Segoe UI, Inter, Noto Sans"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Styles>
        <!-- Кнопка создания операции -->
        <Style Selector="Button.PrimaryActionButton">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.PrimaryActionButton:pointerover">
            <Setter Property="Background" Value="#1D4ED8"/>
        </Style>

        <!-- Кнопка действия в DataGrid (три точки) -->
        <Style Selector="Button.ShiftActionButton">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style Selector="Button.ShiftActionButton:pointerover">
            <Setter Property="Background" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <!-- Метки параметров смены -->
        <Style Selector="TextBlock.ShiftFieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20" RowDefinitions="Auto, *, Auto">

        <!-- 0: Шапка страницы -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,0,0,16"
                BoxShadow="0 2 6 0 #0F000000">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="История смен" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Список всех кассовых смен и их текущие статусы"
                               FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="+ Новая операция"
                        Classes="PrimaryActionButton"
                        VerticalAlignment="Center"
                        Command="{Binding NewOperationCommand}"/>
            </Grid>
        </Border>

        <!-- 1: Основная рабочая область (Таблица + Сайдбар метрик) -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 16, 340">

            <!-- Таблица смен (Левая часть) -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    CornerRadius="12"
                    Padding="16"
                    BoxShadow="0 2 6 0 #0F000000">
                <Grid RowDefinitions="Auto, Auto, *">
                    <TextBlock Grid.Row="0"
                               Text="Список кассовых смен"
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="#0F172A"
                               Margin="0,0,0,12"/>
                    
                    <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="2"
                              x:CompileBindings="False"
                              ItemsSource="{Binding PagedShifts}"
                              SelectedItem="{Binding SelectedShift, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F1F5F9"
                              RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ Смены" Binding="{ReflectionBinding ShiftNumber}" Width="90"/>
                            <DataGridTextColumn Header="Открыта" Binding="{ReflectionBinding OpenedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Закрыта" Binding="{ReflectionBinding ClosedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                            <DataGridTextColumn Header="Кассир" Binding="{ReflectionBinding Cashier}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{ReflectionBinding Status}" Width="110"/>
                            <DataGridTextColumn Header="Выручка" Binding="{ReflectionBinding Revenue, StringFormat=\{0:N2\} сом}" Width="120"/>
                            
                            <!-- Колонка действий -->
                            <DataGridTemplateColumn Header="" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⋯"
                                                Classes="ShiftActionButton"
                                                HorizontalAlignment="Center"
                                                Command="{Binding $parent[UserControl].((vm:ShiftHistoryViewModel)DataContext).OpenShiftActionsCommand}"
                                                CommandParameter="{ReflectionBinding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Правая панель: Аналитика кассы и операции -->
            <Grid Grid.Column="2" RowDefinitions="*, 16, *">

                <!-- 1) Карточка: Общий план по кассе -->
                <Border Grid.Row="0"
                        Background="#FFFFFF"
                        CornerRadius="12"
                        Padding="16"
                        BoxShadow="0 2 6 0 #0F000000">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="Общий план по кассе" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="Баланс на начало" Classes="ShiftFieldLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OpeningBalanceText}" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="+ Внесено" Classes="ShiftFieldLabel" Foreground="#047857" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding DepositedTotalText}" FontWeight="Bold" Foreground="#059669" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="- Изъято" Classes="ShiftFieldLabel" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding WithdrawnTotalText}" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="Ожидаемый баланс" Classes="ShiftFieldLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ExpectedBalanceText}" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid ColumnDefinitions="1.3*, *">
                                    <TextBlock Grid.Column="0" Text="Выручка" Classes="ShiftFieldLabel" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding RevenueTotalText}" FontWeight="SemiBold" Foreground="#1E293B" HorizontalAlignment="Right"/>
                                </Grid>

                                <Rectangle Height="1" Fill="#E2E8F0" Margin="0,4"/>

                                <Border Background="#FEF9C3" CornerRadius="8" Padding="10,8" BorderBrush="#FDE047" BorderThickness="1">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="Фактический баланс" FontSize="12" FontWeight="Bold" Foreground="#854D0E" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ActualBalanceText}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 2) Карточка: Последние операции -->
                <Border Grid.Row="2"
                        Background="#FFFFFF"
                        CornerRadius="12"
                        Padding="16"
                        BoxShadow="0 2 6 0 #0F000000">
                    <Grid RowDefinitions="Auto, Auto, *">
                        <TextBlock Grid.Row="0" Text="Последние операции" FontWeight="Bold" FontSize="15" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0" Margin="0,0,0,10"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding RecentOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CashOperationModel">
                                        <Border Background="#F8FAFC"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding Type}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" FontSize="11" Foreground="#64748B"/>
                                                        <TextBlock Text="•" FontSize="11" Foreground="#94A3B8"/>
                                                        <TextBlock Text="{Binding Cashier}" FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding AmountDisplay}"
                                                           FontWeight="Bold"
                                                           FontSize="14"
                                                           Foreground="{Binding AmountBrush}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- 2: Пагинатор списка смен -->
        <Border Grid.Row="2"
                Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <Button Content="◀"
                        Command="{Binding PreviousPageCommand}"
                        ToolTip.Tip="Назад"
                        Height="36" Width="36" CornerRadius="6"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

                <ItemsControl ItemsSource="{Binding ShiftPagerEntries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PagerEntry">
                            <Button Content="{Binding Display}"
                                    Command="{Binding $parent[UserControl].((vm:ShiftHistoryViewModel)DataContext).GoToPageCommand}"
                                    CommandParameter="{Binding PageNumber}"
                                    IsEnabled="{Binding Kind}"
                                    Height="36" MinWidth="36" CornerRadius="6"
                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="▶"
                        Command="{Binding NextPageCommand}"
                        ToolTip.Tip="Вперёд"
                        Height="36" Width="36" CornerRadius="6"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>