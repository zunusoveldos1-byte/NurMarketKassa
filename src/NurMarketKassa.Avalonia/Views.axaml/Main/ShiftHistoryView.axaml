<UserControl x:Class="NurMarketKassa.AvaloniaHost.Views.ShiftHistoryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:NurMarketKassa.Models"
             xmlns:vm="using:NurMarketKassa.AvaloniaHost.ViewModels"
             x:DataType="vm:ShiftHistoryViewModel"
             x:CompileBindings="True"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="История смен" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Список всех кассовых смен и их статусы"
                           FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+  Новая операция" VerticalAlignment="Center"
                    Padding="18,10" Command="{Binding NewOperationCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Classes="ShiftSettingsCard" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Список кассовых смен" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" Margin="16,14,16,0"/>
                    <DataGrid Grid.Row="1" Classes="ShiftModernDataGrid"
                              x:CompileBindings="False"
                              ItemsSource="{Binding PagedShifts}"
                              SelectedItem="{Binding SelectedShift, Mode=TwoWay}"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер смены" Binding="{ReflectionBinding ShiftNumber}" Width="*"/>
                            <DataGridTextColumn Header="Открыта" Binding="{ReflectionBinding OpenedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="*"/>
                            <DataGridTextColumn Header="Закрыта" Binding="{ReflectionBinding ClosedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="*"/>
                            <DataGridTextColumn Header="Кассир" Binding="{ReflectionBinding Cashier}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{ReflectionBinding Status}" Width="*"/>
                            <DataGridTextColumn Header="Выручка" Binding="{ReflectionBinding Revenue, StringFormat=\{0:N2\} сом}" Width="*"/>
                            <DataGridTemplateColumn Header="Действия" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="⋯" Classes="ShiftActionButton"
                                                Command="{Binding $parent[UserControl].((vm:ShiftHistoryViewModel)DataContext).OpenShiftActionsCommand}"
                                                CommandParameter="{ReflectionBinding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Classes="ShiftSettingsCard">
                    <StackPanel>
                        <TextBlock Text="Общий план по кассе" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Баланс на начало смены" Classes="ShiftFieldLabel"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OpeningBalanceText}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Row="1" Text="+ Внесено" Classes="ShiftFieldLabel" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DepositedTotalText}" FontWeight="SemiBold" Foreground="#059669" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Text="- Изъято" Classes="ShiftFieldLabel" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WithdrawnTotalText}" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Text="Ожидаемый баланс" Classes="ShiftFieldLabel" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedBalanceText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Text="Выручка" Classes="ShiftFieldLabel" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RevenueTotalText}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="5" Text="Фактический баланс" FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActualBalanceText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Classes="ShiftSettingsCard">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Последние операции" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" >
                            <ItemsControl ItemsSource="{Binding RecentOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CashOperationModel">
                                        <Border Classes="ShiftOperationCard">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                               FontSize="11" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Cashier}" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding AmountDisplay}" FontWeight="Bold"
                                                           Foreground="{Binding AmountBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="0,12,0,4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="◀" Classes="ShiftPagerNavButton"
                        Command="{Binding PreviousPageCommand}" ToolTip.Tip="Назад"/>
                <ItemsControl ItemsSource="{Binding ShiftPagerEntries}" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PagerEntry">
                            <Button Margin="4,0" Content="{Binding Display}"
                                    Classes="ShiftPagerButton"
                                    Command="{Binding $parent[UserControl].((vm:ShiftHistoryViewModel)DataContext).GoToPageCommand}"
                                    CommandParameter="{Binding PageNumber}"
                                    IsEnabled="{Binding Kind}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="▶" Classes="ShiftPagerNavButton"
                        Command="{Binding NextPageCommand}" ToolTip.Tip="Вперёд"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
