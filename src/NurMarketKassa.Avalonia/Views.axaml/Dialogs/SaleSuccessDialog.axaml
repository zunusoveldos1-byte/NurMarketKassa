<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.SaleSuccessDialog"
        Title="Оплата выполнена"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Border Margin="16" CornerRadius="16"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel HorizontalAlignment="Center">
      <TextBlock Text="Оплата выполнена"
                 FontSize="20" FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,8"/>
      <TextBlock x:Name="AmountText"
                 FontSize="32" FontWeight="Bold"
                 Foreground="#059669"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,24"/>
      <Button Content="Напечатать чек"
              Height="46" MinWidth="280"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,10"
              Background="#F7D617"
              FontWeight="SemiBold"
              CornerRadius="10"
              Click="PrintButton_Click"/>
      <Button Content="Предпросмотр чека"
              Height="46" MinWidth="280"
              HorizontalAlignment="Stretch"
              Margin="0,0,0,10"
              Background="#F1F5F9"
              FontWeight="SemiBold"
              CornerRadius="10"
              Click="PreviewButton_Click"/>
      <Button Content="Закрыть"
              Height="46" MinWidth="280"
              HorizontalAlignment="Stretch"
              Background="#FFFFFF"
              BorderBrush="#CBD5E1"
              BorderThickness="1"
              FontWeight="SemiBold"
              CornerRadius="10"
              Click="CloseButton_Click"/>
    </StackPanel>
  </Border>
</Window>
