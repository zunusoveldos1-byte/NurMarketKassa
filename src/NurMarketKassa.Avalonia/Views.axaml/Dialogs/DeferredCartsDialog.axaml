<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.DeferredCartsDialog"
        Title="Отложенные корзины"
        Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Border Margin="16" CornerRadius="12"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0" BorderThickness="1"
          Padding="18">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Grid.Row="0" Text="Отложенные корзины"
                 FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
      <StackPanel Grid.Row="0" Margin="0,32,0,14">
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" Foreground="#007ACC"/>
        <TextBlock TextWrapping="Wrap" Foreground="#64748B" FontSize="12" Margin="0,8,0,0"
                   Text="Выберите одну или несколько корзин. Можно открыть отдельный чек или добавить позиции в текущую продажу."/>
      </StackPanel>
      <ListBox x:Name="CartListBox" Grid.Row="1"
               SelectionMode="Multiple"
               Margin="0,0,0,14"/>
      <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
        <Button x:Name="DeleteSelectedButton" Content="Удалить выбранные"
                Margin="0,0,10,0" Click="DeleteSelected_Click"/>
        <Button x:Name="MergeIntoCurrentButton" Content="Добавить в текущий чек"
                Margin="0,0,10,0" Click="MergeIntoCurrent_Click"/>
        <Button x:Name="LoadAsSeparateButton" Content="Открыть как отдельный чек"
                Click="LoadAsSeparate_Click"/>
      </WrapPanel>
    </Grid>
  </Border>
</Window>
