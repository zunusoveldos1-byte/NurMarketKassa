<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NurMarketKassa.ViewModels"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.CheckoutDialog"
        x:DataType="vm:CheckoutViewModel"
        x:CompileBindings="True"
        Title="Оплата"
        Width="960" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Grid Margin="24" RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Оплата покупки" FontSize="24" FontWeight="Bold"/>
      <TextBlock Text="Выберите способ оплаты и подтвердите сумму." Opacity="0.7"/>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,24,*" Margin="0,20,0,20">
      <StackPanel Grid.Column="0" Spacing="12">
        <TextBlock Text="ИТОГ К ОПЛАТЕ" FontWeight="SemiBold" Opacity="0.7"/>
        <TextBlock Text="{Binding BigTotalDisplay}" FontSize="48" FontWeight="Bold"/>
        <TextBlock Text="{Binding PayableDisplay}" FontSize="18"/>
        <TextBlock Text="{Binding DiscountSummaryDisplay}" Foreground="#C5221F"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Spacing="12">
        <TextBlock Text="СПОСОБ ОПЛАТЫ" FontWeight="SemiBold" Opacity="0.7"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <RadioButton Content="Наличные" GroupName="Pay" IsChecked="{Binding IsCash}"/>
          <RadioButton Content="Безналичные" GroupName="Pay" IsChecked="{Binding IsTransfer}"/>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsCashMode}" Spacing="8">
          <TextBlock Text="Получено наличными"/>
          <TextBox Text="{Binding CashReceived}"/>
          <TextBlock Text="{Binding ChangeAmountDisplay}" Foreground="#1E8E3E" FontSize="20" FontWeight="Bold"/>
        </StackPanel>
        <CheckBox Content="Напечатать чек" IsChecked="{Binding IsPrintReceiptEnabled}"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#C5221F"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="*,*">
      <Button Grid.Column="0" Content="Отмена" Click="Cancel_Click" HorizontalAlignment="Left" MinWidth="160"/>
      <Button Grid.Column="1" Content="{Binding PayButtonText}" Command="{Binding PayCommand}"
              HorizontalAlignment="Right" MinWidth="240" Classes="accent"/>
    </Grid>
  </Grid>
</Window>
