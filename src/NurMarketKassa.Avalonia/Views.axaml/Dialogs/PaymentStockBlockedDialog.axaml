<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.PaymentStockBlockedDialog"
        Title="Недостаточно товара"
        Width="520" SizeToContent="Height"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Border Margin="16" CornerRadius="16"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock Text="Оплата невозможна"
                 FontSize="18" FontWeight="Bold"
                 Foreground="#0F172A"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,12"/>

      <ScrollViewer MaxHeight="360" Margin="0,0,0,20">
        <TextBlock x:Name="BodyText"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="#64748B"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>
      </ScrollViewer>

      <Button Content="Понятно"
              Height="46" Width="240"
              HorizontalAlignment="Center"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Background="#F7D617"
              Foreground="#111827"
              FontWeight="SemiBold"
              CornerRadius="10"
              Cursor="Hand"
              Click="Ok_Click"/>
    </StackPanel>
  </Border>
</Window>