<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:NurMarketKassa.AvaloniaHost.Views.Dialogs"
        xmlns:pos="using:NurMarketKassa.Models.Pos"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.ReturnSaleDialog"
        x:DataType="dialogs:ReturnSaleDialog"
        x:CompileBindings="True"
        Title="Возврат по чеку"
        Width="900" Height="820"
        MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  <Border Margin="14" CornerRadius="12"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0" BorderThickness="1"
          Padding="20">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <StackPanel Grid.Row="0">
        <TextBlock Text="Возврат товаров по чеку" FontSize="20" FontWeight="Bold"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#64748B"
                   Text="Сверху — список чеков. Выберите чек кнопкой «Выбрать». Ниже появится состав чека: отметьте товары и «Вернуть выбранные» с общей причиной или оформите «Вернуть весь чек»."/>
      </StackPanel>

      <Grid Grid.Row="1" Margin="0,12,0,0" ColumnDefinitions="*,12,*">
        <!-- Блок 1: чеки -->
        <DockPanel Grid.Column="0" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="1. Чеки продаж"
                     FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBox x:Name="SearchReceiptBox" Width="150" Watermark="Поиск..."
                     TextChanged="SearchReceiptBox_TextChanged"/>
            <Button Content="Обновить" Click="RefreshSales_Click"/>
            <Button x:Name="MoreSalesButton" Content="Ещё" Click="MoreSales_Click"/>
          </StackPanel>
          <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10">
            <Grid>
              <DataGrid x:Name="SalesDataGrid"
                           x:CompileBindings="False"
                           ItemsSource="{Binding FilteredSales}"
                           AutoGenerateColumns="False"
                           IsReadOnly="True"
                           GridLinesVisibility="Horizontal"
                           HeadersVisibility="Column"
                           MaxHeight="420">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Номер чека" Binding="{ReflectionBinding SaleId}" Width="*"/>
                  <DataGridTextColumn Header="Дата" Binding="{ReflectionBinding SaleDateDisplay}" Width="120"/>
                  <DataGridTextColumn Header="Сумма" Binding="{ReflectionBinding TotalAmountDisplay}" Width="100"/>
                  <DataGridTemplateColumn Header="" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Content="Выбрать" Tag="{ReflectionBinding SaleId}" Click="SelectSale_Click"
                                HorizontalAlignment="Stretch" Padding="8,4"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top"
                           IsVisible="{Binding IsBusy}"/>
            </Grid>
          </Border>
        </DockPanel>

        <!-- Блок 2: содержимое чека -->
        <DockPanel Grid.Column="2" LastChildFill="True">
          <TextBlock DockPanel.Dock="Top" Text="2. Содержимое выбранного чека"
                     FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
          <Border x:Name="SelectedChequeBar" DockPanel.Dock="Top"
                  Margin="0,0,0,8" Padding="10,8"
                  Background="#F8FAFC" CornerRadius="6"
                  IsVisible="False">
            <TextBlock x:Name="SelectedSaleText" TextWrapping="Wrap"
                       Foreground="#64748B" FontSize="12"/>
          </Border>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,6">
            <Button Grid.Column="0" Content="Все" MinWidth="72" Padding="10,8"
                    Click="SelectAllReturnable_Click"/>
            <Button Grid.Column="1" Content="Снять" Margin="8,0,0,0"
                    MinWidth="72" Padding="10,8"
                    Click="ClearReturnSelection_Click"/>
            <Button x:Name="ReturnSelectedButton" Grid.Column="3"
                    Content="Вернуть выбранные" Margin="0,0,8,0"
                    MinWidth="160" Padding="12,10"
                    Click="ReturnSelected_Click"/>
            <Button x:Name="ReturnWholeReceiptButton" Grid.Column="4"
                    Content="Вернуть весь чек" MinWidth="150" Padding="12,10"
                    Click="ReturnWholeReceipt_Click"/>
          </Grid>
          <TextBlock x:Name="LinesPlaceholder" DockPanel.Dock="Top"
                     Margin="0,4,0,8" TextWrapping="Wrap"
                     HorizontalAlignment="Center" TextAlignment="Center"
                     Foreground="#94A3B8" FontSize="13"/>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Lines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pos:ReturnSaleLineVm">
                  <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                          Background="#F8FAFC">
                    <Grid ColumnDefinitions="Auto,*">
                      <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                IsEnabled="{Binding CanReturn}"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}"/>
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#64748B"
                                   Text="{Binding SubLine}"/>
                        <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#94A3B8"
                                   Text="{Binding LineSumText}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Grid>

      <TextBlock x:Name="ErrorText" Grid.Row="2"
                 Margin="0,10,0,0" Foreground="#C5221F"
                 IsVisible="False"/>

      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <Expander Header="Ввести ID продажи вручную">
          <StackPanel Margin="0,10,0,0" Spacing="10">
            <TextBox x:Name="SaleIdBox" MinHeight="40"/>
            <Button Content="Загрузить чек" HorizontalAlignment="Left"
                    MinWidth="160" Click="LoadById_Click"/>
          </StackPanel>
        </Expander>
        <Button Content="Закрыть" HorizontalAlignment="Right"
                MinWidth="110" Margin="0,14,0,0"
                Click="Close_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
