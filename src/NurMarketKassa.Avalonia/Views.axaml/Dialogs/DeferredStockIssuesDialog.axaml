<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NurMarketKassa.AvaloniaHost.Views.Dialogs.DeferredStockIssuesDialog"
        Title="Проблемы с остатками"
        Width="520" SizeToContent="Height"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        FontFamily="Segoe UI"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
  
  <Border Margin="16" CornerRadius="16"
          Background="#FFFFFF"
          BorderBrush="#E2E8F0" BorderThickness="1"
          BoxShadow="0 12 32 0 #33101828"
          Padding="28,24">
    <StackPanel HorizontalAlignment="Stretch">
      
      <!-- Заголовок отцентрирован -->
      <TextBlock Text="Проблемы с остатками"
                 FontSize="18" FontWeight="Bold"
                 Foreground="#0F172A"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Margin="0,0,0,16"/>
      
      <!-- Контент / текст отцентрирован -->
      <ScrollViewer MaxHeight="360" Margin="0,0,0,24">
        <TextBlock x:Name="BodyText" 
                   TextWrapping="Wrap" 
                   FontSize="14" 
                   Foreground="#64748B"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"/>
      </ScrollViewer>
      
      <!-- Кнопка растянута, текст "Понятно" строго по центру -->
      <Button Content="Понятно" 
              Height="46" 
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Background="#F7D617" 
              Foreground="#0F172A"
              FontWeight="SemiBold" 
              FontSize="15"
              CornerRadius="10"
              Cursor="Hand"
              Click="Ok_Click"/>
              
    </StackPanel>
  </Border>
</Window>