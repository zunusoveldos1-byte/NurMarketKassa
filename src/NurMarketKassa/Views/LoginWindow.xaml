<Window x:Class="NurMarketKassa.Views.LoginWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Вход — Nur Market"
	Icon="pack://application:,,,/Assets/app-logo.png"
	Height="590"
	Width="470"
	MinHeight="540"
	MinWidth="410"
	WindowStartupLocation="CenterScreen"
	ResizeMode="CanMinimize"
	Style="{StaticResource AppWindow}"
	Opacity="1"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <FrameworkElement.Triggers>
        <EventTrigger
			RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation
						Storyboard.TargetProperty="Opacity"
						From="0"
						To="1"
						Duration="0:0:0.25" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </FrameworkElement.Triggers>
    <Grid
		Background="{StaticResource BrushWindow}">
        <Border
			Style="{StaticResource ElevatedCardBorder}"
			CornerRadius="6"
			Margin="24"
			Padding="0"
			VerticalAlignment="Center">
            <UIElement.Effect>
                <DropShadowEffect
					BlurRadius="22"
					ShadowDepth="0"
					Opacity="0.35"
					Color="#000000" />
            </UIElement.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
						Height="Auto" />
                    <RowDefinition
						Height="Auto" />
                    <RowDefinition
						Height="Auto" />
                </Grid.RowDefinitions>
                <Border
					Grid.Row="0"
					Background="{StaticResource BrushInputAlt}"
					CornerRadius="6,6,0,0"
					Padding="22,20,22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
								Width="Auto" />
                            <ColumnDefinition
								Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
							Width="78"
							Height="78"
							Background="{StaticResource BrushAccentSoft}"
							BorderBrush="{StaticResource BrushAccent}"
							BorderThickness="1"
							CornerRadius="6">
                            <Image
								Source="pack://application:,,,/Assets/app-logo.png"
								Width="56"
								Height="56"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								RenderOptions.BitmapScalingMode="LowQuality" />
                        </Border>
                        <StackPanel
							Grid.Column="1"
							Margin="18,0,0,0"
							VerticalAlignment="Center">
                            <TextBlock
								Text="Добро пожаловать"
								FontSize="16"
								FontWeight="Bold"
								Foreground="{StaticResource BrushAccent}" />
                            <TextBlock
								Text="Nur Market"
								Margin="0,6,0,0"
								FontSize="28"
								FontWeight="Bold"
								Foreground="{StaticResource BrushText}" />
                            <TextBlock
								Text="Быстрый вход в кассу для начала продаж"
								Margin="0,6,0,0"
								FontSize="13"
								Foreground="{StaticResource BrushTextSoft}"
								TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
					Grid.Row="1"
					Margin="18,14,18,0"
					Style="{StaticResource ModernInfoPanel}">
                    <TextBlock
						Text="Введите данные для входа в кассу"
						FontSize="13"
						FontWeight="SemiBold"
						Foreground="{StaticResource BrushTextSoft}"
						TextAlignment="Center"
						TextWrapping="Wrap" />
                </Border>
                <Border
					Grid.Row="2"
					Margin="18,12,0,18"
					Style="{StaticResource ModernSectionBorder}"
					Padding="14">
                    <StackPanel>
                        <TextBlock
							Text="Email"
							Style="{StaticResource DialogLabelText}" />
                        <TextBox
							x:Name="EmailBox"
							Margin="0,4,0,12"
							Style="{StaticResource TouchTextBox}"
							KeyDown="EmailBox_KeyDown" />
                        <TextBlock
							Text="Пароль"
							Style="{StaticResource DialogLabelText}" />
                        <Grid
							Margin="0,4,0,0">
                            <PasswordBox
								x:Name="PasswordBox"
								Style="{StaticResource TouchPasswordBox}"
								KeyDown="PasswordBox_KeyDown" />
                            <TextBox
								x:Name="VisiblePasswordBox"
								Style="{StaticResource TouchTextBox}"
								Visibility="Collapsed"
								KeyDown="VisiblePasswordBox_KeyDown" />
                        </Grid>
                        <Grid
							Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
									Width="*" />
                                <ColumnDefinition
									Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox
								x:Name="ShowPasswordCheck"
								Content="Показать пароль"
								Style="{StaticResource TouchCheckBox}"
								Checked="ShowPasswordCheck_Changed"
								Unchecked="ShowPasswordCheck_Changed" />
                            <TextBlock
								Grid.Column="1"
								Text="Enter - вход"
								VerticalAlignment="Center"
								FontSize="10"
								Foreground="{StaticResource BrushTextSoft}" />
                        </Grid>
                        <TextBlock
							x:Name="ErrorText"
							Style="{StaticResource DialogErrorText}"
							FontSize="13"
							Margin="0,12,0,0"
							MinHeight="36"
							Visibility="Collapsed" />
                        <Grid
							Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
									Width="*" />
                                <ColumnDefinition
									Width="10" />
                                <ColumnDefinition
									Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
								x:Name="LoginButton"
								Grid.Column="0"
								Content="Войти"
								Style="{StaticResource TouchPrimaryButton}"
								Padding="14,10"
								Click="LoginButton_Click" />
                            <Button
								x:Name="ExitButton"
								Grid.Column="2"
								Content="Выйти из программы"
								Style="{StaticResource TouchDangerButton}"
								Padding="14,10"
								Command="{Binding ExitApplicationCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
