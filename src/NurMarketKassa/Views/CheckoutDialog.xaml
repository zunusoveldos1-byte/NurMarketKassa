<Window x:Class="NurMarketKassa.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата"
        Width="560" Height="Auto" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="18">
        <Border Style="{StaticResource ElevatedCardBorder}" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Оплата покупки"
                           Style="{StaticResource DialogTitleText}"/>
                <TextBlock Text="Завершите продажу и выберите удобный способ оплаты."
                           Margin="0,8,0,0"
                           Style="{StaticResource DialogLabelText}"/>
                <Border Style="{StaticResource ModernInfoPanel}"
                        Margin="0,16,0,0"
                        Background="{StaticResource BrushWindowAlt}">
                    <TextBlock x:Name="TotalLabel"
                               Style="{StaticResource MetricValueText}"/>
                </Border>
                <TextBlock Text="Способ оплаты"
                           Margin="0,16,0,6"
                           Style="{StaticResource DialogLabelText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbCash"
                                 Content="Наличные"
                                 GroupName="Pay"
                                 IsChecked="True"
                                 Style="{StaticResource TouchRadioButton}"
                                 Checked="PayMethod_Changed"/>
                    <RadioButton x:Name="RbTransfer"
                                 Content="Безнал"
                                 GroupName="Pay"
                                 Style="{StaticResource TouchRadioButton}"
                                 Checked="PayMethod_Changed"/>
                </StackPanel>
                <TextBlock Text="Получено наличными"
                           Style="{StaticResource DialogLabelText}"/>
                <TextBox x:Name="CashReceivedBox"
                         Style="{StaticResource TouchTextBox}"
                         Margin="0,4,0,4"
                         TextChanged="CashReceived_TextChanged"/>
                <TextBlock x:Name="ChangeDisplayText"
                           Style="{StaticResource DialogInlineValue}"
                           Margin="0,0,0,8"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource DialogErrorText}"
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            IsCancel="True"
                            Style="{StaticResource TouchGhostButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="Оплатить"
                            IsDefault="True"
                            Style="{StaticResource TouchPrimaryButton}"
                            Click="Pay_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
