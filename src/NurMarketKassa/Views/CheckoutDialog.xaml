<Window x:Class="NurMarketKassa.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата"
        Width="560" Height="Auto"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <FrameworkElement.Resources>
        <!-- Только стандартный конвертер -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Стиль для переключателей способа оплаты -->
        <Style x:Key="PaymentPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill"
                                Property="Background"
                                Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="pill"
                                Property="BorderBrush"
                                Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill"
                                Property="BorderBrush"
                                Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </FrameworkElement.Resources>
    <Grid Margin="18">
        <Border Style="{StaticResource ElevatedCardBorder}"
                CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Оплата покупки"
                           Style="{StaticResource DialogTitleText}" />
                <TextBlock Text="Завершите продажу и выберите удобный способ оплаты."
                           Margin="0,8,0,0"
                           Style="{StaticResource DialogLabelText}" />

                <Border Background="{DynamicResource BrushInputAlt}"
        CornerRadius="10"
        Padding="24,20"
        HorizontalAlignment="Stretch"
        Margin="0,12,0,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="ИТОГО К ОПЛАТЕ"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushTextSoft}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>
                        <Border Height="1"
                Background="{DynamicResource BrushBorder}"
                Width="80"
                HorizontalAlignment="Center"
                Margin="0,4,0,8"/>
                        <TextBlock Text="{Binding TotalDueString}"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="{DynamicResource BrushAccent}"
                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Способ оплаты"
           Margin="0,16,0,10"
           Style="{StaticResource DialogLabelText}"
           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,0,0,12">
                    <RadioButton x:Name="RbCash"
                 Content="💵 Наличные"
                 GroupName="Pay"
                 IsChecked="{Binding IsCash}"
                 Style="{StaticResource PaymentPill}"
                 Margin="0,0,8,0"/>
                    <RadioButton x:Name="RbTransfer"
                 Content="🏦 Безналичный"
                 GroupName="Pay"
                 IsChecked="{Binding IsTransfer}"
                 Style="{StaticResource PaymentPill}"/>
                </StackPanel>

                <!-- Наличные -->
                <StackPanel Visibility="{Binding IsCashMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Получено наличными"
                               Style="{StaticResource DialogLabelText}" />
                    <TextBox x:Name="CashReceivedBox"
                             Style="{StaticResource TouchTextBox}"
                             Margin="0,4,0,4"
                             Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding ChangeDisplay}"
                               Style="{StaticResource DialogInlineValue}"
                               Margin="0,0,0,8"
                               Visibility="{Binding HasChangeDisplay, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Безнал: банки и QR -->
                <StackPanel Visibility="{Binding IsBankSelectionVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Выберите банк для оплаты"
                               Style="{StaticResource DialogLabelText}" />
                    <ListBox ItemsSource="{Binding Banks}"
                             SelectedItem="{Binding SelectedBank}"
                             BorderThickness="0"
                             Background="Transparent"
                             Margin="0,6,0,12">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushInputAlt}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Margin="4"
                                        Cursor="Hand">
                                    <TextBlock Text="{Binding BankName}"
                                               Foreground="{DynamicResource BrushText}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Background="{DynamicResource BrushPanel}"
                        BorderBrush="{DynamicResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        HorizontalAlignment="Center"
                        Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding QrCodePath, TargetNullValue={x:Null}}"
                        Width="200" Height="200"
                        Stretch="Uniform" />
                    </Border>
                </StackPanel>
                
                <TextBlock Text="{Binding ErrorMessage}"
                           Style="{StaticResource DialogErrorText}"
                           Margin="0,0,0,12"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" IsCancel="True"
                            Style="{StaticResource TouchGhostButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click" />
                    <Button Content="Оплатить" IsDefault="True"
                            Style="{StaticResource TouchPrimaryButton}"
                            Command="{Binding PayCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>