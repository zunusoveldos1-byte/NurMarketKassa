<Window
	x:Class="NurMarketKassa.Views.CloseShiftDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Закрыть смену"
	Height="320"
	Width="470"
	ResizeMode="NoResize"
	WindowStartupLocation="CenterOwner"
	Style="{StaticResource AppWindow}"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <Grid
		Margin="18">
        <Border
			Style="{StaticResource ElevatedCardBorder}"
			CornerRadius="12">
            <StackPanel>
                <TextBlock
					Text="Закрыть смену"
					Style="{StaticResource DialogTitleText}" />
                <TextBlock
					Text="Укажите остаток наличных. Поле можно оставить пустым, если сумма не нужна."
					Margin="0,8,0,0"
					Style="{StaticResource DialogLabelText}" />
                <TextBlock
					Text="Остаток в кассе"
					Margin="0,18,0,4"
					Style="{StaticResource DialogLabelText}" />
                <TextBox
					x:Name="ClosingCashBox"
					Style="{StaticResource TouchTextBox}"
					Margin="0,0,0,22" />
                <StackPanel
					Orientation="Horizontal"
					HorizontalAlignment="Right">
                    <Button
						Content="Отмена"
						IsCancel="True"
						Style="{StaticResource TouchGhostButton}"
						Margin="0,0,10,0"
						Click="Cancel_Click" />
                    <Button
						Content="Закрыть смену"
						IsDefault="True"
						Style="{StaticResource TouchSecondaryButton}"
						Click="Ok_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
