<Window x:Class="NurMarketKassa.Views.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NurMarketKassa.Converters"
        Title="Дополнительные услуги"
        Height="800"
        Width="950"
        WindowStartupLocation="CenterOwner"
        Background="#F8F9FA">

    <FrameworkElement.Resources>
        <ResourceDictionary>
            <!-- Конвертеры -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InverseBool" />

            <!-- Стили карточек -->
            <Style x:Key="ServiceCard" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#E5E7EB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="6" />
                <Setter Property="Height" Value="260" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect Color="#E5E7EB" BlurRadius="8" ShadowDepth="2" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Жёлтая кнопка "Перейти" -->
            <Style x:Key="PrimaryActionYellow" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="#FFC107" />
                <Setter Property="Foreground" Value="#1F2937" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="btn" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btn" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="btn" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Белая кнопка "Подключить" -->
            <Style x:Key="SecondaryActionWhite" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="36" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#1F2937" />
                <Setter Property="BorderBrush" Value="#D1D5DB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#F3F4F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeader" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#4B5563" />
                <Setter Property="Margin" Value="6,16,6,6" />
            </Style>

            <!-- Стиль для кнопки закрытия "X" -->
            <Style x:Key="CloseButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="#6B7280" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#EF4444" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8F9FA">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- Заголовок -->
                <RowDefinition Height="Auto" />
                <!-- Подзаголовок -->
                <RowDefinition Height="Auto" />
                <!-- Интеграции -->
                <RowDefinition Height="Auto" />
                <!-- Разделитель и Расширения -->
            </Grid.RowDefinitions>

            <!-- ===== ЗАГОЛОВОК И КНОПКА X ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="✕" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click" />

                <TextBlock Grid.Column="1" Text="Дополнительные услуги" 
                           FontSize="28" FontWeight="Bold" 
                           Foreground="#111827" 
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Column="2" Width="36" />
                <!-- Пустая колонка для баланса -->
            </Grid>

            <TextBlock Grid.Row="1" 
                       Text="Расширьте возможности вашей CRM-системы с помощью наших дополнительных услуг. Выберите интересующую вас социальную сеть для подключения."
                       TextWrapping="Wrap"
                       Foreground="#6B7280"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,24"
                       MaxWidth="600" />

            <!-- ===== СЕКЦИЯ: ИНТЕГРАЦИИ ===== -->
            <TextBlock Grid.Row="2" Text="Интеграции" Style="{StaticResource SectionHeader}" />

            <!-- Карточки в 3 колонки -->
            <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,8">

                <!-- WhatsApp -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <Viewbox Width="32" Height="32" Margin="0,0,0,8">
                            <Path Fill="#1F2937" Data="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                        </Viewbox>
                        <TextBlock Text="WhatsApp" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Подключите чаты для удобного общения, быстрых автоматических ответов и полной интеграции с CRM."
                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Перейти" Style="{StaticResource PrimaryActionYellow}" Margin="0,0,8,0" />
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Telegram -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <Viewbox Width="32" Height="32" Margin="0,0,0,8">
                            <Path Fill="#1F2937" Data="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM8.287 5.906c-.778.324-2.334.994-4.666 2.01-.378.15-.577.298-.595.442-.03.243.275.339.69.47l.175.055c.408.133.958.288 1.243.294.26.006.549-.1.868-.32 2.179-1.471 3.304-2.214 3.374-2.23.05-.012.12-.026.166.016.047.041.042.12.037.141-.03.129-1.227 1.241-1.846 1.817-.193.18-.33.307-.358.336a8.154 8.154 0 0 1-.188.186c-.38.366-.664.64.015 1.088.327.216.589.393.85.571.284.194.568.387.936.629.093.06.183.125.27.187.331.236.63.448.997.414.214-.02.435-.22.547-.82.265-1.417.786-4.486.906-5.751a1.426 1.426 0 0 0-.013-.315.337.337 0 0 0-.114-.217.526.526 0 0 0-.31-.093c-.3.005-.763.166-2.984 1.09z"/>
                        </Viewbox>
                        <TextBlock Text="Telegram" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Подключите чаты для удобного общения, быстрых автоматических ответов и полной интеграции с CRM."
                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Instagram -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <Viewbox Width="32" Height="32" Margin="0,0,0,8">
                            <Path Fill="#1F2937" Data="M8 0C5.829 0 5.556.01 4.703.048 3.85.088 3.269.222 2.76.42a3.9 3.9 0 0 0-1.417.923A3.9 3.9 0 0 0 .42 2.76C.222 3.268.087 3.85.048 4.7.01 5.555 0 5.827 0 8.001c0 2.172.01 2.444.048 3.297.04.852.174 1.433.372 1.942.205.526.478.972.923 1.417.444.445.89.719 1.416.923.51.198 1.09.333 1.942.372C5.555 15.99 5.827 16 8 16s2.444-.01 3.298-.048c.851-.04 1.434-.174 1.943-.372a3.9 3.9 0 0 0 1.416-.923c.445-.445.718-.891.923-1.417.197-.509.332-1.09.372-1.942C15.99 10.445 16 10.173 16 8s-.01-2.445-.048-3.299c-.04-.851-.175-1.433-.372-1.941a3.9 3.9 0 0 0-.923-1.417A3.9 3.9 0 0 0 13.24.42c-.51-.198-1.092-.333-1.943-.372C10.443.01 10.172 0 7.998 0zm-.717 1.442h.718c2.136 0 2.389.007 3.232.046.78.035 1.204.166 1.486.275.373.145.64.319.92.599s.453.546.598.92c.11.281.24.705.275 1.485.039.843.047 1.096.047 3.231s-.008 2.389-.047 3.232c-.035.78-.166 1.203-.275 1.485a2.5 2.5 0 0 1-.599.919c-.28.28-.546.453-.92.598-.28.11-.704.24-1.485.276-.843.038-1.096.047-3.232.047s-2.39-.009-3.233-.047c-.78-.036-1.203-.166-1.485-.276a2.5 2.5 0 0 1-.92-.598 2.5 2.5 0 0 1-.6-.92c-.109-.281-.24-.705-.275-1.485-.038-.843-.046-1.096-.046-3.233s.008-2.388.046-3.231c.036-.78.166-1.204.276-1.486.145-.373.319-.64.599-.92s.546-.453.92-.598c.282-.11.705-.24 1.485-.276.738-.034 1.024-.044 2.515-.045zm4.988 1.328a.96.96 0 1 0 0 1.92.96.96 0 0 0 0-1.92m-4.27 1.122a4.109 4.109 0 1 0 0 8.217 4.109 4.109 0 0 0 0-8.217m0 1.441a2.667 2.667 0 1 1 0 5.334 2.667 2.667 0 0 1 0-5.334"/>
                        </Viewbox>
                        <TextBlock Text="Instagram" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Подключите Instagram для переписки с клиентами и централизованной обработки диалогов в CRM."
                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Документы -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <TextBlock Text="📄" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Документы" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Создание и хранение договоров, счетов и актов. Шаблоны, статусы и быстрые отправки клиентам."
                                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Перейти" Style="{StaticResource PrimaryActionYellow}" Margin="0,0,8,0" />
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Печать штрих-кодов -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Печать штрих-кодов" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Установка 2000 + абонентская плата 300. Печать штрих-кодов для товаров со склада с предпросмотром."
                                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Перейти" Style="{StaticResource PrimaryActionYellow}" Margin="0,0,8,0" />
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Интеграция с весами -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <TextBlock Text="⚖️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Интеграция с весами" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Установка 5000 + абонентская плата 500. Отправка товарной номенклатуры на торговые весы."
                                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Перейти" Style="{StaticResource PrimaryActionYellow}" Margin="0,0,8,0" />
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Интерфейс кассира -->
                <Border Style="{StaticResource ServiceCard}">
                    <StackPanel>
                        <TextBlock Text="🖥️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Интерфейс кассира" FontSize="18" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Подключение интерфейса кассира для быстрой продажи, оформления оплат и работы с чеками."
                                   TextWrapping="Wrap" Foreground="#6B7280" FontSize="13" TextAlignment="Center" Height="60" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Content="Перейти" Style="{StaticResource PrimaryActionYellow}" Margin="0,0,8,0" />
                            <Button Content="Подключить" Style="{StaticResource SecondaryActionWhite}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ===== СЕКЦИЯ: РАСШИРЕНИЯ ===== -->
            <TextBlock Grid.Row="3" Text="Расширения" Style="{StaticResource SectionHeader}" Margin="6,24,6,6" />

            <Border Grid.Row="3" Height="1" Background="#E5E7EB" Margin="0,0,0,16" />

            <TextBlock Grid.Row="3" 
                       Text="Мы свяжемся с вами в ближайшее время для обсуждения деталей подключения."
                       TextWrapping="Wrap"
                       Foreground="#9CA3AF"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,16,0,0" />

        </Grid>
    </ScrollViewer>
</Window>