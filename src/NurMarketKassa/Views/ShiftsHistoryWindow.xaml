<Window x:Class="NurMarketKassa.Views.ShiftsHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NurMarketKassa.Converters"
        Title="История смен"
        Height="600"
        Width="1000"
        MinHeight="400"
        MinWidth="700"
        Style="{DynamicResource AppWindow}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="ModernGrid" TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="#00FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="RowHeight" Value="40" />
                <Setter Property="GridLinesVisibility" Value="Vertical" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BrushBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Журнал кассовых смен"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushText}"
                   Margin="0,0,0,12" />
        <DataGrid x:Name="ShiftsGrid"
                  Grid.Row="1"
                  Style="{StaticResource ModernGrid}"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding Shifts}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер смены" Width="120" Binding="{Binding ShiftNumber}" />
                <DataGridTextColumn Header="Время открытия" Width="160"
                                    Binding="{Binding OpenedAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                <DataGridTextColumn Header="Время закрытия" Width="160"
                                    Binding="{Binding ClosedAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                <DataGridTextColumn Header="Кассир" Width="*" MinWidth="120" Binding="{Binding Cashier}" />
                <DataGridTextColumn Header="Статус" Width="110" Binding="{Binding Status}" />
                <DataGridTextColumn Header="Выручка за смену" Width="140"
                                    Binding="{Binding Revenue, StringFormat='{}{0:N2} сом'}" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Обновить" Style="{DynamicResource TouchSecondaryButton}"
                    Padding="16,8" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="Закрыть" IsCancel="True" Style="{DynamicResource TouchSecondaryButton}"
                    Padding="16,8" Click="Close_Click" />
        </StackPanel>
        <Border Grid.RowSpan="3" Background="#40000000" Panel.ZIndex="10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Загрузка..." Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,0,12" />
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"
                             Foreground="{DynamicResource BrushAccent}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
