<Window x:Class="NurMarketKassa.Views.OrderDiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скидка на чек"
        Width="520" Height="Auto" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="18">
        <Border Style="{StaticResource ElevatedCardBorder}" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Скидка на чек"
                           Style="{StaticResource DialogTitleText}"/>
                <TextBlock Text="Выберите тип скидки и введите значение. Можно применить только процент или только сумму."
                           Margin="0,8,0,0"
                           Style="{StaticResource DialogLabelText}"/>

                <Border Style="{StaticResource ModernInfoPanel}"
                        Margin="0,14,0,0"
                        Background="{StaticResource BrushWindowAlt}">
                    <TextBlock x:Name="CurrentDiscountText"
                               Style="{StaticResource DialogLabelText}"/>
                </Border>

                <TextBlock Text="Тип скидки"
                           Margin="0,14,0,6"
                           Style="{StaticResource DialogLabelText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbPercent"
                                 Content="Процент"
                                 GroupName="DiscountType"
                                 IsChecked="True"
                                 Style="{StaticResource TouchRadioButton}"
                                 Checked="DiscountType_Changed"/>
                    <RadioButton x:Name="RbSum"
                                 Content="Сумма"
                                 GroupName="DiscountType"
                                 Style="{StaticResource TouchRadioButton}"
                                 Checked="DiscountType_Changed"/>
                </StackPanel>

                <TextBlock x:Name="ValueLabel"
                           Style="{StaticResource DialogLabelText}"/>
                <TextBox x:Name="ValueBox"
                         Style="{StaticResource TouchTextBox}"
                         Margin="0,4,0,12"/>

                <TextBlock x:Name="ErrorText"
                           Style="{StaticResource DialogErrorText}"
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сбросить"
                            Style="{StaticResource TouchGhostButton}"
                            Margin="0,0,10,0"
                            Click="Clear_Click"/>
                    <Button Content="Отмена"
                            IsCancel="True"
                            Style="{StaticResource TouchGhostButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="Применить"
                            IsDefault="True"
                            Style="{StaticResource TouchPrimaryButton}"
                            Click="Apply_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
