<Window x:Class="NurMarketKassa.Views.Dialogs.ReceiptPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предварительный просмотр тестового чека"
        Width="460"
        Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#99000000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Border Background="White"
            CornerRadius="16"
            Margin="20"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.15" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtHeader"
                       Grid.Row="0"
                       Text="Предпросмотр чека"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#111827"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8">
                <WebBrowser x:Name="PdfBrowser" Margin="1"/>
            </Border>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Закрыть"
                        Height="42"
                        Margin="0,0,6,0"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnCancel_Click"/>

                <Button Grid.Column="1"
                        Content="Распечатать в порт 🖨️"
                        Height="42"
                        Margin="6,0,0,0"
                        Background="#FFD600"
                        Foreground="Black"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnPrintToPort_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
