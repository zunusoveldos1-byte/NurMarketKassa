<Window x:Class="NurMarketKassa.Views.Dialogs.OrderDiscountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Скидка"
        Width="520"
        Height="Auto"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border CornerRadius="12"
            Background="{DynamicResource BrushWindowAlt}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="44"
                  Background="{DynamicResource BrushInputAlt}"
                  MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTitleText"
                           Grid.Column="0"
                           Text="Скидка"
                           Style="{StaticResource DialogTitleText}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button Grid.Column="1"
                        Width="36"
                        Height="36"
                        Margin="0,0,6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="closeBd" Background="{TemplateBinding Background}" CornerRadius="18">
                                <TextBlock Text="✕" FontSize="16" Foreground="#DC2626"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="closeBd" Property="Background" Value="#FEE2E2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="18">
                <TextBlock x:Name="ItemTitleLabel" Text="" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource BrushText}" Margin="0,0,0,12" Visibility="Collapsed"/>

                <TextBlock Text="Выберите тип скидки, область применения и введите значение."
                           Style="{StaticResource DialogLabelText}"/>

                <StackPanel x:Name="ScopePanel" Margin="0,14,0,6">
                    <TextBlock Text="Применить к" Style="{StaticResource DialogLabelText}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton x:Name="RbCheck" Content="Весь чек" GroupName="Scope" IsChecked="True"
                                     Style="{StaticResource TouchRadioButton}"/>
                        <RadioButton x:Name="RbItem" Content="Выбранному товару" GroupName="Scope"
                                     Style="{StaticResource TouchRadioButton}" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Тип скидки" Margin="0,0,0,6" Style="{StaticResource DialogLabelText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="RbPercent" Content="Процент" GroupName="DiscountType" IsChecked="True"
                                 Style="{StaticResource TouchRadioButton}" Checked="DiscountType_Changed"/>
                    <RadioButton x:Name="RbSum" Content="Сумма" GroupName="DiscountType"
                                 Style="{StaticResource TouchRadioButton}" Checked="DiscountType_Changed"/>
                </StackPanel>

                <TextBlock x:Name="ValueLabel" Text="Введите процент скидки" Style="{StaticResource DialogLabelText}"/>
                <TextBox x:Name="ValueBox" Style="{StaticResource TouchTextBox}" Margin="0,4,0,12"/>
                <TextBlock x:Name="ErrorText" Style="{StaticResource DialogErrorText}" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сбросить" Style="{StaticResource TouchGhostButton}" Margin="0,0,10,0" Click="Clear_Click"/>
                    <Button Content="Отмена" IsCancel="True" Style="{StaticResource TouchGhostButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                    <Button Content="Применить" IsDefault="True" Style="{StaticResource TouchPrimaryButton}" Click="Apply_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
