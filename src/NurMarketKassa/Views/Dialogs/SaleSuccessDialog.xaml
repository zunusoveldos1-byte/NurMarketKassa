<dialogs:PosDialogWindowBase x:Class="NurMarketKassa.Views.Dialogs.SaleSuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:NurMarketKassa.Views.Dialogs"
        Title="Продажа успешно завершена"
        DialogCardMinWidth="560"
        DialogCardMaxWidth="560">
    <Grid x:Name="RootGrid" Opacity="0">
        <Border Background="#66000000" />
        <Border x:Name="DialogCard" Style="{StaticResource PosDialogCardBorder}">
            <StackPanel>
                <TextBlock Text="Продажа успешно завершена" Style="{StaticResource PosDialogTitleText}" />
                <TextBlock Text="Напечатать чек?" Style="{StaticResource PosDialogMessageText}" Margin="0,0,0,8" />
                <TextBlock x:Name="AmountText" Style="{StaticResource PosDialogAmountText}" />

                <Button Content="Напечатать чек"
                        Style="{StaticResource PosDialogPrimaryButton}"
                        HorizontalAlignment="Stretch"
                        IsDefault="True"
                        Click="PrintButton_Click" />
                <Button Content="Предпросмотр"
                        Style="{StaticResource PosDialogSecondaryButton}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        Click="PreviewButton_Click" />
                <Button Content="Закрыть"
                        Style="{StaticResource PosDialogSecondaryButton}"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Stretch"
                        IsCancel="True"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</dialogs:PosDialogWindowBase>
