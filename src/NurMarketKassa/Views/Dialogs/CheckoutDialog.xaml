<Window x:Class="NurMarketKassa.Views.Dialogs.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оплата"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Width="1100" Height="700">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CheckoutHoverButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding Tag}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentMethodButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="16,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscountToggle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="seg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="seg" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="seg" Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickCashButton" TargetType="Button" BasedOn="{StaticResource CheckoutHoverButton}">
            <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Tag" Value="10"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
        </Style>

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Трек -->
                            <Border x:Name="track" Width="52" Height="28" CornerRadius="14"
                            Background="{DynamicResource BrushInputAlt}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1" Margin="0,0,10,0"/>
                            <!-- Ползунок -->
                            <Ellipse x:Name="dot" Width="24" Height="24" Fill="White"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="dot" Property="Margin" Value="26,0,2,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Opacity="1">
        <Border Background="#66000000"/>

        <Border x:Name="DialogCard"
                Width="1100" Height="700"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#FFFFFF"
                CornerRadius="16"
                Padding="28">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.22" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Оплата покупки" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushText}"/>
                        <TextBlock Text="Завершите продажу и выберите удобный способ оплаты."
                                   FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource CheckoutHoverButton}"
                            Background="Transparent" BorderThickness="0"
                            Width="36" Height="36" Padding="0"
                            Click="Cancel_Click" ToolTip="Закрыть">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="14"
                                   Foreground="{DynamicResource BrushTextSoft}"/>
                    </Button>
                </Grid>

                <!-- Body -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left column -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ИТОГ К ОПЛАТЕ" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <TextBlock Text="{Binding BigTotalDisplay}" FontSize="54" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccentStrong}"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text=" сом" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,10"/>
                        </StackPanel>

                        <TextBlock Text="СКИДКА" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <RadioButton Content="В процентах (%)"
                                         GroupName="DiscountMode"
                                         IsChecked="{Binding IsDiscountPercent}"
                                         Style="{StaticResource DiscountToggle}"
                                         Margin="0,0,6,0"/>
                            <RadioButton Content="Суммой (сом)"
                                         GroupName="DiscountMode"
                                         IsChecked="{Binding IsDiscountSum}"
                                         Style="{StaticResource DiscountToggle}"
                                         Margin="6,0,0,0"/>
                        </UniformGrid>
                        <Border Background="{DynamicResource BrushInput}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="12"
                                Padding="14,10" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DiscountInput, UpdateSourceTrigger=PropertyChanged}"
                                         BorderThickness="0" Background="Transparent"
                                         FontSize="18" FontWeight="SemiBold"
                                         VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding DiscountInputSuffix}"
                                           FontSize="14" Foreground="{DynamicResource BrushTextSoft}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource BrushInputAlt}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="14"
                                Padding="18,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Итог" FontSize="14" Foreground="{DynamicResource BrushTextSoft}"/>
                                    <TextBlock Text="{Binding SubtotalDisplay}" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Скидка" FontSize="14" Foreground="{DynamicResource BrushTextSoft}"/>
                                    <TextBlock Text="{Binding DiscountSummaryDisplay}" FontSize="14" FontWeight="SemiBold"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource BrushUiStatusWarn}"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource BrushBorder}" Margin="0,4,0,10"/>
                                <Grid>
                                    <TextBlock Text="К оплате" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding PayableDisplay}" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right column -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="СПОСОБ ОПЛАТЫ" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,10"/>
                        <UniformGrid Columns="2" Margin="0,0,0,20">
                            <RadioButton GroupName="Pay" IsChecked="{Binding IsCash}"
                                         Style="{StaticResource PaymentMethodButton}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE715;" FontSize="18"
                                                Margin="0,2,8,0"/>
                                    <TextBlock Text="Наличные" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Pay" IsChecked="{Binding IsTransfer}"
                                         Style="{StaticResource PaymentMethodButton}" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C7;" FontSize="18"
                                                Margin="0,2,8,0"/>
                                    <TextBlock Text="Безналичные" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <!-- Cash -->
                        <StackPanel Visibility="{Binding IsCashMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="ПОЛУЧЕНО НАЛИЧНЫМИ" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,8"/>
                            <Border Background="White"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding CashReceived, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0" Background="Transparent"
                                             FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Grid.Column="1" Text="сом" FontSize="14"
                                               Foreground="{DynamicResource BrushTextSoft}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="✕"
                                            Style="{StaticResource CheckoutHoverButton}"
                                            Background="Transparent" BorderThickness="0"
                                            Command="{Binding ClearCashCommand}"
                                            FontSize="14" Padding="4"/>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="5" Margin="0,0,0,18">
                                <Button Content="100" Style="{StaticResource QuickCashButton}" Margin="0,0,6,0"
                                        Command="{Binding AddCash100Command}"/>
                                <Button Content="200" Style="{StaticResource QuickCashButton}" Margin="0,0,6,0"
                                        Command="{Binding AddCash200Command}"/>
                                <Button Content="500" Style="{StaticResource QuickCashButton}" Margin="0,0,6,0"
                                        Command="{Binding AddCash500Command}"/>
                                <Button Content="1000" Style="{StaticResource QuickCashButton}" Margin="0,0,6,0"
                                        Command="{Binding AddCash1000Command}"/>
                                <Button Content="Без сдачи" Style="{StaticResource QuickCashButton}"
                                        Command="{Binding ExactCashCommand}"/>
                            </UniformGrid>

                            <Border Background="#F0FAF3"
                                    BorderBrush="#B7DFC3"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="18,16"
                                    Visibility="{Binding ShowChangeBlock, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="СДАЧА" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1E8E3E"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                                            <TextBlock Text="{Binding ChangeAmountDisplay}" FontSize="36" FontWeight="Bold"
                                                       Foreground="#1E8E3E"
                                                       Typography.NumeralAlignment="Tabular"/>
                                            <TextBlock Text=" сом" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="#1E8E3E"
                                                       VerticalAlignment="Bottom" Margin="8,0,0,6"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ChangeStatusIsOk, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✓" Foreground="#1E8E3E" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ChangeStatusText}" Foreground="#1E8E3E"
                                                       FontSize="13"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding ChangeStatusIsWarn, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="⚠" Foreground="#C5221F" FontWeight="Bold" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding ChangeStatusText}" Foreground="#C5221F"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE825;"
                                               FontSize="42" Foreground="#1E8E3E" Opacity="0.35"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Transfer -->
                        <StackPanel Visibility="{Binding IsBankSelectionVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Выберите банк для оплаты"
                                       FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,8"/>
                            <ListBox ItemsSource="{Binding Banks}"
                                     SelectedItem="{Binding SelectedBank}"
                                     BorderThickness="0" Background="Transparent"
                                     Margin="0,0,0,12">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushInputAlt}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="10"
                                                Padding="14,10" Margin="0,0,8,8" Cursor="Hand">
                                            <TextBlock Text="{Binding BankName}" FontSize="14" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Background="{DynamicResource BrushInputAlt}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="16" HorizontalAlignment="Center"
                                    Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVis}}">
                                <Image Source="{Binding QrCodePath, TargetNullValue={x:Null}}"
                                       Width="220" Height="220" Stretch="Uniform"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="0"
                          IsChecked="{Binding IsPrintReceiptEnabled}"
                          FontSize="15"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource BrushText}"
                          Margin="0,0,0,14"
                          Cursor="Hand"
                          Style="{StaticResource ToggleSwitch}">
                        <CheckBox.Content>
                            <TextBlock Text="Напечатать чек" VerticalAlignment="Center"/>
                        </CheckBox.Content>
                    </CheckBox>

                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C5221F" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>

                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Left"
                                    Style="{StaticResource CheckoutHoverButton}"
                                    Background="White"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    Tag="12"
                                    Padding="20,14"
                                    MinWidth="180"
                                    Command="{Binding CancelCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="✕" Margin="0,0,8,0"/>
                                    <TextBlock Text="Отмена"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Right"
                                Background="{DynamicResource BrushAccent}"
                                BorderBrush="{DynamicResource BrushAccentStrong}"
                                BorderThickness="1"
                                Tag="12"
                                Padding="24,16"
                                MinWidth="320"
                                IsDefault="True"
                                FontSize="17" FontWeight="Bold"
                                Foreground="White"
                                Command="{Binding PayCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="14"
                                            Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                            </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C7;"
                                      FontSize="18" Margin="0,5,10,0"/>
                                    <TextBlock Text="{Binding PayButtonText}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
