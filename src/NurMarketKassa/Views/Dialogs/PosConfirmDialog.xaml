<dialogs:PosDialogWindowBase x:Class="NurMarketKassa.Views.Dialogs.PosConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:NurMarketKassa.Views.Dialogs">
    <Grid x:Name="RootGrid" Opacity="0">
        <Border Background="#66000000" />
        <Border x:Name="DialogCard" Style="{StaticResource PosDialogCardBorder}">
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PosDialogTitleText}" />
                <TextBlock x:Name="MessageText" Style="{StaticResource PosDialogMessageText}" />
                <Grid Style="{StaticResource PosDialogTwoButtonRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            x:Name="CancelButton"
                            Style="{StaticResource PosDialogSecondaryButton}"
                            IsCancel="True"
                            Click="CancelButton_Click" />
                    <Button Grid.Column="2"
                            x:Name="ConfirmButton"
                            Style="{StaticResource PosDialogPrimaryButton}"
                            IsDefault="True"
                            Click="ConfirmButton_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</dialogs:PosDialogWindowBase>
