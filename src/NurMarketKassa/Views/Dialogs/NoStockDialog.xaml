<Window x:Class="NurMarketKassa.Views.Dialogs.NoStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товара нет в наличии"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Background="#99000000"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="NoStockRoundedButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Width" Value="380"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="White"
                CornerRadius="16"
                Padding="30,25,30,25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Color="Black" Opacity="0.2" ShadowDepth="0"/>
            </Border.Effect>

            <StackPanel HorizontalAlignment="Center">
                <Grid Width="70" Height="70" Margin="0,0,0,15">
                    <Ellipse Fill="#FEE2E2"/>
                    <Viewbox Width="36" Height="36">
                        <Canvas Width="24" Height="24">
                            <!-- Верхняя грань (крышка) -->
                            <Path Stroke="#EF4444"
          StrokeThickness="1.6"
          StrokeLineJoin="Round"
          Fill="Transparent"
          Data="M4,8 L12,4 L20,8 L12,12 Z"/>

                            <!-- Левая боковая грань -->
                            <Path Stroke="#EF4444"
          StrokeThickness="1.6"
          StrokeLineJoin="Round"
          Fill="Transparent"
          Data="M4,8 L12,12 L12,20 L4,16 Z"/>

                            <!-- Правая боковая грань -->
                            <Path Stroke="#EF4444"
          StrokeThickness="1.6"
          StrokeLineJoin="Round"
          Fill="Transparent"
          Data="M12,12 L20,8 L20,16 L12,20 Z"/>
                        </Canvas>
                    </Viewbox>
                    <Viewbox Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="White"
                                  StrokeThickness="2.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M8,8 L16,16 M16,8 L8,16"/>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <TextBlock x:Name="TitleText"
                           Text="Товар закончился на складе"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock x:Name="ProductNameText"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="MessageText"
                           Text="Последняя единица уже продана&#x0a;или зарезервирована в другом чеке."
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontSize="14"
                           Foreground="#6B7280"
                           LineHeight="20"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <TextBlock x:Name="AvailableText"
                           Text="Доступный остаток: 0"
                           TextAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#C5221F"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <Button x:Name="BtnGoToSite"
                        Style="{StaticResource NoStockRoundedButton}"
                        Background="#FFD600"
                        Foreground="Black"
                        FontWeight="SemiBold"
                        Margin="0,0,0,10"
                        Click="BtnGoToSite_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Перейти на сайт" VerticalAlignment="Center"/>
                        <TextBlock Text=" ↗" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnCancel"
                        Content="ОК"
                        Style="{StaticResource NoStockRoundedButton}"
                        Background="#F3F4F6"
                        Foreground="#374151"
                        FontWeight="Medium"
                        Click="BtnCancel_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
