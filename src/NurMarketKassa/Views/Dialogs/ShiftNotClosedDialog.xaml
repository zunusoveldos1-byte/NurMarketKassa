<dialogs:PosDialogWindowBase x:Class="NurMarketKassa.Views.Dialogs.ShiftNotClosedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:NurMarketKassa.Views.Dialogs"
        Title="Смена не закрыта">
    <Grid x:Name="RootGrid" Opacity="0">
        <Border Background="#66000000" />
        <Border x:Name="DialogCard" Style="{StaticResource PosDialogCardBorder}">
            <StackPanel>
                <TextBlock Text="Смена не закрыта" Style="{StaticResource PosDialogTitleText}" />
                <TextBlock Text="У вас осталась открытая смена.&#x0a;Закрыть её перед выходом?"
                           Style="{StaticResource PosDialogMessageText}" />
                <Grid Style="{StaticResource PosDialogTwoButtonRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Отмена"
                            Style="{StaticResource PosDialogSecondaryButton}"
                            IsCancel="True"
                            Click="CancelButton_Click" />
                    <Button Grid.Column="2"
                            Content="Закрыть"
                            Style="{StaticResource PosDialogPrimaryButton}"
                            IsDefault="True"
                            Click="CloseShiftButton_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</dialogs:PosDialogWindowBase>
