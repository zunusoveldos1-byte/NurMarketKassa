<Window x:Class="NurMarketKassa.Views.Dialogs.ReturnLineReasonDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Причина возврата"
	Height="400"
	Width="480"
	MinHeight="340"
	MinWidth="400"
	WindowStartupLocation="CenterOwner"
	ResizeMode="CanResizeWithGrip"
	Style="{StaticResource AppWindow}"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <Border
		Style="{StaticResource ElevatedCardBorder}"
		Margin="18"
		CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="*" />
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
				Grid.Row="0"
				Text="Укажите причину возврата"
				Style="{StaticResource DialogTitleText}" />
            <TextBlock
				x:Name="HintText"
				Grid.Row="1"
				Margin="0,8,0,0"
				TextWrapping="Wrap"
				Style="{StaticResource DialogLabelText}" />
            <TextBox
				x:Name="ReasonBox"
				Grid.Row="2"
				Margin="0,12,0,0"
				Height="100"
				TextWrapping="Wrap"
				AcceptsReturn="True"
				VerticalScrollBarVisibility="Auto"
				VerticalContentAlignment="Top"
				HorizontalContentAlignment="Left"
				Style="{StaticResource TouchTextBox}" />
            <TextBlock
				x:Name="ErrorText"
				Grid.Row="4"
				Margin="0,8,0,0"
				Style="{StaticResource DialogErrorText}" />
            <StackPanel
				Grid.Row="5"
				Orientation="Horizontal"
				HorizontalAlignment="Right"
				Margin="0,14,0,0">
                <Button
					Content="Отмена"
					IsCancel="True"
					Style="{StaticResource TouchGhostButton}"
					Margin="0,0,10,0"
					MinWidth="100"
					MinHeight="40"
					Click="Cancel_Click" />
                <Button
					Content="Вернуть"
					IsDefault="True"
					Style="{StaticResource TouchPrimaryButton}"
					MinWidth="140"
					MinHeight="44"
					Click="Ok_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
