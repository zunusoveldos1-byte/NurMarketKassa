<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PosDialogTitleColor">#0F172A</Color>
    <Color x:Key="PosDialogSubtitleColor">#64748B</Color>
    <Color x:Key="PosDialogAccentYellow">#F4D30B</Color>
    <Color x:Key="PosDialogAccentYellowBorder">#D4B80A</Color>
    <Color x:Key="PosDialogDangerRed">#C5221F</Color>
    <Color x:Key="PosDialogSecondaryBorder">#CBD5E1</Color>
    <Color x:Key="PosDialogLinkBlue">#2563EB</Color>

    <SolidColorBrush x:Key="PosDialogTitleBrush" Color="{StaticResource PosDialogTitleColor}" />
    <SolidColorBrush x:Key="PosDialogSubtitleBrush" Color="{StaticResource PosDialogSubtitleColor}" />
    <SolidColorBrush x:Key="PosDialogLinkBrush" Color="{StaticResource PosDialogLinkBlue}" />
    <SolidColorBrush x:Key="PosDialogAccentYellowBrush" Color="{StaticResource PosDialogAccentYellow}" />
    <SolidColorBrush x:Key="PosDialogAccentYellowBorderBrush" Color="{StaticResource PosDialogAccentYellowBorder}" />
    <SolidColorBrush x:Key="PosDialogDangerRedBrush" Color="{StaticResource PosDialogDangerRed}" />
    <SolidColorBrush x:Key="PosDialogSecondaryBorderBrush" Color="{StaticResource PosDialogSecondaryBorder}" />

    <Style x:Key="PosDialogWindow" TargetType="Window">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PosDialogCardBorder" TargetType="Border">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="White" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="MinWidth" Value="520" />
        <Setter Property="MaxWidth" Value="580" />
        <Setter Property="Padding" Value="28,24,28,24" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.22" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosDialogTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PosDialogTitleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PosDialogMessageText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{StaticResource PosDialogSubtitleBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="PosDialogAmountText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PosDialogTitleBrush}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="PosDialogRoundedButtonBase" TargetType="Button">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PosDialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource PosDialogRoundedButtonBase}">
        <Setter Property="Background" Value="{StaticResource PosDialogAccentYellowBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosDialogAccentYellowBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosDialogTitleBrush}" />
    </Style>

    <Style x:Key="PosDialogSecondaryButton" TargetType="Button" BasedOn="{StaticResource PosDialogRoundedButtonBase}">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource PosDialogSecondaryBorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PosDialogTitleBrush}" />
    </Style>

    <Style x:Key="PosDialogDangerButton" TargetType="Button" BasedOn="{StaticResource PosDialogRoundedButtonBase}">
        <Setter Property="Background" Value="{StaticResource PosDialogDangerRedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PosDialogDangerRedBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="PosDialogLinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource PosDialogLinkBrush}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="PosDialogTwoButtonRow" TargetType="Grid">
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

</ResourceDictionary>
