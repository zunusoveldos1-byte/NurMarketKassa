<Window x:Class="NurMarketKassa.Views.OpenShiftDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Открыть смену"
        Height="280" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Grid Margin="18">
        <Border Style="{StaticResource ElevatedCardBorder}" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="Открыть смену"
                           Style="{StaticResource DialogTitleText}"/>
                <TextBlock Text="Введите стартовую сумму наличных в кассе."
                           Margin="0,8,0,0"
                           Style="{StaticResource DialogLabelText}"/>
                <TextBlock Text="Сумма на открытие"
                           Margin="0,18,0,4"
                           Style="{StaticResource DialogLabelText}"/>
                <TextBox x:Name="OpeningCashBox"
                         Text="0.00"
                         Style="{StaticResource TouchTextBox}"
                         Margin="0,0,0,22"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            IsCancel="True"
                            Style="{StaticResource TouchGhostButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="Открыть"
                            IsDefault="True"
                            Style="{StaticResource TouchPrimaryButton}"
                            Click="Ok_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
