<UserControl x:Class="NurMarketKassa.Views.ShiftSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NurMarketKassa.ViewModels"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ShiftHistoryResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Общий план" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
            <TextBlock Text="Сводка операций и итоги за выбранный период"
                       FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Период с" Style="{StaticResource ShiftFieldLabel}"/>
                <DatePicker SelectedDate="{Binding FilterDateFrom, Mode=TwoWay}" MinHeight="42"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Период по" Style="{StaticResource ShiftFieldLabel}"/>
                <DatePicker SelectedDate="{Binding FilterDateTo, Mode=TwoWay}" MinHeight="42"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Кассир" Style="{StaticResource ShiftFieldLabel}"/>
                <ComboBox ItemsSource="{Binding CashierFilterOptions}"
                          SelectedItem="{Binding FilterCashier, Mode=TwoWay}"
                          Style="{DynamicResource TouchComboBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                <TextBlock Text="Тип операции" Style="{StaticResource ShiftFieldLabel}"/>
                <ComboBox ItemsSource="{Binding OperationTypeFilterOptions}"
                          SelectedItem="{Binding FilterOperationType, Mode=TwoWay}"
                          Style="{DynamicResource TouchComboBox}"/>
            </StackPanel>
            <Button Grid.Column="4" Content="Экспорт" VerticalAlignment="Bottom"
                    Style="{StaticResource ShiftFlatButton}" Padding="20,0"
                    Command="{Binding ExportSummaryCommand}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ShiftSettingsCard}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Итоги за период" FontWeight="SemiBold" FontSize="15"
                               Foreground="{DynamicResource BrushText}" Margin="0,0,0,12"/>
                    <Grid Grid.Row="1" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Баланс на начало" Style="{StaticResource ShiftFieldLabel}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OpeningBalanceText}" FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1" Text="+ Внесено" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DepositedTotalText}"
                                   Foreground="#059669" FontWeight="SemiBold" Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="2" Text="- Изъято" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WithdrawnTotalText}"
                                   Foreground="#B91C1C" FontWeight="SemiBold" Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="3" Text="Ожидаемый баланс" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedBalanceText}" FontWeight="SemiBold" Margin="0,8,0,0"/>

                        <TextBlock Grid.Row="4" Text="Фактический баланс" Margin="0,12,0,4"
                                   Foreground="{DynamicResource BrushTextSoft}" FontSize="13"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ActualBalanceText}"
                                   FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>

                        <Border Grid.Row="5" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,10"
                                CornerRadius="8" Background="{DynamicResource BrushAccentSoft}">
                            <Grid>
                                <TextBlock Text="Разница" VerticalAlignment="Center"
                                           Foreground="{DynamicResource BrushTextSoft}" FontSize="12"/>
                                <TextBlock Text="{Binding DifferenceText}" HorizontalAlignment="Right"
                                           FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource BrushAccentStrong}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ShiftSettingsCard}" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Операции" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" Margin="16,14,16,0"/>

                    <DataGrid Grid.Row="1" Style="{StaticResource ShiftModernDataGrid}"
                              ItemsSource="{Binding PagedFilteredOperations}" Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="*"/>
                            <DataGridTextColumn Header="Тип операции" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Кассир" Binding="{Binding Cashier}" Width="*"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding AmountDisplay}" Width="*"/>
                            <DataGridTextColumn Header="Комментарий" Binding="{Binding Note}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFilteredOperations}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                   Foreground="{DynamicResource BrushTextSoft}" HorizontalAlignment="Center" Opacity="0.4"/>
                        <TextBlock Text="Нет операций за выбранный период"
                                   Foreground="{DynamicResource BrushTextSoft}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Padding="0,12,0,4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0"
                Visibility="{Binding ShowSummaryPager, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="&#xE72B;" Style="{StaticResource ShiftPagerNavButton}"
                        Command="{Binding SummaryPreviousPageCommand}" ToolTip="Назад"/>
                <ItemsControl ItemsSource="{Binding SummaryPagerEntries}" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PagerEntry}">
                            <Button Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ShiftPagerButton}">
                                        <Setter Property="Content" Value="{Binding Display}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PagerEntryKind.Ellipsis}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Command>
                                    <Binding Path="DataContext.GoToSummaryPageCommand" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </Button.Command>
                                <Button.CommandParameter>
                                    <Binding Path="PageNumber"/>
                                </Button.CommandParameter>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="&#xE72A;" Style="{StaticResource ShiftPagerNavButton}"
                        Command="{Binding SummaryNextPageCommand}" ToolTip="Вперёд"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
