<Window x:Class="NurMarketKassa.Views.WeighedProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Взвесить товар"
        Width="650"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource AppWindow}"
        xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <Grid Margin="18">
        <Border Style="{StaticResource ElevatedCardBorder}" CornerRadius="12">
            <StackPanel>
                <TextBlock x:Name="TitleBlock"
                           Style="{StaticResource DialogTitleText}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PriceBlock"
                           Margin="0,8,0,0"
                           Style="{StaticResource DialogLabelText}" />

                <Border x:Name="ScalePanel"
                        Style="{StaticResource ModernInfoPanel}"
                        Margin="0,14,0,0"
                        Background="{StaticResource BrushWindowAlt}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="На весах сейчас" Style="{StaticResource DialogLabelText}" />
                        <TextBlock x:Name="LiveScaleText" Margin="0,6,0,0" Style="{StaticResource MetricValueText}" Text="—" />
                    </StackPanel>
                </Border>

                <Separator Margin="0,16,0,12" Background="{DynamicResource BrushBorder}" Height="1"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Левая колонка -->
                    <StackPanel Grid.Column="0" Margin="0,0,24,0" VerticalAlignment="Top">
                        <TextBlock Text="Вес, кг"
                                   Style="{StaticResource DialogLabelText}" Margin="0,0,0,6" />
                        <TextBox x:Name="WeightBox"
                                 Style="{StaticResource TouchTextBox}"
                                 FontSize="24" FontWeight="Bold"
                                 GotFocus="WeightBox_GotFocus"
                                 KeyDown="WeightBox_KeyDown"
                                 PreviewTextInput="WeightBox_PreviewTextInput" />

                        <TextBlock x:Name="ManualHintText"
                                   Text="Весы отключены – укажите вес вручную"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   FontSize="12"
                                   Margin="2,6,0,0"
                                   Visibility="Collapsed" />

                        <Button x:Name="FromScaleButton"
                                Content="Подставить с весов"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Style="{StaticResource TouchSecondaryButton}"
                                Visibility="Collapsed"
                                Click="FromScale_Click" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,40,0,0">
                            <Button Content="Отмена"
                                    Style="{StaticResource TouchGhostButton}"
                                    Margin="0,0,12,0"
                                    Click="Cancel_Click" />
                            <Button x:Name="OkButton"
                                    Content="В чек"
                                    Style="{StaticResource TouchPrimaryButton}"
                                    Width="110"
                                    Click="Ok_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Правая колонка: быстрые кнопки и нумпад -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <WrapPanel Margin="0,0,0,10" HorizontalAlignment="Center">
                            <Button Content="0,1 кг" Width="73" Height="38"
                                    Style="{StaticResource TouchSecondaryButton}" FontSize="12"
                                    Click="QuickWeight_Click" Tag="0.1" RenderTransformOrigin="0.5,0.5" >
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="0.066"/>
                                        <TranslateTransform Y="-0.134"/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>
                            <Button Content="0,5 кг" Width="61" Height="38"
                                    Style="{StaticResource TouchSecondaryButton}" FontSize="12"
                                    Click="QuickWeight_Click" Tag="0.5" />
                            <Button Content="1 кг" Width="54" Height="38" Margin="2"
                                    Style="{StaticResource TouchSecondaryButton}" FontSize="12"
                                    Click="QuickWeight_Click" Tag="1" />
                            <Button Content="2 кг" Width="54" Height="38" Margin="2"
                                    Style="{StaticResource TouchSecondaryButton}" FontSize="12"
                                    Click="QuickWeight_Click" Tag="2" />
                            <Button Content="5 кг" Width="57" Height="38"
                                    Style="{StaticResource TouchSecondaryButton}" FontSize="12"
                                    Click="QuickWeight_Click" Tag="5" RenderTransformOrigin="0.5,0.5" >
                                <Button.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="0.066"/>
                                        <TranslateTransform Y="0.143"/>
                                    </TransformGroup>
                                </Button.RenderTransform>
                            </Button>
                        </WrapPanel>

                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="1" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="1" />
                                <Button Content="2" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="2" />
                                <Button Content="3" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="3" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button Content="4" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="4" />
                                <Button Content="5" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="5" />
                                <Button Content="6" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="6" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button Content="7" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="7" />
                                <Button Content="8" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="8" />
                                <Button Content="9" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="9" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Button Content="," Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="," />
                                <Button Content="0" Width="64" Height="46" Margin="2" Style="{StaticResource TouchSecondaryButton}" Click="Numpad_Click" Tag="0" />
                                <Button Content="⌫" Width="64" Height="46" Margin="2" Style="{StaticResource TouchDangerButton}" Click="NumpadBackspace_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>