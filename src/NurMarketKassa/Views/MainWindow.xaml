<Window x:Class="NurMarketKassa.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:pos="clr-namespace:NurMarketKassa.Models.Pos;assembly=NurMarketKassa.Infrastructure"
	xmlns:local="clr-namespace:NurMarketKassa.Converters"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
	xmlns:conv="clr-namespace:NurMarketKassa.Converters"
	xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
	Title="Касса — Nur Market"
	Icon="pack://application:,,,/Assets/app-logo.png"
	Height="840"
	Width="1280"
	MinHeight="600"
	MinWidth="900"
	WindowStartupLocation="CenterScreen"
	WindowState="Maximized"
	Style="{StaticResource AppWindow}"
	Loaded="Window_Loaded"
	Closing="Window_Closing"
	Closed="Window_Closed"
	PreviewKeyDown="MainWindow_PreviewKeyDown">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:LessThanConverter x:Key="LessThanConverter" />
            <conv:StringTruncationConverter x:Key="StringTruncationConverter" />
            <conv:PriceAmountConverter x:Key="PriceAmountConverter" />
            <conv:HexToBrushConverter x:Key="HexToBrushConverter" />

            <system:Double x:Key="CatalogTileWidth"
                xmlns:system="clr-namespace:System;assembly=System.Runtime">175</system:Double>
            <system:Double x:Key="CatalogTileMinHeight"
                xmlns:system="clr-namespace:System;assembly=System.Runtime">145</system:Double>
            <Size x:Key="CatalogTileSize">175,145</Size>

            <Style x:Key="CatalogHeadersOnlyTabControl" TargetType="TabControl" BasedOn="{StaticResource PosCatalogTabControl}">
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel LastChildFill="False">
                                <Border DockPanel.Dock="Bottom"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="0,0,0,1"
                                        Margin="0,0,0,0"/>
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1"/>
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernCatalogTabItem" TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="4,10,18,10"/>
                <Setter Property="Margin" Value="0,0,4,0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabRoot" Background="Transparent" Padding="{TemplateBinding Padding}" Cursor="Hand">
                                <StackPanel>
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/>
                                    <Border x:Name="Underline"
                                            Height="3"
                                            CornerRadius="2"
                                            Margin="0,8,0,0"
                                            Background="Transparent"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Underline" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ReceiptTabButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,7"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ReceiptTabButtonActive" TargetType="Button" BasedOn="{StaticResource ReceiptTabButton}">
                <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
            </Style>

            <Style x:Key="FlatCartActionButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
                <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="CartActionTileButton" TargetType="Button" BasedOn="{StaticResource FlatCartActionButton}">
                <Setter Property="MinHeight" Value="72"/>
                <Setter Property="Padding" Value="8,10"/>
            </Style>

            <Style x:Key="ShiftOpenOutlineButton" TargetType="Button">
                <Setter Property="Height" Value="40"/>
                <Setter Property="MinWidth" Value="132"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="Background" Value="{DynamicResource BrushWindowAlt}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AddProductButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="CatalogProductsListView" TargetType="ListView">
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="ClipToBounds" Value="True"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            </Style>

            <Style x:Key="CatalogListViewItem" TargetType="ListViewItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Width" Value="175"/>
                <Setter Property="Height" Value="145"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="CatalogProductTileTemplate">
                <Border Width="175"
                        Height="145"
                        Background="{DynamicResource BrushCatalogTileBg}"
                        BorderBrush="{DynamicResource BrushCatalogTileBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10,12,0"
                        ClipToBounds="True"
                        Cursor="Hand"
                        MouseLeftButtonDown="CatalogProduct_MouseDoubleClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushText}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"
                                   MaxHeight="34"
                                   LineHeight="16"
                                   Margin="0,0,26,0"/>
                        <Button Grid.Row="0"
                                Width="22" Height="22"
                                Padding="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="ToggleFavorite_Click"
                                ToolTip="Избранное">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="Transparent"/>
                                        <Setter Property="Stroke" Value="{DynamicResource BrushCatalogFavoriteStroke}"/>
                                        <Setter Property="StrokeThickness" Value="1.3"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource BrushCatalogPrice}"/>
                                                <Setter Property="Stroke" Value="{DynamicResource BrushCatalogPrice}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}}"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushCatalogPrice}"
                                       VerticalAlignment="Bottom"/>
                            <TextBlock Text="сом"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushCatalogMeta}"
                                       Margin="4,0,0,2"
                                       VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,2">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{Binding StockForeground, Converter={StaticResource HexToBrushConverter}}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7B8;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeighted}" Value="True">
                                                <Setter Property="Text" Value="&#xEF3F;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding StockInfo, Mode=OneWay}"
                                       FontSize="14"
                                       Foreground="{Binding StockForeground, Converter={StaticResource HexToBrushConverter}}"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnitInvalid}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource BrushUiStatusWarn}"/>
                                                <Setter Property="ToolTip"
                                                        Value="Внимание: Данные товара заполнены неправильно в базе данных! Пожалуйста, передайте администратору."/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="ToolTip" Value="Остаток близок к лимиту (меньше 10)"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Row="3"
                                   Text="{Binding Barcode, StringFormat=ШК: {0}, TargetNullValue=ШК: —}"
                                   FontSize="10"
                                   Foreground="{DynamicResource BrushCatalogMeta}"
                                   TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Border Grid.Row="1"
                                Margin="-12,0,-12,0"
                                CornerRadius="0,0,12,12"
                                Height="18"
                                VerticalAlignment="Bottom"
                                Background="{Binding TypeBadgeBackground, Converter={StaticResource HexToBrushConverter}}"
                                ToolTip="{Binding TypeBadgeText}">
                            <TextBlock Text="{Binding TypeBadgeText}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
            <system:Double x:Key="CatalogTitleFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">11</system:Double>
            <system:Double x:Key="CatalogPriceFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">13</system:Double>
            <system:Double x:Key="CatalogTitleMaxH"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">36</system:Double>
            <system:Double x:Key="CartUiTitleFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">10.5</system:Double>
            <system:Double x:Key="CartUiLineTotalFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">10.5</system:Double>
            <system:Double x:Key="CartUiSubFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">8</system:Double>
            <system:Double x:Key="CartUiSmallBtnFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">8</system:Double>
            <system:Double x:Key="CartUiSmallBtnMinH"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">22</system:Double>
            <system:Double x:Key="CartUiQtyBtnSize"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">32</system:Double>
            <system:Double x:Key="CartUiQtyBtnFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">12</system:Double>
            <system:Double x:Key="CartUiSumColMinW"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">76</system:Double>
            <Thickness
				x:Key="CartUiQtyBtnSpacing">14,0,0,0</Thickness>
            <BooleanToVisibilityConverter
				x:Key="BoolToVis" />

            <Style TargetType="ListViewItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                                <!-- Явное выравнивание – убирает ошибку FindAncestor -->
                                <ContentPresenter HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style
				x:Key="HamburgerMenuItem"
				TargetType="{x:Type Button}">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Padding"
					Value="12,0" />
                <Setter
					Property="FontSize"
					Value="13" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								Background="{TemplateBinding Control.Background}">
                                <ContentPresenter
									HorizontalAlignment="Left"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										Value="{DynamicResource BrushInputAlt}"
										Property="Background" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Стили для Открыть смену и закрыть смену -->
            <Style x:Key="ShiftButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="40"/>
                <!-- вернули высоту -->
                <Setter Property="MinWidth" Value="120"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#1F2937"/>
                <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                        CornerRadius="8" Padding="14,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Hover – небольшая прозрачность -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <!-- Когда кнопка неактивна (IsEnabled=false) → тусклый серый цвет -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                    <Setter TargetName="bg" Property="Background" Value="#E5E7EB"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
				x:Key="PrimaryActionButton"
				TargetType="{x:Type Button}">
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushAccent}" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushTextInverted}" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								x:Name="btn"
								Background="{TemplateBinding Control.Background}"
								CornerRadius="8">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="15,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="btn"
										Property="UIElement.Opacity"
										Value="0.9" />
                                </Trigger>
                                <Trigger
									Property="IsEnabled"
									Value="False">
                                    <Setter
										TargetName="btn"
										Property="UIElement.Opacity"
										Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="SecondaryActionButton"
				TargetType="{x:Type Button}">
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushPanelSoft}" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								x:Name="border"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="{TemplateBinding Control.BorderThickness}"
								CornerRadius="8">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="12,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="border"
										Value="{DynamicResource BrushInputAlt}"
										Property="Border.Background" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            

            <Style
				x:Key="KpiCard"
				TargetType="{x:Type Border}">
                <Setter
					Property="Background"
					Value="{DynamicResource BrushInputAlt}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Border.CornerRadius"
					Value="10" />
                <Setter
					Property="Border.Padding"
					Value="16" />
                <Setter
					Property="Margin"
					Value="4" />
                <Setter
					Property="UIElement.Effect"
					Value="{DynamicResource CardShadow}" />
            </Style>
            <SolidColorBrush
				x:Key="HamburgerOverlayBrush"
				Color="#80000000" />
            <Style
				x:Key="CartQtyMiniButton"
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource TouchSecondaryButton}">
                <Setter
					Property="Width"
					Value="32" />
                <Setter
					Property="Height"
					Value="32" />
                <Setter
					Property="MinHeight"
					Value="32" />
                <Setter
					Property="Padding"
					Value="0" />
                <Setter
					Property="FontSize"
					Value="12" />
                <Setter
					Property="FontWeight"
					Value="Bold" />
            </Style>
            <!--Неизвестный ID соединения: 2-->
            <Style
				x:Key="{x:Type ScrollViewer}"
				TargetType="{x:Type ScrollViewer}">
                <Setter
					Property="ScrollViewer.PanningMode"
					Value="Both" />
                <Setter
					Property="CanContentScroll"
					Value="False" />
                <Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
                <Setter
					Property="VerticalScrollBarVisibility"
					Value="Auto" />
            </Style>
            <Style
				x:Key="ModernGrid"
				TargetType="{x:Type DataGrid}">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="DataGrid.AlternatingRowBackground"
					Value="#00FFFFFF" />
                <Setter
					Property="ItemsControl.AlternationCount"
					Value="2" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="DataGrid.RowHeight"
					Value="40" />
                <Setter
					Property="DataGrid.GridLinesVisibility"
					Value="Vertical" />
                <Setter
					Property="DataGrid.HorizontalGridLinesBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="DataGrid.VerticalGridLinesBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Margin"
					Value="0,0,12,0" />
                <Setter
					Property="ScrollViewer.PanningMode"
					Value="Both" />
                <Setter
					Property="DataGrid.ColumnHeaderStyle">
                    <Setter.Value>
                        <Style
							TargetType="{x:Type DataGridColumnHeader}">
                            <Setter
								Property="Foreground"
								Value="{DynamicResource BrushText}" />
                            <Setter
								Property="Background"
								Value="#00FFFFFF" />
                            <Setter
								Property="Padding"
								Value="10,5" />
                            <Setter
								Property="FontWeight"
								Value="SemiBold" />
                            <Setter
								Property="BorderThickness"
								Value="0,0,0,1" />
                            <Setter
								Property="BorderBrush"
								Value="{DynamicResource BrushBorderStrong}" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="{x:Type DataGridRow}" TargetType="{x:Type DataGridRow}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridRow}">
                            <Border x:Name="RowBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                                <SelectiveScrollingGrid>
                                    <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                SnapsToDevicePixels="True"/>
                                </SelectiveScrollingGrid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Выделенная строка (таблица в фокусе) -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding IsSelectionActive, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                    </MultiDataTrigger>
                    <!-- Выделенная строка (таблица НЕ в фокусе) -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                            <Condition Binding="{Binding IsSelectionActive, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
                        <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                    </MultiDataTrigger>
                    <!-- Ховер (наведение) -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CatalogGridRow" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource {x:Type DataGridRow}}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F7FA"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CatalogGridStyle" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource ModernGrid}">
                <Setter Property="Background" Value="#FFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowStyle" Value="{StaticResource CatalogGridRow}"/>
                <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#F0F0F0"/>
                <Setter Property="DataGrid.VerticalGridLinesBrush" Value="Transparent"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="CanUserSortColumns" Value="True"/>
                <Setter Property="DataGrid.RowHeight" Value="48"/>
                <Setter Property="DataGrid.ColumnHeaderStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8F9FA"/>
                            <Setter Property="Foreground" Value="#4A4A4A"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#F0F0F0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
				x:Key="CenterAlignedCell"
				TargetType="{x:Type DataGridCell}">
                <Setter
					Property="VerticalAlignment"
					Value="Center" />
                <Setter
					Property="HorizontalAlignment"
					Value="Center" />
            </Style>

            <Style x:Key="CatalogGridPlainCell" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#4A4A4A"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="CatalogGridCenterCell" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#4A4A4A"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style
				x:Key="{x:Type DataGridCell}"
				TargetType="{x:Type DataGridCell}">
                <Setter
					Property="VerticalAlignment"
					Value="Center" />
                <Setter
					Property="Padding"
					Value="6,4" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="FontSize"
					Value="14" />
                <Setter
					Property="FrameworkElement.FocusVisualStyle"
					Value="{x:Null}" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type DataGridCell}">
                            <Border
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="0">
                                <ContentPresenter
									HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="DataGridCell.IsSelected"
									Value="True">
                                    <Setter
										Property="Background"
										Value="#00FFFFFF" />
                                </Trigger>
                                <Trigger
									Property="UIElement.IsFocused"
									Value="True">
                                    <Setter
										Property="Background"
										Value="#00FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="ViewToggleButton"
				TargetType="{x:Type RadioButton}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Padding"
					Value="10,5" />
                <Setter
					Property="Margin"
					Value="4,0" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type RadioButton}">
                            <Border
								x:Name="toggleBorder"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.Background" />
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.BorderBrush" />
                                    <Setter
										Property="Foreground"
										Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="WarehouseViewToggleButton"
				TargetType="{x:Type RadioButton}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Padding"
					Value="10,5" />
                <Setter
					Property="Margin"
					Value="4,0" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type RadioButton}">
                            <Border
								x:Name="toggleBorder"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.Background" />
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.BorderBrush" />
                                    <Setter
										Property="Foreground"
										Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Background="{DynamicResource BrushWindowAlt}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HamburgerButton"
                            Style="{StaticResource TouchGhostButton}"
                            Width="38" Height="38" Padding="0" Margin="0,0,10,0"
                            ToolTip="Меню" Click="HamburgerMenu_Click">
                        <TextBlock Text="☰" FontSize="18"
                                   Foreground="{DynamicResource BrushText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Border Width="34" Height="34" CornerRadius="17"
                            Margin="0,0,10,0" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Assets/app-logo.png"
                               Stretch="Uniform" Width="34" Height="34"/>
                    </Border>
                    <TextBlock x:Name="UserTitleText"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                        <Ellipse x:Name="OfflineStatusDot" Width="8" Height="8" Fill="{DynamicResource BrushUiStatusOk}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="OfflineStatusLabel" Text="Онлайн"
                                   FontSize="12" Foreground="{DynamicResource BrushTextSoft}"/>
                    </StackPanel>
                    <TextBlock x:Name="NetworkModeText"
                               FontSize="12" Foreground="{DynamicResource BrushTextSoft}"
                               VerticalAlignment="Center" Margin="0,0,18,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ShiftBalanceText"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource BrushAccent}"
                               VerticalAlignment="Center"
                               Text="Касса: 0.00 сом"/>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE701;"
                               FontSize="14" Foreground="{DynamicResource BrushTextSoft}"
                               VerticalAlignment="Center"
                               ToolTip="Статус связи с сервером"/>
                    <TextBlock x:Name="ProfileStatusText" Visibility="Collapsed"/>
                    <Button x:Name="OfflineStatusButton" Visibility="Collapsed" Click="OfflineStatus_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Style="{StaticResource HeaderButton}"
                            Width="38" Padding="0" Margin="0,0,8,0"
                            ToolTip="Переключить тему" Click="ThemeToggle_Click">
                        <TextBlock x:Name="ThemeToggleGlyph"
                                   FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource BrushText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="KeyboardToggleButton"
                            Style="{StaticResource HeaderButton}"
                            Width="38" Padding="0" Margin="0,0,8,0"
                            ToolTip="Показать / скрыть экранную клавиатуру" Click="ToggleKeyboard_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE92F;"
                                   FontSize="15" Foreground="{DynamicResource BrushText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="OpenShiftButton"
                            Style="{StaticResource ShiftOpenOutlineButton}"
                            Margin="0,0,8,0" Click="OpenShift_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE785;"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Открыть смену" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseShiftButton"
                            Style="{StaticResource TouchPrimaryButton}"
                            Padding="14,8" MinHeight="40" Click="CloseShift_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72E;"
                                       FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Закрыть смену" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="350"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="CatalogAreaBorder"
                    Grid.Column="0"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource BrushWindowAlt}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="0,0,1,0"
                    Padding="16,14"
                    SizeChanged="CatalogArea_SizeChanged">
                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="0"/>
                    </Grid.RowDefinitions>
                    <TabControl Grid.Row="0"
                                x:Name="CatalogTabs"
                                Style="{StaticResource CatalogHeadersOnlyTabControl}"
                                ItemContainerStyle="{StaticResource ModernCatalogTabItem}"
                                SelectionChanged="CatalogTabs_SelectionChanged">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;"
                                               FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Все товары" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;"
                                               FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Весовые" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;"
                                               FontSize="15" VerticalAlignment="Center"/>
                                    <TextBlock Text="Штучные" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </TabItem.Header>
                        </TabItem>
                    </TabControl>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BrushInput}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;"
                                           FontSize="15" Foreground="{DynamicResource BrushTextSoft}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="CatalogSearchBox"
                                         Grid.Column="1"
                                         BorderThickness="0"
                                         VerticalAlignment="Center"
                                         FontSize="14"
                                         Foreground="{DynamicResource BrushText}"
                                         Background="Transparent"
                                         TextChanged="CatalogSearchBox_TextChanged"
                                         KeyDown="CatalogSearchBox_KeyDown"/>
                                <TextBlock Grid.Column="1"
                                           Text="Поиск товара..."
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           FontSize="14"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=CatalogSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button x:Name="ClearSearchButton"
                                        Grid.Column="2"
                                        Content="✕"
                                        Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource BrushTextSoft}"
                                        Visibility="Collapsed"
                                        Click="ClearSearch_Click"/>
                            </Grid>
                        </Border>
                        <Button x:Name="FilterButton"
                                Grid.Column="1"
                                Style="{StaticResource TouchSecondaryButton}"
                                Width="40" Height="40" Padding="0" Margin="8,0,0,0"
                                ToolTip="Фильтр товаров"
                                Click="FilterButton_Click">
                            <Viewbox Width="18" Height="18">
                                <Path Data="M3,6 L21,6 M6,12 L18,12 M10,18 L14,18"
                                      Stroke="{DynamicResource BrushText}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="AddProductButton"
                                Grid.Column="2"
                                Style="{StaticResource AddProductButton}"
                                Margin="8,0,0,0"
                                ToolTip="Открыть склад"
                                Click="MenuWarehouse_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+" FontSize="18" FontWeight="Bold" Margin="0,0,6,0"/>
                                <TextBlock Text="Товар" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0" Visibility="Collapsed">
                            <RadioButton x:Name="BtnGrid" Content="Карточка" IsChecked="True"
                                         GroupName="CatalogView" Style="{StaticResource ViewToggleButton}"
                                         Checked="CatalogView_Changed"/>
                            <RadioButton x:Name="BtnTable" Content="Список"
                                         GroupName="CatalogView" Style="{StaticResource ViewToggleButton}"
                                         Checked="CatalogView_Changed"/>
                        </StackPanel>
                        <Button x:Name="RefreshCatalogButton"
                                Grid.Column="4"
                                Style="{StaticResource TouchGhostButton}"
                                Width="36" Height="36" Padding="0" Margin="8,0,0,0"
                                ToolTip="Обновить каталог"
                                Click="RefreshCatalog_Click">
                            <TextBlock x:Name="RefreshCatalogIcon"
                                       FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="15"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="RefreshCatalogIconRotate" Angle="0"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock x:Name="SystemStatusText"
                                   FontSize="11"
                                   Foreground="{DynamicResource BrushTextSoft}"
                                   TextWrapping="Wrap"
                                   Text="Загрузка состояния…" />
                    </StackPanel>
                    <Grid Grid.Row="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MinHeight="0">
                        <Grid Visibility="{Binding IsChecked, ElementName=BtnGrid, Converter='{StaticResource BoolToVis}'}"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              MinHeight="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="0"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CatalogCountText"
                                       Grid.Row="0"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       Foreground="{DynamicResource BrushTextSoft}"
                                       Margin="0,0,8,4"
                                       Visibility="Collapsed"/>
                            <ListView x:Name="CatalogItemsAll"
                                      Grid.Row="1"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource CatalogProductsListView}"
                                      ItemContainerStyle="{StaticResource CatalogListViewItem}"
                                      ItemTemplate="{StaticResource CatalogProductTileTemplate}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                                   IsGridLayoutEnabled="False"
                                                                   SpacingMode="Uniform"
                                                                   ItemSize="{DynamicResource CatalogTileSize}"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                            <ListView x:Name="CatalogItemsKg"
                                      Grid.Row="1"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource CatalogProductsListView}"
                                      ItemContainerStyle="{StaticResource CatalogListViewItem}"
                                      ItemTemplate="{StaticResource CatalogProductTileTemplate}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                                   IsGridLayoutEnabled="False"
                                                                   SpacingMode="Uniform"
                                                                   ItemSize="{DynamicResource CatalogTileSize}"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                            <ListView x:Name="CatalogItemsPiece"
                                      Grid.Row="1"
                                      Visibility="Collapsed"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource CatalogProductsListView}"
                                      ItemContainerStyle="{StaticResource CatalogListViewItem}"
                                      ItemTemplate="{StaticResource CatalogProductTileTemplate}"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                                   IsGridLayoutEnabled="False"
                                                                   SpacingMode="Uniform"
                                                                   ItemSize="{DynamicResource CatalogTileSize}"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                            <Button x:Name="CatalogMoreButton"
                                    Grid.Row="2"
                                    Content="Показать еще"
                                    Style="{StaticResource TouchSecondaryButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,4"
                                    Padding="24,8"
                                    Visibility="Collapsed"
                                    Click="CatalogMore_Click"/>
                        </Grid>
                        <DataGrid x:Name="CatalogGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Style="{StaticResource CatalogGridStyle}"
          EnableRowVirtualization="True"
          EnableColumnVirtualization="True"
          VirtualizingPanel.IsVirtualizing="True"
          VirtualizingPanel.VirtualizationMode="Recycling"
          VirtualizingPanel.ScrollUnit="Pixel"
          ScrollViewer.CanContentScroll="True"
          ScrollViewer.PanningMode="Both"
          VerticalAlignment="Stretch"
          HorizontalAlignment="Stretch"
          MinHeight="0"
          ClipToBounds="True"
          Visibility="{Binding IsChecked, ElementName=BtnTable, Converter='{StaticResource BoolToVis}'}"
          ItemsSource="{Binding CatalogTableSource}"
          MouseDoubleClick="CatalogGrid_MouseDoubleClick"
          Loaded="CatalogGrid_Loaded"
          SizeChanged="CatalogGrid_SizeChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Название" MinWidth="160" SortMemberPath="Title">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="28" Height="28"
                                                        CornerRadius="14"
                                                        Background="#F0F0F0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13"
                                                               Foreground="#9AA0A6"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="&#xE7B8;"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MustWeigh}" Value="True">
                                                                        <Setter Property="Text" Value="&#xE9D9;"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding Title}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="#1A1A1A"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Цена" MinWidth="90" SortMemberPath="PriceLine">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PriceLine, Converter={StaticResource PriceAmountConverter}}"
                                                           FontWeight="Bold"
                                                           Foreground="#1A1A1A"/>
                                                <TextBlock Text="сом"
                                                           FontSize="11"
                                                           Foreground="#888888"
                                                           Margin="4,0,0,1"
                                                           VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Остаток" MinWidth="90" SortMemberPath="Quantity">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12"
                                                    Padding="8,2"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E6F4EA"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                <Setter Property="Background" Value="#FCE8E6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding StockInfo, Mode=OneWay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#137333"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Quantity}" Value="0">
                                                                    <Setter Property="Foreground" Value="#C5221F"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsUnitInvalid}" Value="True">
                                                                    <Setter Property="Foreground" Value="#C75000"/>
                                                                    <Setter Property="ToolTip"
                                                                            Value="Внимание: Данные товара заполнены неправильно в базе данных! Пожалуйста, передайте администратору."/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Штрихкод" MinWidth="110" SortMemberPath="Barcode"
                                                    Binding="{Binding Barcode}"
                                                    ElementStyle="{StaticResource CatalogGridPlainCell}"/>
                                <DataGridTextColumn Header="Ед." MinWidth="50" SortMemberPath="Unit"
                                                    Binding="{Binding Unit, FallbackValue=шт}"
                                                    ElementStyle="{StaticResource CatalogGridCenterCell}"/>
                                <DataGridTemplateColumn Header="★" MinWidth="44" SortMemberPath="IsFavorite">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Width="24" Height="24" Padding="0"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Center"
                                                    Click="ToggleFavorite_Click">
                                                <Path Width="14" Height="14" Stretch="Uniform"
                                                      Data="M12,17.27 L18.18,21 L16.54,13.97 L22,9.24 L14.81,8.62 L12,2 L9.19,8.62 L2,9.24 L7.45,13.97 L5.82,21 L12,17.27 Z">
                                                    <Path.Style>
                                                        <Style TargetType="Path">
                                                            <Setter Property="Fill" Value="Transparent"/>
                                                            <Setter Property="Stroke" Value="#B0B0B0"/>
                                                            <Setter Property="StrokeThickness" Value="1.3"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                    <Setter Property="Fill" Value="#FFCC00"/>
                                                                    <Setter Property="Stroke" Value="#E6B800"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Path.Style>
                                                </Path>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border x:Name="CatalogUpdateOverlay"
                            Grid.Row="0" Grid.RowSpan="4"
                            Panel.ZIndex="20"
                            Background="#99000000"
                            Visibility="Collapsed">
                        <Border Style="{StaticResource ElevatedCardBorder}"
                                Background="{DynamicResource BrushWindowAlt}"
                                BorderBrush="{DynamicResource BrushAccent}"
                                MaxWidth="420"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Padding="24,20"
                                Margin="16">
                            <StackPanel>
                                <TextBlock Text="Обнаружены изменения каталога"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Добавлены новые товары или изменены существующие позиции."
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           Margin="0,0,0,18"/>
                                <Button x:Name="CatalogUpdateNowButton"
                                        Content="Обновить сейчас"
                                        Style="{StaticResource TouchPrimaryButton}"
                                        MinHeight="44" Margin="0,0,0,8"
                                        Click="CatalogUpdateNow_Click"/>
                                <Button x:Name="CatalogUpdateLaterButton"
                                        Content="Позже"
                                        Style="{StaticResource TouchGhostButton}"
                                        MinHeight="40"
                                        Click="CatalogUpdateLater_Click"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
            <GridSplitter
				x:Name="CatalogGridSplitter"
				Grid.Column="1"
				Width="12"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Background="{StaticResource BrushBorderStrong}"
				BorderBrush="{StaticResource BrushBorderStrong}"
				BorderThickness="0"
				ShowsPreview="True"
				ResizeBehavior="PreviousAndNext"
				ResizeDirection="Columns"
				Cursor="SizeWE"
				ToolTip="Изменить ширину панелей">
                <Control.Template>
                    <ControlTemplate
						TargetType="{x:Type GridSplitter}">
                        <Border
							Background="{TemplateBinding Control.Background}"
							BorderBrush="{TemplateBinding Control.BorderBrush}"
							BorderThickness="{TemplateBinding Control.BorderThickness}">
                            <Grid
								HorizontalAlignment="Center"
								VerticalAlignment="Center">
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Control.Template>
            </GridSplitter>
            <Border
				x:Name="SearchOverlayPanel"
				Grid.Column="0"
				Panel.ZIndex="10"
				Margin="0,60,4,0"
				Background="{StaticResource BrushOverlay}"
				CornerRadius="8"
				Padding="10"
				Visibility="Collapsed">
                <Border
					Style="{StaticResource ElevatedCardBorder}"
					Background="{StaticResource BrushWindowAlt}"
					BorderBrush="{StaticResource BrushAccent}">
                    <DockPanel
						LastChildFill="True">
                        <TextBlock
							x:Name="SearchOverlayTitle"
							DockPanel.Dock="Top"
							Margin="0,0,0,8"
							FontWeight="SemiBold"
							FontSize="13"
							Foreground="{StaticResource BrushText}" />
                        <DockPanel
							LastChildFill="True">
                            <ListView x:Name="CatalogSearchItems"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource CatalogProductsListView}"
                                      ScrollViewer.CanContentScroll="True"
                                      Background="Transparent"
                                      ItemContainerStyle="{StaticResource CatalogListViewItem}"
                                      ItemTemplate="{StaticResource CatalogProductTileTemplate}"
                                      MouseLeftButtonUp="CatalogSearchItem_Click">
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel Orientation="Horizontal"
                                                                   IsGridLayoutEnabled="True"
                                                                   SpacingMode="Uniform"
                                                                   ItemSize="{DynamicResource CatalogTileSize}"/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Border>
            <Border x:Name="RightPanelBorder"
                    Grid.Column="2"
                    Background="{DynamicResource BrushWindowAlt}"
                    Padding="16,12">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="CartStateText"
                               DockPanel.Dock="Top"
                               Visibility="Collapsed"
                               FontSize="10"
                               TextWrapping="Wrap"/>
                    <ScrollViewer DockPanel.Dock="Top"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,12">
                        <StackPanel x:Name="ReceiptTabsHost"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <Button x:Name="StartSaleButton" Visibility="Collapsed" Click="StartSale_Click"/>
                    <TextBlock x:Name="CartItemsCountText" Visibility="Collapsed"/>
                    <TextBlock x:Name="DeferredCountText" Visibility="Collapsed"/>
                    <Button x:Name="RefreshCartButton" Visibility="Collapsed" Click="RefreshCart_Click"/>
                    <Border DockPanel.Dock="Bottom"
                            Background="Transparent"
                            Padding="0"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel x:Name="ToolsPanel"
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        Visibility="Visible">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource BrushInput}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Margin="0,0,8,0"
                                            Padding="12,0">
                                        <Grid>
                                            <!-- Добавленные свойства: VerticalContentAlignment и Padding -->
                                            <TextBox x:Name="BarcodeBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 MinHeight="42"
                                                 FontSize="13"
                                                 VerticalAlignment="Center" 
                                                 VerticalContentAlignment="Center" 
                                                 Padding="0" 
                                                 KeyDown="BarcodeBox_KeyDown"/>

                                            <TextBlock Text="Введите код товара или название..."
                                                   IsHitTestVisible="False"
                                                   Foreground="{StaticResource BrushTextSoft}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=BarcodeBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource BrushInputAlt}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="−" Style="{StaticResource TouchGhostButton}"
                                                    Width="34" Height="42" Padding="0"
                                                    Click="ManualAddQtyMinus_Click"/>
                                            <TextBox x:Name="ManualAddQtyBox"
                                                     Text="1"
                                                     Width="36"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     TextAlignment="Center"
                                                     VerticalAlignment="Center"
                                                     FontWeight="Bold"/>
                                            <Button Content="+" Style="{StaticResource TouchGhostButton}"
                                                    Width="34" Height="42" Padding="0"
                                                    Click="ManualAddQtyPlus_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="ScanBarcodeButton"
                                            Grid.Column="2"
                                            Content="Добавить"
                                            Style="{StaticResource TouchPrimaryButton}"
                                            Padding="18,10"
                                            MinHeight="42"
                                            MinWidth="110"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Click="ScanBarcode_Click"/>
                                </Grid>
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Button x:Name="DeferCartButton"
                                            Style="{StaticResource FlatCartActionButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Сохранить корзину и открыть новую продажу"
                                            Click="DeferCart_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;"
                                                       FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Отложить чек" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteReceiptButton"
                                            Style="{StaticResource FlatCartActionButton}"
                                            Margin="0,0,6,0"
                                            ToolTip="Очистить текущий чек"
                                            Click="DeleteReceipt_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;"
                                                       FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Удалить чек" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="MoreCartActionsButton"
                                            Style="{StaticResource FlatCartActionButton}"
                                            ToolTip="Дополнительные действия"
                                            Click="ToggleToolsPanel_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⋯" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ещё" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                                <StackPanel x:Name="MoreCartActionsPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                        <Button x:Name="RestoreLatestDeferredButton"
                                                Style="{StaticResource FlatCartActionButton}"
                                                Margin="0,0,6,0"
                                                ToolTip="Вернуться к предыдущему чеку"
                                                Click="ReturnToPreviousReceipt_Click">
                                            <TextBlock Text="Вернуть" HorizontalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="OpenDeferredCartsButton"
                                                Style="{StaticResource FlatCartActionButton}"
                                                Margin="0,0,6,0"
                                                Click="OpenDeferredCarts_Click">
                                            <TextBlock Text="Список отлож." HorizontalAlignment="Center"/>
                                        </Button>
                                        <Button Style="{StaticResource FlatCartActionButton}"
                                                Click="ApplyOrderDiscount_Click">
                                            <TextBlock Text="Скидка %" HorizontalAlignment="Center"/>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                                <TextBlock x:Name="OrderDiscountSummaryText" Visibility="Collapsed" Text="Скидка не задана."/>
                                <Button x:Name="OrderDiscountButton" Visibility="Collapsed"
                                        Click="ClearOrderDiscountFromHeader_Click"/>
                                <Button x:Name="ToggleToolsButton" Visibility="Collapsed" Click="ToggleToolsPanel_Click"/>
                                <TextBlock x:Name="IconText" Visibility="Collapsed"/>
                                <TextBlock x:Name="CartMessageText"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           Margin="0,0,0,8"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock Text="Промежуточный итог"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSoft}"
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="CartSubtotalText"
                                           Visibility="Collapsed"
                                           Text="Промежуточный итог: 0.00 сом"/>
                                <TextBlock x:Name="CartDiscountText" FontSize="12"
                                           Foreground="{StaticResource BrushUiStatusWarn}"
                                           Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock x:Name="CartTotalAmountText"
                                               FontSize="40" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccentStrong}"
                                               Text="0.00"
                                               Typography.NumeralAlignment="Tabular"/>
                                    <TextBlock Text=" сом" FontSize="20" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="CheckoutFooterButton"
                                Grid.Row="2"
                                IsEnabled="False"
                                Padding="14,16"
                                MinHeight="76"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                Click="Checkout_Click"> 
                                <!-- Переопределяем шаблон только для этой кнопки -->
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="btn"
                                            Background="{DynamicResource BrushSuccess}"
                                            BorderBrush="{DynamicResource BrushSuccess}"
                                            CornerRadius="14"
                                            Padding="14,16">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btn" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="btn" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C7;"
                                FontSize="18" Margin="0,5,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Оплатить" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid VerticalAlignment="Stretch">
                        <Border Background="Transparent" MinHeight="80">
                            <ListView
						x:Name="CartListView"
						Margin="6"
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Stretch"
						BorderThickness="0"
						Background="Transparent"
						Foreground="{StaticResource BrushText}"
						ScrollViewer.HorizontalScrollBarVisibility="Disabled"
						ScrollViewer.CanContentScroll="True"
						ScrollViewer.PanningMode="Both"
						VirtualizingPanel.IsVirtualizing="True"
						VirtualizingPanel.VirtualizationMode="Recycling"
						ItemsSource="{Binding CartLines}"
						SizeChanged="CartListView_SizeChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type pos:CartLineRow}">
                                <Border Background="{StaticResource BrushWindowAlt}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0.5" CornerRadius="8" Padding="8,6" HorizontalAlignment="Stretch">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" MinWidth="{DynamicResource CartUiSumColMinW}" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Информация о товаре -->
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           Text="&#xE7BA;"
                                                           FontSize="14"
                                                           Foreground="#C5221F"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,6,0"
                                                           ToolTip="Товара недостаточно на складе"
                                                           Visibility="{Binding HasStockWarning, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock FontSize="14" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{StaticResource BrushText}" 
                                                           HorizontalAlignment="Left" 
                                                           TextTrimming="CharacterEllipsis" 
                                                           TextWrapping="NoWrap" 
                                                           MaxWidth="180" 
                                                           Text="{Binding Title, Mode=OneWay}" 
                                                           ToolTip="{Binding Title}" />
                                            </StackPanel>
                                            <TextBlock FontSize="13" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource BrushTextSoft}" 
                                                       HorizontalAlignment="Left" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       TextWrapping="NoWrap" 
                                                       MaxWidth="200"
                                                       Margin="0,2,0,0" 
                                                       Text="{Binding SubLine}" />
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#C5221F"
                                                       HorizontalAlignment="Left"
                                                       Margin="0,2,0,0"
                                                       Text="{Binding StockAvailableText}"
                                                       ToolTip="{Binding StockWarningText}"
                                                       Visibility="{Binding HasStockWarning, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- 2. Итоговая цена + Скидка -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding LineTotal}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushAccent}" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                                                <Button Style="{StaticResource TouchGhostButton}"
                                                    Width="26" Height="26" Padding="0" MinWidth="0" MinHeight="0"
                                                    FontSize="11" FontWeight="Bold"
                                                    ToolTip="Скидка на товар"
                                                    Click="CartLineDiscount_Click" VerticalAlignment="Center">
                                                    <TextBlock Text="%" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Button>
                                                <TextBlock Text="{Binding DiscountDisplay}" FontSize="11"
                                                    Foreground="{DynamicResource BrushDanger}"
                                                    FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"
                                                    Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 3. Кнопки управления -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Button Content="Взвесить" Style="{StaticResource TouchSecondaryButton}" FontSize="{DynamicResource CartUiSmallBtnFont}" Padding="6,2" MinWidth="0" MinHeight="{DynamicResource CartUiSmallBtnMinH}" Margin="{DynamicResource CartUiQtyBtnSpacing}" ToolTip="Указать вес" Visibility="{Binding WeighedLine, Converter='{StaticResource BoolToVis}'}" Click="CartWeigh_Click" />
                                            <Button Content="−" Style="{StaticResource CartQtyMiniButton}" Width="{DynamicResource CartUiQtyBtnSize}" Height="{DynamicResource CartUiQtyBtnSize}" MinHeight="{DynamicResource CartUiQtyBtnSize}" Margin="{DynamicResource CartUiQtyBtnSpacing}" FontSize="{DynamicResource CartUiQtyBtnFont}" ToolTip="Уменьшить" Click="CartQtyMinus_Click" />
                                            <Button Content="+" Style="{StaticResource CartQtyMiniButton}" Width="{DynamicResource CartUiQtyBtnSize}" Height="{DynamicResource CartUiQtyBtnSize}" MinHeight="{DynamicResource CartUiQtyBtnSize}" Margin="{DynamicResource CartUiQtyBtnSpacing}" FontSize="{DynamicResource CartUiQtyBtnFont}" ToolTip="Увеличить" Click="CartQtyPlus_Click" />
                                            <Button Style="{StaticResource TouchDangerButton}" Width="40" Height="40" Padding="0" ToolTip="Убрать из чека" Click="CartLineDelete_Click">
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                            </ListView>
                        </Border>
                        <Border
							x:Name="CartEmptyPanel"
							Background="Transparent"
							CornerRadius="10"
							IsHitTestVisible="False"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,8">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BF;"
                                           FontSize="36"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Корзина пуста"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushText}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Выберите товар слева&#x0a;или отсканируйте штрихкод"
                                           FontSize="12"
                                           Foreground="{DynamicResource BrushTextSoft}"
                                           HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
            <Border
