<Window x:Class="NurMarketKassa.Views.MainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:pos="clr-namespace:NurMarketKassa.Models.Pos"
	xmlns:local="clr-namespace:NurMarketKassa.Converters"
	xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:conv="clr-namespace:NurMarketKassa.Converters"
	Title="Касса — Nur Market"
	Icon="pack://application:,,,/Assets/app-logo.png"
	Height="840"
	Width="1280"
	MinHeight="600"
	MinWidth="900"
	Style="{StaticResource AppWindow}"
	Loaded="Window_Loaded"
	Closing="Window_Closing"
	PreviewKeyDown="MainWindow_PreviewKeyDown">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:LessThanConverter x:Key="LessThanConverter" />
            
            <system:Double x:Key="CatalogTitleFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">11</system:Double>
            <system:Double x:Key="CatalogPriceFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">10</system:Double>
            <system:Double x:Key="CatalogTitleMaxH"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">36</system:Double>
            <system:Double x:Key="CartUiTitleFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">10.5</system:Double>
            <system:Double x:Key="CartUiLineTotalFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">10.5</system:Double>
            <system:Double x:Key="CartUiSubFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">8</system:Double>
            <system:Double x:Key="CartUiSmallBtnFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">8</system:Double>
            <system:Double x:Key="CartUiSmallBtnMinH"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">22</system:Double>
            <system:Double x:Key="CartUiQtyBtnSize"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">32</system:Double>
            <system:Double x:Key="CartUiQtyBtnFont"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">12</system:Double>
            <system:Double x:Key="CartUiSumColMinW"
               xmlns:system="clr-namespace:System;assembly=System.Runtime">76</system:Double>
            <Thickness
				x:Key="CartUiQtyBtnSpacing">14,0,0,0</Thickness>
            <BooleanToVisibilityConverter
				x:Key="BoolToVis" />
            <Style
				x:Key="{x:Type ListViewItem}"
				TargetType="{x:Type ListViewItem}">
                <Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
                <Setter
					Property="HorizontalContentAlignment"
					Value="Stretch" />
                <Setter
					Property="Padding"
					Value="0" />
                <Setter
					Property="Margin"
					Value="0,0,0,5" />
                <Setter
					Property="MinHeight"
					Value="0" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
            </Style>
            <Style
				x:Key="HamburgerMenuItem"
				TargetType="{x:Type Button}">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="HorizontalAlignment"
					Value="Stretch" />
                <Setter
					Property="Height"
					Value="44" />
                <Setter
					Property="Padding"
					Value="16,0" />
                <Setter
					Property="FontSize"
					Value="14" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								Background="{TemplateBinding Control.Background}">
                                <ContentPresenter
									HorizontalAlignment="Left"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										Value="{DynamicResource BrushInputAlt}"
										Property="Background" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="PrimaryActionButton"
				TargetType="{x:Type Button}">
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushAccent}" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushTextInverted}" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								x:Name="btn"
								Background="{TemplateBinding Control.Background}"
								CornerRadius="8">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="15,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="btn"
										Property="UIElement.Opacity"
										Value="0.9" />
                                </Trigger>
                                <Trigger
									Property="IsEnabled"
									Value="False">
                                    <Setter
										TargetName="btn"
										Property="UIElement.Opacity"
										Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="SecondaryActionButton"
				TargetType="{x:Type Button}">
                <Setter
					Property="Height"
					Value="36" />
                <Setter
					Property="Background"
					Value="{DynamicResource BrushPanelSoft}" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								x:Name="border"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="{TemplateBinding Control.BorderThickness}"
								CornerRadius="8">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Margin="12,0" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="border"
										Value="{DynamicResource BrushInputAlt}"
										Property="Border.Background" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="KpiCard"
				TargetType="{x:Type Border}">
                <Setter
					Property="Background"
					Value="{DynamicResource BrushInputAlt}" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorderStrong}" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Border.CornerRadius"
					Value="10" />
                <Setter
					Property="Border.Padding"
					Value="16" />
                <Setter
					Property="Margin"
					Value="4" />
                <Setter
					Property="UIElement.Effect"
					Value="{DynamicResource CardShadow}" />
            </Style>
            <SolidColorBrush
				x:Key="HamburgerOverlayBrush"
				Color="#80000000" />
            <Style
				x:Key="CartQtyMiniButton"
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource TouchSecondaryButton}">
                <Setter
					Property="Width"
					Value="32" />
                <Setter
					Property="Height"
					Value="32" />
                <Setter
					Property="MinHeight"
					Value="32" />
                <Setter
					Property="Padding"
					Value="0" />
                <Setter
					Property="FontSize"
					Value="12" />
                <Setter
					Property="FontWeight"
					Value="Bold" />
            </Style>
            <!--Неизвестный ID соединения: 2-->
            <Style
				x:Key="{x:Type ScrollViewer}"
				TargetType="{x:Type ScrollViewer}">
                <Setter
					Property="ScrollViewer.PanningMode"
					Value="Both" />
                <Setter
					Property="CanContentScroll"
					Value="False" />
                <Setter
					Property="HorizontalScrollBarVisibility"
					Value="Auto" />
                <Setter
					Property="VerticalScrollBarVisibility"
					Value="Auto" />
            </Style>
            <Style
				x:Key="ModernGrid"
				TargetType="{x:Type DataGrid}">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="DataGrid.AlternatingRowBackground"
					Value="#00FFFFFF" />
                <Setter
					Property="ItemsControl.AlternationCount"
					Value="2" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="DataGrid.RowHeight"
					Value="40" />
                <Setter
					Property="DataGrid.GridLinesVisibility"
					Value="Vertical" />
                <Setter
					Property="DataGrid.HorizontalGridLinesBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="DataGrid.VerticalGridLinesBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Margin"
					Value="0,0,12,0" />
                <Setter
					Property="ScrollViewer.PanningMode"
					Value="Both" />
                <Setter
					Property="DataGrid.ColumnHeaderStyle">
                    <Setter.Value>
                        <Style
							TargetType="{x:Type DataGridColumnHeader}">
                            <Setter
								Property="Foreground"
								Value="{DynamicResource BrushText}" />
                            <Setter
								Property="Background"
								Value="#00FFFFFF" />
                            <Setter
								Property="Padding"
								Value="10,5" />
                            <Setter
								Property="FontWeight"
								Value="SemiBold" />
                            <Setter
								Property="BorderThickness"
								Value="0,0,0,1" />
                            <Setter
								Property="BorderBrush"
								Value="{DynamicResource BrushBorderStrong}" />
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="{x:Type DataGridRow}"
				TargetType="{x:Type DataGridRow}">
                <Setter
					Property="Height"
					Value="40" />
                <Setter
					Property="VerticalContentAlignment"
					Value="Center" />
                <Setter
					Property="FrameworkElement.FocusVisualStyle"
					Value="{x:Null}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type DataGridRow}">
                            <Border
								x:Name="RowBorder"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="0">
                                <SelectiveScrollingGrid>
                                    <DataGridCellsPresenter
										ItemsPanel="{TemplateBinding DataGridRow.ItemsPanel}" />
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="DataGridRow.IsSelected"
									Value="True">
                                    <Setter
										TargetName="RowBorder"
										Value="{DynamicResource BrushInputAlt}"
										Property="Border.Background" />
                                </Trigger>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="RowBorder"
										Value="{DynamicResource BrushInputAlt}"
										Property="Border.Background" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="CenterAlignedCell"
				TargetType="{x:Type DataGridCell}">
                <Setter
					Property="VerticalAlignment"
					Value="Center" />
                <Setter
					Property="HorizontalAlignment"
					Value="Center" />
            </Style>
            <Style
				x:Key="{x:Type DataGridCell}"
				TargetType="{x:Type DataGridCell}">
                <Setter
					Property="VerticalAlignment"
					Value="Center" />
                <Setter
					Property="Padding"
					Value="6,4" />
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="FontSize"
					Value="14" />
                <Setter
					Property="FrameworkElement.FocusVisualStyle"
					Value="{x:Null}" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type DataGridCell}">
                            <Border
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="0">
                                <ContentPresenter
									HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}"
									VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="DataGridCell.IsSelected"
									Value="True">
                                    <Setter
										Property="Background"
										Value="#00FFFFFF" />
                                </Trigger>
                                <Trigger
									Property="UIElement.IsFocused"
									Value="True">
                                    <Setter
										Property="Background"
										Value="#00FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="ViewToggleButton"
				TargetType="{x:Type RadioButton}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Padding"
					Value="10,5" />
                <Setter
					Property="Margin"
					Value="4,0" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type RadioButton}">
                            <Border
								x:Name="toggleBorder"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.Background" />
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.BorderBrush" />
                                    <Setter
										Property="Foreground"
										Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				x:Key="WarehouseViewToggleButton"
				TargetType="{x:Type RadioButton}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Padding"
					Value="10,5" />
                <Setter
					Property="Margin"
					Value="4,0" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type RadioButton}">
                            <Border
								x:Name="toggleBorder"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="1"
								CornerRadius="6"
								Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.Background" />
                                    <Setter
										TargetName="toggleBorder"
										Value="{DynamicResource BrushAccent}"
										Property="Border.BorderBrush" />
                                    <Setter
										Property="Foreground"
										Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid
		Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="*" />
        </Grid.RowDefinitions>
        <Border
			Grid.Row="0"
			Style="{StaticResource ElevatedCardBorder}"
			Padding="16,13"
			CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
						Width="Auto" />
                    <ColumnDefinition
						Width="*" />
                    <ColumnDefinition
						Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
					Orientation="Horizontal"
					VerticalAlignment="Center">
                    <Button
						x:Name="HamburgerButton"
						Style="{StaticResource TouchGhostButton}"
						Width="38"
						Height="38"
						Padding="0"
						Margin="0,0,8,0"
						ToolTip="Меню"
						Click="HamburgerMenu_Click">
                        <TextBlock
							Text="☰"
							FontSize="18"
							Foreground="{DynamicResource BrushText}"
							HorizontalAlignment="Center"
							VerticalAlignment="Center" />
                    </Button>
                    <Image
						Source="pack://application:,,,/Assets/app-logo.png"
						Width="34"
						Height="34"
						Margin="0,0,10,0"
						RenderOptions.BitmapScalingMode="LowQuality" />
                    <StackPanel
						VerticalAlignment="Center">
                        <TextBlock
							x:Name="UserTitleText"
							FontSize="15"
							FontWeight="SemiBold"
							Foreground="{StaticResource BrushText}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel
					Grid.Column="1"
					HorizontalAlignment="Center"
					VerticalAlignment="Center">
                    <TextBlock
						x:Name="ProfileStatusText"
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{StaticResource BrushTextSoft}"
						TextWrapping="Wrap" />
                    <TextBlock
						x:Name="NetworkModeText"
						Margin="0,2,0,0"
						HorizontalAlignment="Center"
						FontSize="11"
						Foreground="{StaticResource BrushTextMuted}"
						TextWrapping="Wrap" />
                    <StackPanel
						Orientation="Horizontal"
						HorizontalAlignment="Center"
						Margin="0,6,0,0">
                        <Button
							x:Name="OfflineStatusButton"
							Style="{StaticResource HeaderButton}"
							Padding="10,6"
							Margin="0,0,6,0"
							ToolTip="Состояние офлайн-очереди — нажмите для подробностей"
							Click="OfflineStatus_Click">
                            <StackPanel
								Orientation="Horizontal">
                                <TextBlock
									FontFamily="Segoe MDL2 Assets"
									Text=""
									FontSize="15"
									Margin="0,0,6,0" />
                                <TextBlock
									x:Name="OfflineStatusLabel"
									Text="Онлайн" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <StackPanel
					Grid.Column="2"
					Orientation="Horizontal"
					VerticalAlignment="Center">
                    <Button
						x:Name="ThemeToggleButton"
						Style="{StaticResource HeaderButton}"
						Width="38"
						Padding="0"
						ToolTip="Переключить тему (тёмная / светлая)"
						Margin="0,0,6,0"
						Click="ThemeToggle_Click">
                        <TextBlock
							x:Name="ThemeToggleGlyph"
							FontFamily="Segoe MDL2 Assets"
							FontSize="15"
							Foreground="{DynamicResource BrushText}"
							VerticalAlignment="Center"
							HorizontalAlignment="Center" />
                    </Button>
                    <Button
						Style="{StaticResource HeaderButton}"
						Width="38"
						Padding="0"
						ToolTip="Экранная клавиатура"
						Margin="0,0,6,0"
						Click="ShowKeyboard_Click">
                        <TextBlock
							FontFamily="Segoe MDL2 Assets"
							Text=""
							FontSize="15"
							Foreground="{DynamicResource BrushText}"
							VerticalAlignment="Center"
							HorizontalAlignment="Center" />
                    </Button>
                    <Border
						x:Name="ShiftBannerBar"
						Background="{StaticResource BrushWarningSoft}"
						BorderBrush="{StaticResource BrushWarning}"
						BorderThickness="1"
						CornerRadius="6"
						Padding="4,2"
						Margin="0,0,6,0"
						VerticalAlignment="Center">
                        <StackPanel
							Orientation="Horizontal">
                            <Button
								x:Name="OpenShiftButton"
								Content="Открыть смену"
								Style="{StaticResource HeaderButton}"
								Padding="8,5"
								Margin="0,0,4,0"
								Command="{Binding ShiftViewModel.OpenShiftCommand}" />
                            <Button
								x:Name="CloseShiftButton"
								Content="Закрыть смену"
								Style="{StaticResource HeaderButton}"
								Padding="8,5"
								Command="{Binding ShiftViewModel.CloseShiftCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid
			Row="1"
			Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
					Width="2.2*"
					MinWidth="470" />
                <ColumnDefinition
					Width="8" />
                <ColumnDefinition
					Width="*"
					MinWidth="450" />
            </Grid.ColumnDefinitions>
            <Border
				x:Name="CatalogAreaBorder"
				Grid.Column="0"
				Style="{StaticResource ElevatedCardBorder}"
				Margin="0,0,6,0"
				SizeChanged="CatalogArea_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
						Row="0"
						Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
								Width="*" />
                            <ColumnDefinition
								Width="Auto" />
                            <ColumnDefinition
								Width="Auto" />
                            <ColumnDefinition
								Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
							Background="{DynamicResource BrushInput}"
							BorderBrush="{DynamicResource BrushBorderStrong}"
							BorderThickness="1"
							CornerRadius="8"
							Padding="4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
										Width="Auto" />
                                    <ColumnDefinition
										Width="*" />
                                    <ColumnDefinition
										Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
									Text="🔍"
									FontSize="16"
									VerticalAlignment="Center"
									Margin="4,0" />
                                <TextBox
									x:Name="CatalogSearchBox"
									Grid.Column="1"
									BorderThickness="0"
									VerticalAlignment="Center"
									FontSize="14"
									Foreground="{DynamicResource BrushText}"
									Background="#00FFFFFF"
									TextChanged="CatalogSearchBox_TextChanged" />
                                <Button
									x:Name="ClearSearchButton"
									Grid.Column="2"
									Content="✕"
									Width="28"
									Height="28"
									Padding="0"
									Background="#00FFFFFF"
									BorderThickness="0"
									Foreground="{DynamicResource BrushTextSoft}"
									Cursor="Hand"
									Visibility="Collapsed"
									Click="ClearSearch_Click" />
                            </Grid>
                        </Border>
                        <Button
							x:Name="FilterButton"
							Grid.Column="1"
							Style="{StaticResource TouchSecondaryButton}"
