										Content="Внести"
										Style="{StaticResource PrimaryActionButton}"
										Background="#16A34A"
										Foreground="#FFFFFFFF"
										Width="120"
										Margin="0,0,8,0"
										Click="ShiftCashInButton_Click" />
                                    <Button
										Content="Изъять"
										Style="{StaticResource PrimaryActionButton}"
										Background="#DC2626"
										Foreground="#FFFFFFFF"
										Width="120"
										Click="ShiftCashOutButton_Click" />
                                </StackPanel>
                                <StackPanel
									x:Name="ShiftCashOperationPanel"
									Visibility="Collapsed"
									Margin="0,8,0,0">
                                    <TextBlock
										x:Name="ShiftCashOperationTitle"
										FontWeight="SemiBold"
										Foreground="{DynamicResource BrushText}"
										Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
												Width="140" />
                                            <ColumnDefinition
												Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
											Text="Сумма:"
											VerticalAlignment="Center"
											Foreground="{DynamicResource BrushText}" />
                                        <TextBox
											x:Name="ShiftCashAmountBox"
											Grid.Column="1"
											Style="{DynamicResource TouchTextBox}"
											Margin="8,0,0,0" />
                                    </Grid>
                                    <Grid
										Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
												Width="140" />
                                            <ColumnDefinition
												Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
											Text="Комментарий:"
											VerticalAlignment="Center"
											Foreground="{DynamicResource BrushText}" />
                                        <TextBox
											x:Name="ShiftCashCommentBox"
											Grid.Column="1"
											Style="{DynamicResource TouchTextBox}"
											Margin="8,0,0,0" />
                                    </Grid>
                                    <StackPanel
										Orientation="Horizontal"
										HorizontalAlignment="Right"
										Margin="0,12,0,0">
                                        <Button
											Content="Применить"
											Style="{StaticResource PrimaryActionButton}"
											Width="100"
											Click="ShiftCashApplyButton_Click" />
                                        <Button
											Content="Отмена"
											Style="{StaticResource SecondaryActionButton}"
											Width="100"
											Margin="8,0,0,0"
											Click="ShiftCashCancelButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border
				x:Name="HamburgerOverlay"
				Grid.RowSpan="2"
				Grid.ColumnSpan="3"
				Background="#80000000"
				Visibility="Collapsed"
				Panel.ZIndex="999"
				MouseDown="HamburgerOverlay_MouseDown" />
            <Border
				x:Name="HamburgerPanel"
				Grid.RowSpan="2"
				Grid.ColumnSpan="3"
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Width="320"
				Margin="-320,0,0,0"
				Background="{DynamicResource BrushPanelElevated}"
				BorderBrush="{DynamicResource BrushBorder}"
				BorderThickness="0,0,1,0"
				Panel.ZIndex="1000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="*" />
                    </Grid.RowDefinitions>
                    <Border
						Grid.Row="0"
						Padding="16,14"
						Background="{DynamicResource BrushPanel}">
                        <Grid>
                            <TextBlock
								Text="Nur Market"
								FontSize="18"
								FontWeight="Bold"
								Foreground="{DynamicResource BrushText}"
								VerticalAlignment="Center" />
                            <Button
								Content="✕"
								Style="{StaticResource TouchGhostButton}"
								Width="32"
								Height="32"
								Padding="0"
								HorizontalAlignment="Right"
								FontSize="18"
								Foreground="{DynamicResource BrushText}"
								Background="#00FFFFFF"
								Click="HamburgerMenuClose_Click" />
                        </Grid>
                    </Border>
                    <StackPanel
						Grid.Row="1"
						Margin="0,8,0,0">
                        <Button
							Content="🏠  Главная"
							Style="{StaticResource HamburgerMenuItem}"
							Click="MenuMain_Click" />
                        <Button
							Content="📊  Аналитика"
							Style="{StaticResource HamburgerMenuItem}"
							Click="OpenFinanceWindow_Click" />
                        <Button
							Content="📦  Склад"
							Style="{StaticResource HamburgerMenuItem}"
							Click="MenuWarehouse_Click" />
                        <Button
							Content="🔑 Смена"
							Style="{StaticResource HamburgerMenuItem}"
							Click="MenuShift_Click" />
                        <Button
							Content="🔧  Доп услуги"
							Style="{StaticResource HamburgerMenuItem}"
							Click="MenuServices_Click" />
                        <Button
							Content="↩️  Возврат"
							Style="{StaticResource HamburgerMenuItem}"
							Click="ReturnSale_Click" />
                        <Separator
							Margin="12,8"
							Background="{DynamicResource BrushBorder}" />
                        <Button
							Content="🔄  Синхронизация"
							Style="{StaticResource HamburgerMenuItem}"
							Click="SyncNow_Click" />
                        <Button
							Content="⚙️  Настройки"
							Style="{StaticResource HamburgerMenuItem}"
							Click="Settings_Click" />
                        <Button
							Content="🚪  Выйти"
							Style="{StaticResource HamburgerMenuItem}"
							Click="Logout_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
