				x:Name="WarehousePanel"
				Visibility="Collapsed"
				Background="{DynamicResource BrushPanel}"
				CornerRadius="12"
				Padding="16"
				Margin="0"
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="*" />
                    </Grid.RowDefinitions>
                    <Border
						Grid.Row="0"
						Style="{StaticResource ModernSectionBorder}"
						Padding="12,10"
						Margin="0,0,0,8">
                        <StackPanel
							Orientation="Horizontal">
                            <TextBox
								x:Name="WarehouseSearchBox"
								Width="260"
								Style="{StaticResource TouchTextBox}"
								Margin="0,0,12,0"
								TextChanged="WarehouseSearchBox_TextChanged" />
                            <StackPanel
								Orientation="Horizontal"
								Margin="8,0,0,0">
                                <RadioButton
									x:Name="WarehouseCardsBtn"
									Content="Карточки"
									GroupName="WarehouseView"
									IsChecked="True"
									Style="{StaticResource WarehouseViewToggleButton}"
									Checked="WarehouseCardsBtn_Checked" />
                                <RadioButton
									x:Name="WarehouseTableBtn"
									Content="Таблица"
									GroupName="WarehouseView"
									Style="{StaticResource WarehouseViewToggleButton}"
									Checked="WarehouseTableBtn_Checked" />
                            </StackPanel>
                            <Button
								Content="← Назад"
								Style="{StaticResource TouchSecondaryButton}"
								Margin="12,0,0,0"
								Click="WarehouseBack_Click" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer
						Grid.Row="1"
						VerticalScrollBarVisibility="Auto"
						HorizontalScrollBarVisibility="Disabled"
						PanningMode="Both"
						CanContentScroll="False">
                        <Grid>
                            <ItemsControl
								x:Name="WarehouseCardsItems"
								Visibility="{Binding IsChecked, ElementName=WarehouseCardsBtn, Converter='{StaticResource BoolToVis}'}"
								ItemsSource="{Binding WarehouseItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid
											Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
											Background="{DynamicResource BrushInputAlt}"
											BorderBrush="{DynamicResource BrushBorder}"
											BorderThickness="0.5"
											CornerRadius="8"
											Padding="14"
											Margin="6"
											Effect="{DynamicResource CardShadow}"
                                            MouseLeftButtonDown="WarehouseCard_Click">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition
														Height="Auto" />
                                                    <RowDefinition
														Height="Auto" />
                                                    <RowDefinition
														Height="*" />
                                                    <RowDefinition
														Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel
													Grid.Row="0"
													Orientation="Horizontal"
													Margin="0,0,0,8">
                                                    <TextBlock
														Text="#"
														FontSize="14"
														FontWeight="Bold"
														Foreground="{DynamicResource BrushText}"
														VerticalAlignment="Center"
														Margin="0,0,6,0" />
                                                    <Border
														Width="36"
														Height="36"
														Background="{DynamicResource BrushInput}"
														CornerRadius="6"
														Margin="0,0,8,0">
                                                        <TextBlock
															Text="📦"
															HorizontalAlignment="Center"
															VerticalAlignment="Center"
															FontSize="18" />
                                                    </Border>
                                                    <TextBlock
														FontSize="15"
														FontWeight="SemiBold"
														Foreground="{DynamicResource BrushText}"
														VerticalAlignment="Center"
														TextTrimming="CharacterEllipsis"
														Text="{Binding ProductName}" />
                                                </StackPanel>
                                                <StackPanel
													Grid.Row="1"
													Orientation="Horizontal"
													Margin="0,4,0,8">
                                                    <TextBlock
														FontSize="11"
														Foreground="{DynamicResource BrushTextSoft}"
														Margin="0,0,10,0"
														Text="{Binding Code, StringFormat='Код: {0}'}" />
                                                    <TextBlock
														FontSize="11"
														Foreground="{DynamicResource BrushTextSoft}"
														Margin="0,0,10,0"
														Text="{Binding Article, StringFormat='Арт: {0}'}" />
                                                    <TextBlock
														FontSize="11"
														Foreground="{DynamicResource BrushTextSoft}"
														Text="{Binding Unit, StringFormat='Ед: {0}'}" />
                                                </StackPanel>
                                                <Grid
													Row="3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
															Width="*" />
                                                        <ColumnDefinition
															Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel
														Grid.Column="0">
                                                        <TextBlock
															Text="Цена продажи"
															FontSize="11"
															Foreground="{DynamicResource BrushTextSoft}" />
                                                        <TextBlock
															FontSize="18"
															FontWeight="Bold"
															Foreground="{DynamicResource BrushAccent}"
															Margin="0,2,0,0"
															Text="{Binding Price, StringFormat='{}{0:N2} сом'}" />
                                                        <TextBlock
															FontSize="12"
															Foreground="{DynamicResource BrushTextMuted}"
															Margin="0,6,0,0"
															Text="{Binding StockQuantity, StringFormat='Остаток: {0}'}" />
                                                    </StackPanel>
                                                    <StackPanel
														Grid.Column="1"
														HorizontalAlignment="Right">
                                                        <TextBlock
															Text="Скидка"
															FontSize="11"
															Foreground="{DynamicResource BrushTextSoft}"
															HorizontalAlignment="Right" />
                                                        <TextBlock
															FontSize="16"
															FontWeight="Bold"
															Foreground="{DynamicResource BrushSuccess}"
															HorizontalAlignment="Right"
															Margin="0,2,0,0"
															Text="{Binding Discount, StringFormat={}{0:P0}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <DataGrid
								x:Name="WarehouseGrid"
								Style="{StaticResource ModernGrid}"
								AutoGenerateColumns="False"
								ScrollViewer.CanContentScroll="False"
								Visibility="{Binding IsChecked, ElementName=WarehouseTableBtn, Converter='{StaticResource BoolToVis}'}"
								ItemsSource="{Binding WarehouseItems}"
                                MouseDoubleClick="WarehouseGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
										Header="Название"
										Width="*"
										MinWidth="140"
										Binding="{Binding ProductName}" />
                                    <DataGridTextColumn
										Header="Код"
										Width="100"
										Binding="{Binding Code}" />
                                    <DataGridTextColumn
										Header="Артикул"
										Width="110"
										Binding="{Binding Article}" />
                                    <DataGridTextColumn
										Header="Цена"
										Width="110"
										Binding="{Binding Price, StringFormat='{}{0:N2} сом'}" />
                                    <DataGridTextColumn
										Header="Скидка"
										Width="90"
										Binding="{Binding Discount, StringFormat={}{0:P0}}" />
                                    <DataGridTextColumn
										Header="Остаток"
										Width="90"
										Binding="{Binding StockQuantity}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock
								x:Name="WarehouseEmptyText"
								Text="Нет товаров для отображения"
								Foreground="{DynamicResource BrushTextSoft}"
								FontSize="16"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								TextWrapping="Wrap"
								Visibility="Collapsed"
								Panel.ZIndex="1" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border
				x:Name="HamburgerOverlay"
				Grid.RowSpan="2"
				Grid.ColumnSpan="3"
				Background="#80000000"
				Visibility="Collapsed"
				Panel.ZIndex="999"
				MouseDown="HamburgerOverlay_MouseDown" />
            <Border
				x:Name="HamburgerPanel"
				Grid.RowSpan="2"
				Grid.ColumnSpan="3"
				HorizontalAlignment="Left"
				VerticalAlignment="Stretch"
				Width="320"
				Margin="-320,0,0,0"
				Background="{DynamicResource BrushPanelElevated}"
				BorderBrush="{DynamicResource BrushBorder}"
				BorderThickness="0,0,1,0"
				Panel.ZIndex="1000">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="*" />
                    </Grid.RowDefinitions>
                    <Border
						Grid.Row="0"
						Padding="16,14"
						Background="{DynamicResource BrushPanel}">
                        <Grid>
                            <TextBlock
								Text="Nur Market"
								FontSize="18"
								FontWeight="Bold"
								Foreground="{DynamicResource BrushText}"
								VerticalAlignment="Center" />
                            <Button
								Content="✕"
								Style="{StaticResource TouchGhostButton}"
								Width="32"
								Height="32"
								Padding="0"
								HorizontalAlignment="Right"
								FontSize="18"
								Foreground="{DynamicResource BrushText}"
								Background="#00FFFFFF"
								Click="HamburgerMenuClose_Click" />
                        </Grid>
                    </Border>
                    <ScrollViewer
						Grid.Row="1"
						VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,8,0,16">
                            <Border Margin="12,0,12,10" Padding="14" CornerRadius="10"
								Background="{DynamicResource BrushPanel}"
								BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Кассовая смена" FontSize="12" FontWeight="SemiBold"
										Foreground="{DynamicResource BrushTextSoft}" />
                                    <TextBlock x:Name="HamburgerShiftBalanceText" Margin="0,6,0,0"
										FontSize="20" FontWeight="Bold"
										Foreground="{DynamicResource BrushAccent}" Text="—" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Открыть" Style="{StaticResource TouchSecondaryButton}"
											Padding="12,6" Margin="0,0,8,0" Click="OpenShift_Click" />
                                        <Button Content="Закрыть" Style="{StaticResource TouchSecondaryButton}"
											Padding="12,6" Click="CloseShift_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="РАБОТА" Margin="16,4,16,6" FontSize="11" FontWeight="Bold"
								Foreground="{DynamicResource BrushTextSoft}" />
                            <Button Content="Главная" Style="{StaticResource HamburgerMenuItem}" Click="MenuMain_Click" />
                            <Button Content="Склад" Style="{StaticResource HamburgerMenuItem}" Click="MenuWarehouse_Click" />
                            <Button Content="Возврат" Style="{StaticResource HamburgerMenuItem}" Click="ReturnSale_Click" />
                            <Button Content="Доп. услуги" Style="{StaticResource HamburgerMenuItem}" Click="MenuServices_Click" />

                            <TextBlock Text="ОТЧЁТЫ" Margin="16,12,16,6" FontSize="11" FontWeight="Bold"
								Foreground="{DynamicResource BrushTextSoft}" />
                            <Button Content="Аналитика" Style="{StaticResource HamburgerMenuItem}" Click="OpenFinanceWindow_Click" />

                            <TextBlock Text="СИСТЕМА" Margin="16,12,16,6" FontSize="11" FontWeight="Bold"
								Foreground="{DynamicResource BrushTextSoft}" />
                            <Button Content="Синхронизация" Style="{StaticResource HamburgerMenuItem}" Click="SyncNow_Click" />
                            <Button Content="Настройки" Style="{StaticResource HamburgerMenuItem}" Click="Settings_Click" />
                            <Separator Margin="12,8" Background="{DynamicResource BrushBorder}" />
                            <Button Content="Выйти" Style="{StaticResource HamburgerMenuItem}" Click="Logout_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
