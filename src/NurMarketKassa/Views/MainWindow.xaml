<Window x:Class="NurMarketKassa.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pos="clr-namespace:NurMarketKassa.Models.Pos"
        Title="Касса — Nur Market"
        Icon="pack://application:,,,/Assets/app-logo.png"
        Height="840" Width="1280"
        MinHeight="600" MinWidth="900"
        Style="{StaticResource AppWindow}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <!-- Штучная плитка каталога: без фото -->
        <DataTemplate x:Key="CatalogProductTileTemplate" DataType="{x:Type pos:CatalogProductTileVm}">
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0.5"
                    CornerRadius="5"
                    Padding="8,8,8,10"
                    Margin="4"
                    Width="{DynamicResource CatalogTileWidth}"
                    MinHeight="{DynamicResource CatalogTileMinHeight}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource CatalogTitleFont}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}"
                               TextWrapping="Wrap"
                               MaxHeight="{DynamicResource CatalogTitleMaxH}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PriceLine}"
                               Margin="0,6,0,10"
                               FontSize="{DynamicResource CatalogPriceFont}"
                               Foreground="{StaticResource BrushTextSoft}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Подробнее"
                                Click="CatalogProductDetail_Click"
                                Margin="0,0,4,0"
                                Padding="6,8"
                                FontSize="11"
                                Style="{StaticResource TouchGhostButton}"/>
                        <Button Grid.Column="1"
                                Content="В чек"
                                Click="CatalogProduct_Click"
                                IsEnabled="{Binding ShiftOpenForSale, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="4,0,0,0"
                                Padding="6,8"
                                FontSize="11"
                                Style="{StaticResource TouchPrimaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Весовая плитка каталога: с фото -->
        <DataTemplate x:Key="CatalogProductTileTemplateWeighed" DataType="{x:Type pos:CatalogProductTileVm}">
            <Border Background="{StaticResource BrushPanel}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0.5"
                    CornerRadius="5"
                    Padding="8,8,8,10"
                    Margin="4"
                    Width="{DynamicResource CatalogTileWidth}"
                    MinHeight="{DynamicResource CatalogTileMinHeight}">
                <StackPanel>
                    <Border Height="92"
                            Margin="0,0,0,8"
                            Background="{StaticResource BrushPanelSoft}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0.5"
                            CornerRadius="5"
                            ClipToBounds="True">
                        <Image Source="{Binding Thumb}"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="LowQuality"/>
                    </Border>
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource CatalogTitleFont}"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}"
                               TextWrapping="Wrap"
                               MaxHeight="{DynamicResource CatalogTitleMaxH}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PriceLine}"
                               Margin="0,6,0,10"
                               FontSize="{DynamicResource CatalogPriceFont}"
                               Foreground="{StaticResource BrushTextSoft}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="Подробнее"
                                Click="CatalogProductDetail_Click"
                                Margin="0,0,4,0"
                                Padding="6,8"
                                FontSize="11"
                                Style="{StaticResource TouchGhostButton}"/>
                        <Button Grid.Column="1"
                                Content="В чек"
                                Click="CatalogProduct_Click"
                                IsEnabled="{Binding ShiftOpenForSale, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="4,0,0,0"
                                Padding="6,8"
                                FontSize="11"
                                Style="{StaticResource TouchPrimaryButton}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- ± в строке корзины (размер задаётся DynamicResource CartUiQtyBtnSize) -->
        <Style x:Key="CartQtyMiniButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── ШАПКА (кнопки смены в одной строке с прочими действиями) ───── -->
        <Border Grid.Row="0"
                Style="{StaticResource ElevatedCardBorder}"
                Padding="16,13"
                CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип + имя -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/app-logo.png"
                           Width="34" Height="34" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="LowQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserTitleText"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"/>
                        <TextBlock x:Name="BranchText"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Статусы по центру -->
                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileStatusText"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSoft}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="NetworkModeText"
                               Margin="0,2,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,6,0,0">
                        <Button x:Name="OfflineSaleButton"
                                Content="Оффлайн"
                                Click="OfflineCheckout_Click"
                                Style="{StaticResource HeaderButton}"
                                Padding="10,6"
                                Margin="0,0,6,0"
                                ToolTip="Сохранить чек локально"/>
                        <Button x:Name="OfflineQueueButton"
                                Content="Очередь"
                                Click="OfflineQueueInfo_Click"
                                Style="{StaticResource HeaderButton}"
                                Padding="10,6"
                                ToolTip="Посмотреть состояние офлайн-очереди"/>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопки справа -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton"
                            Click="ThemeToggle_Click"
                            Style="{StaticResource HeaderButton}"
                            Width="38" Padding="0"
                            ToolTip="Переключить тему (тёмная / светлая)"
                            Margin="0,0,6,0">
                        <TextBlock x:Name="ThemeToggleGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="{DynamicResource BrushText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Click="ShowKeyboard_Click"
                            Style="{StaticResource HeaderButton}"
                            Width="38" Padding="0"
                            ToolTip="Экранная клавиатура"
                            Margin="0,0,6,0">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE92F;"
                                   FontSize="15"
                                   Foreground="{DynamicResource BrushText}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Button Content="Настройки"
                            Click="Settings_Click"
                            Style="{StaticResource HeaderButton}"
                            Margin="0,0,6,0"/>
                    <Button x:Name="PrintSelfCheckButton"
                            Content="Принтер"
                            Click="PrintSelfCheck_Click"
                            Style="{StaticResource HeaderButton}"
                            Margin="0,0,6,0"/>
                    <Button Content="Весы"
                            Click="ScaleTest_Click"
                            Style="{StaticResource HeaderButton}"
                            Margin="0,0,6,0"/>
                    <Border x:Name="ShiftBannerBar"
                            Background="{StaticResource BrushWarningSoft}"
                            BorderBrush="{StaticResource BrushWarning}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="4,2"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="OpenShiftButton"
                                    Content="Открыть смену"
                                    Click="OpenShift_Click"
                                    Style="{StaticResource HeaderButton}"
                                    Padding="8,5"
                                    Margin="0,0,4,0"/>
                            <Button x:Name="CloseShiftButton"
                                    Content="Закрыть смену"
                                    Click="CloseShift_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource HeaderButton}"
                                    Padding="8,5"/>
                        </StackPanel>
                    </Border>
                    <Button Content="Возврат"
                            Click="ReturnSale_Click"
                            Style="{StaticResource HeaderButton}"
                            Margin="0,0,6,0"
                            ToolTip="Возврат или отмена продажи по ID из чека / CRM"/>
                    <Button Content="Выйти"
                            Click="Logout_Click"
                            Style="{StaticResource TouchGhostButton}"
                            Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── ОСНОВНОЙ ЭКРАН (каталог | разделитель | чек) ─────────────── -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" MinWidth="360"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ── КАТАЛОГ ───────────────────────────────────────────────── -->
            <Border x:Name="CatalogAreaBorder"
                    Grid.Column="0"
                    Style="{StaticResource ElevatedCardBorder}"
                    Margin="0,0,6,0"
                    SizeChanged="CatalogArea_SizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Строка поиска -->
                    <Grid Grid.Row="0" Margin="0,0,0,10" Panel.ZIndex="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CatalogSearchBox"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource TouchTextBox}"
                                 TextChanged="CatalogSearchBox_TextChanged"/>
                        <TextBlock x:Name="CatalogStatsText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextSoft}"/>
                        <Button x:Name="RefreshCatalogButton"
                                Grid.Column="2"
                                Content="Обновить"
                                Click="RefreshCatalog_Click"
                                Style="{StaticResource TouchSecondaryButton}"/>
                    </Grid>

                    <!-- Статус весов -->
                    <TextBlock Grid.Row="1"
                               x:Name="ScaleStatusText"
                               Margin="0,0,0,8"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextSoft}"
                               TextWrapping="Wrap"/>

                    <!-- Вкладки каталога -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1"
                                Margin="0,0,0,4">
                        <TabControl x:Name="CatalogTabs"
                                    Style="{StaticResource PosCatalogTabControl}"
                                    ItemContainerStyle="{StaticResource PosCatalogTabItem}"
                                    Foreground="{StaticResource BrushTextMuted}"
                                    SelectionChanged="CatalogTabs_SelectionChanged">
                                <TabItem Header="Весовые (кг)" Margin="0,0,-3,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="0,8,0,0">
                                    <ItemsControl x:Name="CatalogItemsKg"
                                                  ItemTemplate="{StaticResource CatalogProductTileTemplateWeighed}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Штучные" Margin="5,0,-8,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              Padding="0,8,0,0">
                                    <ItemsControl x:Name="CatalogItemsPiece"
                                                  ItemTemplate="{StaticResource CatalogProductTileTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"
                                                           HorizontalAlignment="Center"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                        <Button x:Name="CatalogMoreButton"
                                Grid.Row="1"
                                Content="Показать еще"
                                Click="CatalogMore_Click"
                                Style="{StaticResource TouchSecondaryButton}"
                                HorizontalAlignment="Center"
                                Margin="0,8,0,0"
                                Padding="14,7"
                                Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Разделитель: тянуть влево/вправо -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BrushBorder}"
                          BorderBrush="{StaticResource BrushBorderStrong}"
                          BorderThickness="0.5,0"
                          ShowsPreview="True"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Cursor="SizeWE"/>

            <!-- Оверлей поиска -->
            <Border x:Name="SearchOverlayPanel"
                    Grid.Column="0"
                    Panel.ZIndex="10"
                    Margin="0,60,4,0"
                    Background="{StaticResource BrushOverlay}"
                    CornerRadius="8"
                    Padding="10"
                    Visibility="Collapsed">
                <Border Style="{StaticResource ElevatedCardBorder}"
                        Background="{StaticResource BrushWindowAlt}"
                        BorderBrush="{StaticResource BrushAccent}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Top"
                                   x:Name="SearchOverlayTitle"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="{StaticResource BrushText}"/>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="SearchMoreButton"
                                    DockPanel.Dock="Bottom"
                                    Content="Показать еще"
                                    Click="SearchMore_Click"
                                    Style="{StaticResource TouchSecondaryButton}"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Padding="14,7"
                                    Visibility="Collapsed"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="CatalogSearchItems"
                                          ItemTemplate="{StaticResource CatalogProductTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </DockPanel>
                </Border>
            </Border>

            <!-- ── ПРАВАЯ ПАНЕЛЬ (ЧЕК) ───────────────────────────────────── -->
            <Border Grid.Column="2"
                    Style="{StaticResource ElevatedCardBorder}"
                    Margin="6,0,0,0"
                    Padding="10,8">
                <DockPanel LastChildFill="True">

                    <!-- Текст статуса для подсказки у заголовка (не занимает место) -->
                    <TextBlock x:Name="CartStateText"
                               DockPanel.Dock="Top"
                               Visibility="Collapsed"
                               FontSize="10"
                               TextWrapping="Wrap"/>

                    <!-- ① Компактный заголовок (остальное — внизу над итогом) -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4"
                          ToolTip="{Binding ElementName=CartStateText, Path=Text}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Чек"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Border Style="{StaticResource BadgeBorder}"
                                    Margin="0,0,4,0"
                                    Padding="8,4"
                                    VerticalAlignment="Center" Width="55">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="поз: "
                                               Foreground="{StaticResource BrushTextSoft}"
                                               FontSize="9" RenderTransformOrigin="0.478,0.675" Height="12"/>
                                    <TextBlock x:Name="CartItemsCountText"
                                               Foreground="{StaticResource BrushText}"
                                               FontWeight="Bold"
                                               FontSize="12"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource BadgeBorder}"
                                    Background="{StaticResource BrushAccentSoft}"
                                    BorderBrush="{StaticResource BrushAccent}"
                                    Padding="8,4"
                                    VerticalAlignment="Center" Width="55">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="откл: "
                                               Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="9" Height="12"/>
                                    <TextBlock x:Name="DeferredCountText"
                                               Foreground="{StaticResource BrushAccent}"
                                               FontWeight="Bold"
                                               FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="StartSaleButton"
                                    Content="Новый"
                                    Click="StartSale_Click"
                                    Style="{StaticResource TouchGhostButton}"
                                    Padding="7,5"
                                    Margin="0,0,4,0"
                                    FontSize="11"
                                    ToolTip="Открыть пустой чек вручную"/>
                            <Button x:Name="RefreshCartButton"
                                    Content="↻"
                                    Click="RefreshCart_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource TouchSecondaryButton}"
                                    Padding="7,5"
                                    FontSize="12"
                                    ToolTip="Обновить чек"/>
                        </StackPanel>
                    </Grid>

                    <!-- Снизу: сначала блок «итого» (край окна), выше — сканер/отложить/скидка -->
                    <Border DockPanel.Dock="Bottom"
                            Style="{StaticResource ModernSectionBorder}"
                            Padding="12,10"
                            Margin="0,4,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource BrushWindowAlt}"
                                    BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="0,0,0,3"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,2">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Итого к оплате"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextSoft}"
                                               Margin="0,0,0,4"/>
                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Bottom">
                                        <TextBlock x:Name="CartTotalAmountText"
                                                   FontSize="28"
                                                   FontWeight="Bold"
                                                   LineHeight="32"
                                                   Foreground="{StaticResource BrushAccentStrong}"
                                                   Typography.NumeralAlignment="Tabular"/>
                                        <TextBlock Text=" сом"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   VerticalAlignment="Bottom"
                                                   Margin="6,0,0,3"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button x:Name="CheckoutFooterButton"
                                    Grid.Row="1"
                                    Content="Оплатить"
                                    Click="Checkout_Click"
                                    Style="{StaticResource TouchPrimaryButton}"
                                    IsEnabled="False"
                                    Background="{StaticResource BrushSuccess}"
                                    Foreground="#111827"
                                    BorderBrush="{StaticResource BrushSuccess}"
                                    Margin="0,8,0,0"
                                    Padding="10,6"
                                    HorizontalAlignment="Stretch"/>
                        </Grid>
                    </Border>

                    <Border DockPanel.Dock="Bottom"
                            Margin="0,4,0,0"
                            Style="{StaticResource ModernInfoPanel}"
                            Padding="8,6">
                        <Expander x:Name="CartToolsExpander"
                                  Style="{StaticResource PosExpander}"
                                  Header="Штрихкод · отложить · скидка"
                                  IsExpanded="True">
                            <StackPanel Margin="0,6,0,0">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BarcodeBox"
                                             Grid.Column="0"
                                             Margin="0,0,5,0"
                                             Style="{StaticResource TouchTextBox}"
                                             MinHeight="34"
                                             Padding="8,5"
                                             FontSize="13"
                                             KeyDown="BarcodeBox_KeyDown"/>
                                    <Button x:Name="ScanBarcodeButton"
                                            Grid.Column="1"
                                            Content="Добавить"
                                            Click="ScanBarcode_Click"
                                            Style="{StaticResource TouchSecondaryButton}"
                                            Padding="8,5"
                                            MinHeight="34"
                                            FontSize="12"/>
                                </Grid>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="DeferCartButton"
                                            Grid.Column="0"
                                            Content="Отложить"
                                            Click="DeferCart_Click"
                                            Style="{StaticResource TouchSecondaryButton}"
                                            Padding="6,5"
                                            Margin="0,0,3,0"
                                            MinWidth="0"
                                            FontSize="11"
                                            ToolTip="Сохранить корзину и открыть новую продажу"/>
                                    <Button x:Name="RestoreLatestDeferredButton"
                                            Grid.Column="1"
                                            Content="Вернуть"
                                            Click="RestoreLatestDeferred_Click"
                                            Style="{StaticResource TouchSecondaryButton}"
                                            Padding="6,5"
                                            Margin="0,0,3,0"
                                            MinWidth="0"
                                            FontSize="11"
                                            ToolTip="Вернуть последний отложенный чек"/>
                                    <Button x:Name="OpenDeferredCartsButton"
                                            Grid.Column="2"
                                            Content="Список…"
                                            Click="OpenDeferredCarts_Click"
                                            Style="{StaticResource TouchSecondaryButton}"
                                            Padding="6,5"
                                            MinWidth="0"
                                            FontSize="11"
                                            ToolTip="Посмотреть все отложенные корзины"/>
                                </Grid>
                                <Border Style="{StaticResource ModernInfoPanel}"
                                        Padding="8,6"
                                        Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Скидка"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushTextMuted}"/>
                                            <TextBlock x:Name="OrderDiscountSummaryText"
                                                       Margin="0,1,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource BrushTextSoft}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="OrderDiscountButton"
                                                Grid.Column="1"
                                                Content="Изменить"
                                                Click="ApplyOrderDiscount_Click"
                                                Style="{StaticResource TouchSecondaryButton}"
                                                Padding="8,4"
                                                Margin="8,0,0,0"
                                                MinWidth="0"
                                                FontSize="10"
                                                VerticalAlignment="Center"
                                                ToolTip="Открыть окно настройки скидки"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="CartMessageText"
                                           TextWrapping="Wrap"
                                           FontSize="10"
                                           MinHeight="0"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <!-- ⑤ Список позиций корзины -->
                    <ListView x:Name="CartListView"
                              ItemsSource="{Binding CartLines}"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="{StaticResource BrushText}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              SizeChanged="CartListView_SizeChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type pos:CartLineRow}">
                                <Border HorizontalAlignment="Stretch"
                                        Background="{StaticResource BrushWindowAlt}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="0.5"
                                        CornerRadius="8"
                                        Padding="8,6">
                                    <Grid HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto" MinWidth="{DynamicResource CartUiSumColMinW}"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Название + подстрока -->
                                        <StackPanel Grid.Column="0"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="{DynamicResource CartUiTitleFont}"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushText}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SubLine}"
                                                       Margin="0,2,0,0"
                                                       FontSize="{DynamicResource CartUiSubFont}"
                                                       Foreground="{StaticResource BrushTextSoft}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Сумма по строке — по центру колонки и по вертикали всей позиции -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LineTotal}"
                                                   FontSize="{DynamicResource CartUiLineTotalFont}"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"/>

                                        <!-- Взвесить, −, +, Удалить — в один ряд -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="6,0,0,0">
                                            <Button Content="Взвесить"
                                                    Click="CartWeigh_Click"
                                                    Style="{StaticResource TouchSecondaryButton}"
                                                    FontSize="{DynamicResource CartUiSmallBtnFont}"
                                                    Padding="6,2"
                                                    MinWidth="0"
                                                    MinHeight="{DynamicResource CartUiSmallBtnMinH}"
                                                    Margin="{DynamicResource CartUiQtyBtnSpacing}"
                                                    ToolTip="Указать вес"
                                                    Visibility="{Binding WeighedLine, Converter={StaticResource BoolToVis}}"/>
                                            <Button Content="−"
                                                    Click="CartQtyMinus_Click"
                                                    Style="{StaticResource CartQtyMiniButton}"
                                                    Width="{DynamicResource CartUiQtyBtnSize}"
                                                    Height="{DynamicResource CartUiQtyBtnSize}"
                                                    MinHeight="{DynamicResource CartUiQtyBtnSize}"
                                                    Margin="{DynamicResource CartUiQtyBtnSpacing}"
                                                    FontSize="{DynamicResource CartUiQtyBtnFont}"
                                                    ToolTip="Уменьшить"/>
                                            <Button Content="+"
                                                    Click="CartQtyPlus_Click"
                                                    Style="{StaticResource CartQtyMiniButton}"
                                                    Width="{DynamicResource CartUiQtyBtnSize}"
                                                    Height="{DynamicResource CartUiQtyBtnSize}"
                                                    MinHeight="{DynamicResource CartUiQtyBtnSize}"
                                                    Margin="{DynamicResource CartUiQtyBtnSpacing}"
                                                    FontSize="{DynamicResource CartUiQtyBtnFont}"
                                                    ToolTip="Увеличить"/>
                                            <Button Content="Удалить"
                                                    Click="CartLineDelete_Click"
                                                    Style="{StaticResource TouchDangerButton}"
                                                    FontSize="{DynamicResource CartUiSmallBtnFont}"
                                                    Padding="8,2"
                                                    MinWidth="0"
                                                    MinHeight="{DynamicResource CartUiSmallBtnMinH}"
                                                    ToolTip="Убрать из чека"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <!-- Toast -->
            <Border x:Name="ToastPanel"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Panel.ZIndex="50"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,14"
                    Background="{StaticResource BrushPanelSoft}"
                    BorderBrush="{StaticResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,10"
                    Visibility="Collapsed"
                    MaxWidth="700">
                <TextBlock x:Name="ToastText"
                           Foreground="{StaticResource BrushText}"
                           TextWrapping="Wrap"
                           FontSize="13"/>
            </Border>
        </Grid>
    </Grid>
</Window>
