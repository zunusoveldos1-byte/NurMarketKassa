<Window x:Class="NurMarketKassa.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Фильтры"
        Height="360" Width="960"
        Style="{DynamicResource AppWindow}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <Style x:Key="FilterLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,0,8,12"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Width" Value="160"/>
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="4,4"/>
                <Setter Property="Margin" Value="0,0,8,12"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Width" Value="160"/>
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="Margin" Value="0,8,16,0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>

            <Style x:Key="PlaceholderComboBox" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="IsEditable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- Когда есть элементы, показываем стандартный ComboBox -->
                                <ComboBox x:Name="InnerCombo"
                              ItemsSource="{TemplateBinding ItemsSource}"
                              SelectedItem="{TemplateBinding SelectedItem}"
                              IsEnabled="{TemplateBinding IsEnabled}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              Background="{TemplateBinding Background}"
                              Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}"
                              Padding="{TemplateBinding Padding}"
                              Margin="0"/>
                                <!-- Когда список пуст, показываем TextBlock с сообщением -->
                                <TextBlock x:Name="EmptyPlaceholder"
                               Text="Нет данных"
                               Foreground="{DynamicResource BrushTextSoft}"
                               FontSize="14"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               Visibility="Collapsed"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=InnerCombo}" Value="0">
                                    <Setter TargetName="InnerCombo" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="EmptyPlaceholder" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LargeCheckBox" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="MinHeight" Value="56"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="CheckBoxBorder" Grid.Column="0"
                            Width="28" Height="28" CornerRadius="6"
                            BorderBrush="{DynamicResource BrushBorderStrong}"
                            BorderThickness="2"
                            Background="{DynamicResource BrushInput}"
                            VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <Path x:Name="CheckMark" Grid.Column="0"
                          Data="M4,10 L8,14 L14,6"
                          Stroke="{DynamicResource BrushAccent}" StrokeThickness="3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="Collapsed"
                          Width="18" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="0,0,14,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="CheckMark" Property="Stroke" Value="White"/>
                                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                                    <Setter TargetName="CheckBoxBorder" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border Background="{DynamicResource BrushPanel}"
            CornerRadius="12"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1"
            Effect="{DynamicResource CardShadow}"
            Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Фильтры" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Фильтры в горизонтальном WrapPanel -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal">
                <!-- Дата начала -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Дата начала" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="DateFromPicker"/>
                </StackPanel>

                <!-- Дата конца -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Дата конца" Style="{StaticResource FilterLabel}"/>
                    <DatePicker x:Name="DateToPicker"/>
                </StackPanel>

                <!-- Категория -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Категория" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="CategoryCombo"
                    Style="{StaticResource PlaceholderComboBox}"/>
                </StackPanel>

                <!-- Бренд -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Бренд" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="BrandCombo"
                    Style="{StaticResource PlaceholderComboBox}"/>
                </StackPanel>

                <!-- Клиент -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Клиент" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="ClientCombo"/>
                </StackPanel>

                <!-- Статус -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Статус" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="StatusCombo"
                    Style="{StaticResource PlaceholderComboBox}"/>
                </StackPanel>

                <!-- Горячие клавиши -->
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Горячие клавиши" Style="{StaticResource FilterLabel}"/>
                    <ComboBox x:Name="HotkeyGroupCombo"
                    Style="{StaticResource PlaceholderComboBox}"/>
                </StackPanel>

                <!-- Чекбоксы -->
                <!-- Чекбоксы -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                    <CheckBox x:Name="WeightCheck" Content="Только весовые"
              Style="{StaticResource LargeCheckBox}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="InStockCheck" Content="В наличии"
              Style="{StaticResource LargeCheckBox}" Margin="0,0,20,0"/>
                    <CheckBox x:Name="FavoriteCheck" Content="Избранное"
              Style="{StaticResource LargeCheckBox}"/>
                </StackPanel>
            </WrapPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Сбросить" Style="{StaticResource TouchSecondaryButton}"
                        Width="120" Height="44" FontSize="16"
                        Margin="0,0,12,0" Click="Reset_Click"/>
                <Button Content="Применить"
                        Width="120" Height="44"
                        FontSize="16"
                        Background="#FFD700"
                        Foreground="#111827"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Apply_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>