<dialogs:AppOverlayDialogBase x:Class="NurMarketKassa.Views.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:NurMarketKassa.Views.Dialogs"
        Title="Фильтр товаров"
        FontFamily="Segoe UI">

    <dialogs:AppOverlayDialogBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Dialogs/NurMarketDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </dialogs:AppOverlayDialogBase.Resources>

    <Grid x:Name="RootGrid" Opacity="0">
        <Border Background="#59000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Border x:Name="DialogCard" Style="{StaticResource NurDialogCard}" Width="480" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource NurDialogHeader}">
                    <Grid>
                        <TextBlock Text="Фильтр товаров" Style="{StaticResource NurDialogTitleText}"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource NurDialogChromeButton}"
                                HorizontalAlignment="Right" Click="Cancel_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16,24,8">
                    <StackPanel>
                        <TextBlock Text="Поиск" Style="{StaticResource NurDialogFieldLabel}"/>
                        <Grid Margin="0,0,0,14">
                            <TextBox x:Name="SearchBox" Style="{StaticResource NurDialogTextBox}"/>
                            <TextBlock Text="Название / ШК / Артикул..."
                                       Foreground="#94A3B8" FontSize="14" Margin="14,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="Тип товара" Style="{StaticResource NurDialogFieldLabel}"/>
                        <ComboBox x:Name="CatalogKindCombo" Style="{StaticResource NurDialogComboBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Категория" Style="{StaticResource NurDialogFieldLabel}"/>
                        <ComboBox x:Name="CategoryCombo" Style="{StaticResource NurDialogComboBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Бренд" Style="{StaticResource NurDialogFieldLabel}"/>
                        <ComboBox x:Name="BrandCombo" Style="{StaticResource NurDialogComboBox}" Margin="0,0,0,14"/>

                        <TextBlock Text="Диапазон цены (сом)" Style="{StaticResource NurDialogFieldLabel}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PriceMinBox" Grid.Column="0" Style="{StaticResource NurDialogTextBox}"/>
                            <TextBox x:Name="PriceMaxBox" Grid.Column="2" Style="{StaticResource NurDialogTextBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Цена от" Foreground="#94A3B8" FontSize="11"/>
                            <TextBlock Grid.Column="2" Text="Цена до" Foreground="#94A3B8" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Style="{StaticResource NurDialogFooter}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Сбросить" Style="{StaticResource NurDialogSecondaryButton}"
                                Click="Reset_Click"/>
                        <Button Grid.Column="2" Content="Отмена" Style="{StaticResource NurDialogSecondaryButton}"
                                Click="Cancel_Click"/>
                        <Button Grid.Column="4" Content="Применить" Style="{StaticResource NurDialogPrimaryButton}"
                                Click="Apply_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</dialogs:AppOverlayDialogBase>
