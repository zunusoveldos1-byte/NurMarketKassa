<Window x:Class="NurMarketKassa.Views.PosSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки кассы"
        Height="800" Width="720"
        MinHeight="700" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource AppWindow}">

    <FrameworkElement.Resources>
        <ResourceDictionary>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ======================== Тумблер ======================== -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="track" Width="52" Height="28" CornerRadius="14"
                                        Background="{DynamicResource BrushInputAlt}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"/>
                                <Ellipse x:Name="dot" Width="24" Height="24"
                                         Fill="White"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="dot" Property="Margin" Value="26,0,2,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ======================== Пилюля выбора ======================== -->
            <Style x:Key="DatePill" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="pill"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ======================== Поле ввода ======================== -->
            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource BrushText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ======================== Метки полей ======================== -->
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- ======================== Карточка настроек ======================== -->
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="22,18"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,16"/>
            </Style>

            <!-- ======================== Алерт ======================== -->
            <Style x:Key="AlertBlock" TargetType="Border">
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,12,0,0"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- ======================== Улучшенный стиль вкладок ======================== -->
            <Style x:Key="TabItemStyle" TargetType="TabItem" BasedOn="{StaticResource PosCatalogTabItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="22,14"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="MinHeight" Value="48"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabRoot"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Адаптивный стиль комбобокса -->
            <Style x:Key="TouchComboBox" TargetType="{x:Type ComboBox}">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="44"/>
                            <Setter Property="FontSize" Value="17"/>
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                                <Setter TargetName="Bd" Property="TextElement.Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <ToggleButton x:Name="toggleBtn"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  Cursor="Hand"
                                  ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PART_EditableTextBox"
                                                 Grid.Column="0"
                                                 Margin="6,0,0,0"
                                                 VerticalAlignment="Center"
                                                 Background="Transparent"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 CaretBrush="{TemplateBinding Foreground}"
                                                 Visibility="Hidden"/>
                                                    <ContentPresenter x:Name="ContentSite"
                                                          Grid.Column="0"
                                                          Margin="10,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"/>
                                                    <Path x:Name="Arrow"
                                              Grid.Column="1"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M0,0 L5,5 10,0 Z"
                                              Fill="{TemplateBinding Foreground}"
                                              Margin="0,0,12,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}" Value="True">
                                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                    <Grid MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border Background="{DynamicResource BrushPanel}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="0 0 8 8"
                                    Margin="0,-1,0,0"/>
                                        <ScrollViewer Margin="6,8" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="toggleBtn" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </FrameworkElement.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1000" HorizontalAlignment="Center" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======================== Заголовок ======================== -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Настройки кассы" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Оборудование, печать и внешний вид" FontSize="17" Foreground="{DynamicResource BrushTextSoft}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ======================== Вкладки ======================== -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                        ItemContainerStyle="{StaticResource TabItemStyle}">

                <!-- ======================== Весы ======================== -->
                <TabItem Margin="0,0,-5,0">
                    <TabItem.Header>
                        <TextBlock Text="⚖️ Весы" FontSize="17" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16">
                        <StackPanel>
                            <CheckBox x:Name="ScaleEnabledCheck" Content="Включить опрос весов"
                                      Style="{StaticResource ToggleSwitch}" Margin="0,0,0,18"/>

                            <Border Style="{StaticResource SettingsCard}">
                                <StackPanel>
                                    <TextBlock Text="COM-порт" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ScaleComCombo"
                                              IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"
                                              Style="{DynamicResource TouchComboBox}" Margin="0,0,0,16" />

                                    <TextBlock Text="Скорость (baud)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ScaleBaudBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"
                                             IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"/>

                                    <TextBlock Text="Запрос веса (hex)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ScaleHexBox" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"
                                             IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"
                                             ToolTip="Пример: 05 02 01 01"/>

                                    <TextBlock Text="Повтор запроса (мс)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ScalePollBox" Style="{StaticResource ModernTextBox}"
                                             IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Проверить весы" Style="{StaticResource TouchSecondaryButton}"
                                    Click="CheckScale_Click" Margin="0,6,0,12" Height="46" FontSize="16"/>
                            <Border x:Name="ScaleAlert" Style="{StaticResource AlertBlock}" Visibility="Collapsed">
                                <TextBlock x:Name="ScaleAlertText" TextWrapping="Wrap" FontSize="15"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================== Печать ======================== -->
                <TabItem Header="🖨️ Печать">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16">
                        <StackPanel>
                            <!-- Общий чекбокс включения печати -->
                            <CheckBox x:Name="ReceiptEnabledCheck" 
                      Content="Печатать чек при оплате"
                      Style="{StaticResource ToggleSwitch}" 
                      Margin="0,0,0,18"/>

                            <!-- Выбор режима печати -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="TextModeRadio" 
                             Content="📄 Текстовый чек (ESC/POS)"
                             GroupName="PrintMode"
                             Margin="0,0,20,0"
                             FontSize="14"
                             FontWeight="SemiBold"
                             IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
                                <RadioButton x:Name="GraphicModeRadio" 
                             Content="🖼️ Графический чек"
                             GroupName="PrintMode"
                             FontSize="14"
                             FontWeight="SemiBold"
                             IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
                            </StackPanel>

                            <!-- ===== СЕКЦИЯ ТЕКСТОВОЙ ПЕЧАТИ ===== -->
                            <Border Style="{StaticResource SettingsCard}" 
                    Margin="0,0,0,20"
                    Visibility="{Binding IsChecked, ElementName=TextModeRadio, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Текстовая печать (ESC/POS)" 
                               FontWeight="SemiBold" 
                               FontSize="15" 
                               Margin="0,0,0,12"/>

                                    <TextBlock Text="LPT-порт или путь" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ReceiptLptBox" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,16"/>

                                    <TextBlock Text="Кодировка текста" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ReceiptEncCombo" 
                              Margin="0,0,0,16"
                              Style="{DynamicResource TouchComboBox}">
                                        <ComboBoxItem Content="cp866 — кириллица DOS/OEM" Tag="cp866"/>
                                        <ComboBoxItem Content="cp1251 / windows-1251" Tag="cp1251"/>
                                        <ComboBoxItem Content="wpc1251 (слот 46)" Tag="wpc1251"/>
                                        <ComboBoxItem Content="iso-8859-5 (Кириллица ISO)" Tag="iso-8859-5"/>
                                        <ComboBoxItem Content="koi8-r (Unix-кодировка)" Tag="koi8-r"/>
                                        <ComboBoxItem Content="utf-8 (Юникод)" Tag="utf-8"/>
                                    </ComboBox>

                                    <TextBlock Text="Таблица ESC t" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="ReceiptTableCombo" 
                              Margin="0,0,0,16"
                              Style="{DynamicResource TouchComboBox}">
                                        <ComboBoxItem Content="Авто" Tag=""/>
                                        <ComboBoxItem Content="17 — CP866 / OEM" Tag="17"/>
                                        <ComboBoxItem Content="46 — CP1251 / WPC1251" Tag="46"/>
                                        <ComboBoxItem Content="73" Tag="73"/>
                                        <ComboBoxItem Content="26 — ISO 8859-5" Tag="26"/>
                                        <ComboBoxItem Content="53 — KOI8-R" Tag="53"/>
                                        <ComboBoxItem Content="0 — UTF-8 (редко)" Tag="0"/>
                                    </ComboBox>

                                    <TextBlock Text="ESC R (0–255)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ReceiptEscRBox" 
                             Style="{StaticResource ModernTextBox}" 
                             Margin="0,0,0,16"/>

                                    <TextBlock Text="Повторы печати при сбое" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ReceiptRetryBox" 
                             Style="{StaticResource ModernTextBox}"/>

                                    <Button Content="🧪 Тест текстового чека (ESC/POS)"
                            Style="{StaticResource TouchSecondaryButton}"
                            Click="TestTextPrint_Click"
                            Height="46"
                            FontSize="14"
                            Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- ===== СЕКЦИЯ ГРАФИЧЕСКОЙ ПЕЧАТИ ===== -->
                            <Border Style="{StaticResource SettingsCard}" 
                    Margin="0,0,0,20"
                    Visibility="{Binding IsChecked, ElementName=GraphicModeRadio, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Графический чек" 
                               FontWeight="SemiBold" 
                               FontSize="15" 
                               Margin="0,0,0,12"/>

                                    <CheckBox x:Name="GraphicReceiptEnabledCheck" 
                              Content="Включить графический чек"
                              Style="{StaticResource ToggleSwitch}" 
                              Margin="0,0,0,12"/>

                                    <TextBlock Text="Ширина бумаги (пикселей)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="GraphicWidthBox" 
                                        Text="384" 
                                        Style="{StaticResource ModernTextBox}" 
                                        Margin="0,0,0,12"
                                        ToolTip="384 (для 58‑мм принтера) или 576 (для 80‑мм)"/>

                                    <TextBlock Text="Шрифт (кириллица/кыргызский)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="GraphicFontCombo" 
                                            Style="{DynamicResource TouchComboBox}" 
                                            Margin="0,0,0,12">
                                        <ComboBoxItem Content="Consolas (рекомендуется)" Tag="Consolas"/>
                                        <ComboBoxItem Content="Lucida Console" Tag="Lucida Console"/>
                                        <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                                        <ComboBoxItem Content="Arial" Tag="Arial"/>
                                        <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
                                    </ComboBox>

                                    <TextBlock Text="Размер шрифта (пиксели)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                    <ComboBox x:Name="GraphicFontSizeCombo" 
                                        Style="{DynamicResource TouchComboBox}" 
                                        Margin="0,0,0,12"
                                        ToolTip="Выберите размер шрифта для чека">
                                        <ComboBoxItem Content="6" Tag="6"/>
                                        <ComboBoxItem Content="8" Tag="8"/>
                                        <ComboBoxItem Content="10" Tag="10"/>
                                        <ComboBoxItem Content="12" Tag="12"/>
                                        <ComboBoxItem Content="14" Tag="14"/>
                                        <ComboBoxItem Content="16" Tag="16"/>
                                        <ComboBoxItem Content="18" Tag="18"/>
                                        <ComboBoxItem Content="20" Tag="20"/>
                                        <ComboBoxItem Content="22" Tag="22"/>
                                        <ComboBoxItem Content="24" Tag="24"/>
                                    </ComboBox>

                                    <TextBlock Text="Элементы чека" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                                    <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                                        <CheckBox x:Name="ShowStoreNameCheck" Content="Название магазина" Style="{StaticResource ToggleSwitch}"/>
                                        <CheckBox x:Name="ShowAddressCheck" Content="Адрес" Style="{StaticResource ToggleSwitch}"/>
                                        <CheckBox x:Name="ShowReceiptNumberCheck" Content="Номер чека" Style="{StaticResource ToggleSwitch}"/>
                                        <CheckBox x:Name="ShowDateCheck" Content="Дата и время" Style="{StaticResource ToggleSwitch}"/>
                                        <CheckBox x:Name="ShowItemsCheck" Content="Список товаров" Style="{StaticResource ToggleSwitch}"/>
                                        <CheckBox x:Name="ShowTotalCheck" Content="Итог (сумма)" Style="{StaticResource ToggleSwitch}"/>
                                        <CheckBox x:Name="ShowQrCodeCheck" Content="QR-код (если загружен)" Style="{StaticResource ToggleSwitch}"/>
                                    </StackPanel>

                                    <TextBlock Text="QR-код (сохраняется для будущего)" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="📷 Загрузить QR-код" 
                                Style="{StaticResource TouchSecondaryButton}"
                                Click="LoadGraphicQrCode_Click"
                                Height="36"
                                Margin="0,0,10,0"/>
                                        <Button Content="🗑️ Удалить QR-код" 
                                Style="{StaticResource TouchSecondaryButton}"
                                Click="DeleteGraphicQrCode_Click"
                                Height="36"/>
                                    </StackPanel>
                                    <TextBlock x:Name="GraphicQrStatusText" 
                               Text="QR-код не загружен" 
                               FontSize="12" 
                               Foreground="Gray"/>

                                    <Button Content="🧪 Тест графического чека" 
                            Style="{StaticResource TouchSecondaryButton}"
                            Click="TestGraphicPrint_Click"
                            Height="46"
                            FontSize="14"
                            Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Поле статуса -->
                            <TextBox x:Name="StatusText"
                     Style="{StaticResource ModernTextBox}"
                     Height="80"
                     Margin="0,8,0,0"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     FontSize="13"
                     Foreground="{DynamicResource BrushText}"
                     Background="{DynamicResource BrushInputAlt}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================== Экран ======================== -->
                <TabItem Margin="3,0,-2,0">
                    <TabItem.Header>
                        <TextBlock Text="🖥️ Экран" FontSize="17" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16">
                        <StackPanel>
                            <TextBlock Text="Экран и автозагрузка" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,18"/>
                            <CheckBox x:Name="FullscreenCheck" Content="Полноэкранный режим"
                                      Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="AutostartCheck" Content="Запускать вместе с Windows"
                                      Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="AutoTouchKeyboardCheck" Content="Авто‑показ экранной клавиатуры"
                                      Style="{StaticResource ToggleSwitch}" Margin="0,0,0,14"/>
                            <TextBlock Text="Название магазина в чеке" Style="{StaticResource FieldLabel}" Margin="0,20,0,0"/>
                            <TextBox x:Name="StoreNameBox" 
                                        Style="{StaticResource ModernTextBox}" 
                                        Margin="0,0,0,14"
                                        ToolTip="Отображается в верхней части чека"/>
                            <TextBlock Text="Добавление в чек:" Foreground="{DynamicResource BrushText}"
                                       FontSize="17" Margin="0,22,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DoubleClickToCartRadio" Content="Двойной клик"
                                             Style="{StaticResource DatePill}" Margin="0,0,12,0"
                                             Checked="ClickToCartMode_Changed"/>
                                <RadioButton x:Name="SingleClickToCartRadio" Content="Один клик"
                                             Style="{StaticResource DatePill}" Checked="ClickToCartMode_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================== Обновления ======================== -->
                <TabItem Margin="-1,0,0,0">
                    <TabItem.Header>
                        <TextBlock Text="🔄 Обновления" FontSize="17" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16">
                        <StackPanel>
                            <TextBlock x:Name="AppVersionText" FontSize="16" Foreground="{DynamicResource BrushTextSoft}"
                                       Margin="0,0,0,14"/>
                            <Button Content="Проверить обновления" Style="{StaticResource TouchSecondaryButton}"
                                    Click="CheckUpdate_Click" Height="46" FontSize="16"/>
                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,8,0,0" 
                                    Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>
                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" 
                                    Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ======================== Операции (QR-коды банков) ======================== -->
                <TabItem Margin="1,0,0,0">
                    <TabItem.Header>
                        <TextBlock Text="🏦 Операции" FontSize="17" FontWeight="SemiBold"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,16">
                        <StackPanel>
                            <TextBlock Text="QR-коды и логотипы банков для безналичной оплаты" 
                       FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource BrushText}" Margin="0,0,0,18"/>

                            <ItemsControl x:Name="BankQrItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SettingsCard}" Padding="16" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Image Grid.Column="0"
                                                    Source="{Binding LogoPath}"
                                                    Width="64" Height="64"
                                                    Stretch="Uniform"
                                                    Margin="0,0,16,0"
                                                    VerticalAlignment="Center"/>

                                                <!-- Название + QR -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BankName}"
                                               FontSize="18" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushText}"
                                               Margin="0,0,0,8"/>
                                                    <Image Source="{Binding QrCodePath, TargetNullValue={x:Null}}"
                                           Width="120" Height="120"
                                           Stretch="Uniform"
                                           Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVis}}"
                                           Margin="0,0,0,8"/>
                                                </StackPanel>

                                                <!-- Кнопка загрузки QR -->
                                                <Button Grid.Column="2"
                                        Content="Загрузить QR"
                                        Style="{StaticResource TouchSecondaryButton}"
                                        Height="36" FontSize="14"
                                        Padding="12,6"
                                        Tag="{Binding}"
                                        Click="LoadQrCode_Click"
                                        VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ======================== Футер ======================== -->
            <Border Grid.Row="2" Height="1" Background="{DynamicResource BrushBorder}" Margin="0,20,0,0" Opacity="0.5"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource TouchSecondaryButton}"
                        Margin="0,0,14,0" Click="Cancel_Click" FontWeight="SemiBold" Height="48" Width="140" FontSize="17"/>
                <Button Content="Сохранить" Style="{StaticResource TouchPrimaryButton}"
                        Click="Save_Click" FontWeight="SemiBold" Height="48" Width="140" FontSize="17"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>