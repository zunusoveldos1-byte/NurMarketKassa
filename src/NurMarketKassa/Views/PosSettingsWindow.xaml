<Window x:Class="NurMarketKassa.Views.PosSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки кассы"
        Height="820" Width="980"
        MinHeight="760" MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource AppWindow}">

    <FrameworkElement.Resources>
        <ResourceDictionary>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Тумблер -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="track" Width="46" Height="26" CornerRadius="13"
                                        Background="{DynamicResource BrushInputAlt}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1"
                                        Margin="0,0,10,0"/>
                                <Ellipse x:Name="dot" Width="20" Height="20"
                                         Fill="{DynamicResource BrushWindowAlt}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
                                    <Setter TargetName="dot" Property="Margin" Value="23,0,3,0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Сегментированный переключатель -->
            <Style x:Key="DatePill" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
                <Setter Property="Padding" Value="18,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="MinHeight" Value="42"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="pill"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1" CornerRadius="0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextInverted}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernTextBox" TargetType="TextBox">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource BrushText}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BrushCatalogTileBg}"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="Padding" Value="16"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushCatalogTileBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="AlertBlock" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="12,10"/>
                <Setter Property="Margin" Value="0,10,0,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}"/>
            </Style>

            <Style x:Key="SettingsGhostButton" TargetType="Button" BasedOn="{StaticResource TouchGhostButton}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <Style x:Key="SettingsSaveButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
                <Setter Property="Height" Value="40"/>
                <Setter Property="Padding" Value="18,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Style>

            <Style x:Key="SettingsFlatButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Боковая навигация -->
            <Style x:Key="SidebarTabItem" TargetType="TabItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabRoot" Background="Transparent" Padding="{TemplateBinding Padding}" Cursor="Hand" Margin="8,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="AccentBar" Grid.Column="0" Background="Transparent" CornerRadius="2" Margin="0,4"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                    <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource BrushInputAlt}"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabRoot" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TouchComboBox" TargetType="{x:Type ComboBox}">
                <Setter Property="Height" Value="42"/>
                <Setter Property="Background" Value="{DynamicResource BrushInput}"/>
                <Setter Property="Foreground" Value="{DynamicResource BrushText}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ComboBoxItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccentSoft}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="TextElement.FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ComboBox}">
                            <Grid>
                                <ToggleButton x:Name="toggleBtn"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Cursor="Hand" ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="6,0,0,0"
                                                             VerticalAlignment="Center" Background="Transparent"
                                                             Foreground="{TemplateBinding Foreground}"
                                                             CaretBrush="{TemplateBinding Foreground}" Visibility="Hidden"/>
                                                    <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="10,0,0,0"
                                                                      VerticalAlignment="Center"
                                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}"/>
                                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M0,0 L5,5 10,0 Z" Fill="{TemplateBinding Foreground}" Margin="0,0,12,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource FindAncestor, AncestorType=ComboBox}}" Value="True">
                                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" Placement="Bottom"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                    <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border Background="{DynamicResource BrushPanel}"
                                                BorderBrush="{DynamicResource BrushBorder}"
                                                BorderThickness="1" CornerRadius="0 0 8 8" Margin="0,-1,0,0"/>
                                        <ScrollViewer Margin="6,8" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="toggleBtn" Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsTabControl" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BrushPanelSoft}"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0">
                                    <DockPanel LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,20,16,24">
                                            <Border Width="36" Height="36" CornerRadius="8"
                                                    Background="{DynamicResource BrushAccentSoft}" Margin="0,0,10,0">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                           Foreground="{DynamicResource BrushText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Настройки" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                                                <TextBlock Text="кассы" FontSize="13" Foreground="{DynamicResource BrushTextSoft}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Top" IsItemsHost="True"
                                                  Background="Transparent" KeyboardNavigation.TabIndex="1"/>
                                    </DockPanel>
                                </Border>
                                <Grid Grid.Column="1" Background="{DynamicResource BrushWindowAlt}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Padding="24,20,24,16" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Настройки кассы" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushText}"/>
                                                <TextBlock Text="Оборудование, печать и внешний вид" FontSize="13"
                                                           Foreground="{DynamicResource BrushTextSoft}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="✕  Отмена" Style="{StaticResource SettingsGhostButton}"
                                                        Margin="0,0,10,0" Click="Cancel_Click"/>
                                                <Button Content="💾  Сохранить" Style="{StaticResource SettingsSaveButton}"
                                                        Click="Save_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Padding="24,16,24,8">
                                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                                          ContentSource="SelectedContent"
                                                          Margin="0"/>
                                    </Border>
                                    <Border Grid.Row="2" Background="{DynamicResource BrushSurfaceSubtle}" Padding="24,12"
                                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Изменения сохраняются сразу после нажатия кнопки «Сохранить»."
                                                       FontSize="12" Foreground="{DynamicResource BrushTextSoft}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </FrameworkElement.Resources>

    <TabControl Style="{StaticResource SettingsTabControl}"
                TabStripPlacement="Left"
                ItemContainerStyle="{StaticResource SidebarTabItem}">

        <!-- ======================== Весы ======================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Весы" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Весы" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="Настройка оборудования весов и параметров подключения"
                                       FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Style="{StaticResource SettingsCard}" Padding="16" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Параметры подключения" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" VerticalAlignment="Center"/>
                            <CheckBox x:Name="ScaleEnabledCheck" Content="Включить опрос весов"
                                      Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="COM-порт" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ScaleComCombo"
                                          IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"
                                          SelectionChanged="ScaleComCombo_SelectionChanged"
                                          Style="{DynamicResource TouchComboBox}"/>
                                <TextBlock x:Name="StatusScalePortText" Text="○ Статус порта не проверен"
                                           FontSize="12" FontWeight="Bold" Margin="0,6,0,0"
                                           Foreground="{DynamicResource BrushTextSoft}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Скорость (baud)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ScaleBaudBox" Style="{StaticResource ModernTextBox}"
                                         IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Запрос веса (hex)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ScaleHexBox" Style="{StaticResource ModernTextBox}"
                                         IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"
                                         ToolTip="Пример: 05 02 01 01"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Повтор запроса (мс)" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ScalePollBox" Style="{StaticResource ModernTextBox}"
                                         IsEnabled="{Binding IsChecked, ElementName=ScaleEnabledCheck}"/>
                            </StackPanel>
                        </Grid>
                        <Button Grid.Row="3" Content="Проверить весы"
                                Style="{StaticResource SettingsFlatButton}"
                                Click="CheckScale_Click" HorizontalAlignment="Stretch"/>
                        <Border x:Name="ScaleAlert" Grid.Row="3" Style="{StaticResource AlertBlock}" Visibility="Collapsed" Margin="0,52,0,0">
                            <TextBlock x:Name="ScaleAlertText" TextWrapping="Wrap" FontSize="13"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ======================== Печать ======================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Печать" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Печать" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="Принтер чеков, режимы и параметры ESC/POS"
                                       FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Основные параметры" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ReceiptEnabledCheck" Content="Печатать чек после оплаты"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="LPT-порт или путь" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ReceiptLptBox" Style="{StaticResource ModernTextBox}"
                                                 TextChanged="ReceiptLptBox_TextChanged"/>
                                        <TextBlock x:Name="StatusPortText" Text="○ Статус порта не проверен"
                                                   FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource BrushTextSoft}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Повторы печати при сбое" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="ReceiptRetryBox" Style="{StaticResource ModernTextBox}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Ширина ленты" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ReceiptPaperWidthCombo" Style="{DynamicResource TouchComboBox}"
                                                  SelectionChanged="ReceiptPaperWidthCombo_SelectionChanged">
                                            <ComboBoxItem Content="58 мм (32 симв., 384 точки)" Tag="58"/>
                                            <ComboBoxItem Content="80 мм (48 симв., 576 точек)" Tag="80"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Ширина графики (точки)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="GraphicWidthBox" Text="384" Style="{StaticResource ModernTextBox}" IsReadOnly="True"
                                                 ToolTip="Задаётся автоматически по ширине ленты: 384 (58 мм) или 576 (80 мм)"/>
                                    </StackPanel>
                                </Grid>
                                <Button x:Name="BtnPhysicalPrint"
                                        Content="🖨️  Печать в сам порт"
                                        Style="{StaticResource SettingsFlatButton}"
                                        Background="#FFD600"
                                        Foreground="#111827"
                                        FontWeight="SemiBold"
                                        Click="BtnPhysicalPrint_Click"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Stretch"
                                        Height="44"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Режим печати" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="TextModeRadio" Content="Текстовый (ESC/POS)"
                                                 GroupName="PrintMode" Style="{StaticResource DatePill}"
                                                 Margin="0,0,-1,0"
                                                 IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
                                    <RadioButton x:Name="GraphicModeRadio" Content="Графический чек"
                                                 GroupName="PrintMode" Style="{StaticResource DatePill}"
                                                 IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabledCheck}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}"
                                Visibility="{Binding IsChecked, ElementName=TextModeRadio, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="ESC/POS" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="Кодировка текста" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ReceiptEncCombo" Style="{DynamicResource TouchComboBox}">
                                            <ComboBoxItem Content="cp866 — кириллица DOS/OEM" Tag="cp866"/>
                                            <ComboBoxItem Content="cp1251 / windows-1251" Tag="cp1251"/>
                                            <ComboBoxItem Content="wpc1251 (слот 46)" Tag="wpc1251"/>
                                            <ComboBoxItem Content="iso-8859-5 (Кириллица ISO)" Tag="iso-8859-5"/>
                                            <ComboBoxItem Content="koi8-r (Unix-кодировка)" Tag="koi8-r"/>
                                            <ComboBoxItem Content="utf-8 (Юникод)" Tag="utf-8"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,8">
                                        <TextBlock Text="Таблица ESC t" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="ReceiptTableCombo" Style="{DynamicResource TouchComboBox}">
                                            <ComboBoxItem Content="Авто" Tag=""/>
                                            <ComboBoxItem Content="17 — CP866 / OEM" Tag="17"/>
                                            <ComboBoxItem Content="46 — CP1251 / WPC1251" Tag="46"/>
                                            <ComboBoxItem Content="73" Tag="73"/>
                                            <ComboBoxItem Content="26 — ISO 8859-5" Tag="26"/>
                                            <ComboBoxItem Content="53 — KOI8-R" Tag="53"/>
                                            <ComboBoxItem Content="0 — UTF-8 (редко)" Tag="0"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="ESC R (0–255)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ReceiptEscRBox" Style="{StaticResource ModernTextBox}" MaxWidth="280" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button Content="👁  Предпросмотр текстового чека"
                                        Style="{StaticResource SettingsFlatButton}"
                                        Click="TestTextPrint_Click" Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}"
                                Visibility="{Binding IsChecked, ElementName=GraphicModeRadio, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Графический чек" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                                <CheckBox x:Name="GraphicReceiptEnabledCheck" Content="Включить графический чек"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Шрифт" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox x:Name="GraphicFontCombo" Style="{DynamicResource TouchComboBox}">
                                            <ComboBoxItem Content="Consolas (рекомендуется)" Tag="Consolas"/>
                                            <ComboBoxItem Content="Lucida Console" Tag="Lucida Console"/>
                                            <ComboBoxItem Content="Courier New" Tag="Courier New"/>
                                            <ComboBoxItem Content="Arial" Tag="Arial"/>
                                            <ComboBoxItem Content="Tahoma" Tag="Tahoma"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Размер шрифта (пиксели)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="GraphicFontSizeCombo" Style="{DynamicResource TouchComboBox}" MaxWidth="200" HorizontalAlignment="Left"
                                              ToolTip="Выберите размер шрифта для чека">
                                        <ComboBoxItem Content="6" Tag="6"/>
                                        <ComboBoxItem Content="8" Tag="8"/>
                                        <ComboBoxItem Content="10" Tag="10"/>
                                        <ComboBoxItem Content="12" Tag="12"/>
                                        <ComboBoxItem Content="14" Tag="14"/>
                                        <ComboBoxItem Content="16" Tag="16"/>
                                        <ComboBoxItem Content="18" Tag="18"/>
                                        <ComboBoxItem Content="20" Tag="20"/>
                                        <ComboBoxItem Content="22" Tag="22"/>
                                        <ComboBoxItem Content="24" Tag="24"/>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Text="Элементы чека" Style="{StaticResource FieldLabel}"/>
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <CheckBox x:Name="ShowStoreNameCheck" Content="Название магазина" Style="{StaticResource ToggleSwitch}" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="ShowAddressCheck" Content="Адрес" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ShowReceiptNumberCheck" Content="Номер чека" Style="{StaticResource ToggleSwitch}" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="ShowDateCheck" Content="Дата и время" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ShowItemsCheck" Content="Список товаров" Style="{StaticResource ToggleSwitch}" Margin="0,0,8,4"/>
                                    <CheckBox x:Name="ShowTotalCheck" Content="Итог (сумма)" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="ShowQrCodeCheck" Content="QR-код" Style="{StaticResource ToggleSwitch}" Margin="0,0,8,0"/>
                                </UniformGrid>
                                <TextBlock Text="QR-код" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="📷  Загрузить QR-код" Style="{StaticResource SettingsFlatButton}"
                                            Click="LoadGraphicQrCode_Click" Height="36" Margin="0,0,8,0"/>
                                    <Button Content="🗑️  Удалить" Style="{StaticResource SettingsFlatButton}"
                                            Click="DeleteGraphicQrCode_Click" Height="36"/>
                                </StackPanel>
                                <TextBlock x:Name="GraphicQrStatusText" Text="QR-код не загружен" FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,8"/>
                                <Button Content="👁  Предпросмотр графического чека" Style="{StaticResource SettingsFlatButton}"
                                        Click="TestGraphicPrint_Click" HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <TextBox x:Name="StatusText" Style="{StaticResource ModernTextBox}" Height="72" Margin="0,4,0,0"
                                 IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                                 Foreground="{DynamicResource BrushText}" Background="{DynamicResource BrushInputAlt}"/>

                        <Border x:Name="PrintErrorPanel" Visibility="Collapsed" Margin="0,8,0,0"
                                CornerRadius="8" Padding="10" Background="#FEF2F2" BorderBrush="#DC2626" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Подробности ошибки печати" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtPrintErrorDetails" IsReadOnly="True" TextWrapping="Wrap"
                                         FontFamily="Consolas" FontSize="12" MaxHeight="160"
                                         VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                         Background="Transparent" Foreground="#7F1D1D"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </TabItem>

        <!-- ======================== Экран ======================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Экран" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Экран" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="Отображение интерфейса и поведение кассы"
                                       FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1">
                    <Border Style="{StaticResource SettingsCard}">
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="FullscreenCheck" Content="Полноэкранный режим" Style="{StaticResource ToggleSwitch}" Margin="0,0,12,8"/>
                            <CheckBox x:Name="AutostartCheck" Content="Запускать с Windows" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="AutoTouchKeyboardCheck" Content="Авто‑показ клавиатуры" Style="{StaticResource ToggleSwitch}" Margin="0,0,12,0"/>
                        </UniformGrid>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Название магазина в чеке" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="StoreNameBox" Style="{StaticResource ModernTextBox}" MaxWidth="420" HorizontalAlignment="Left"
                                     ToolTip="Отображается в верхней части чека"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Адрес магазина" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="StoreAddressBox" Style="{StaticResource ModernTextBox}" MaxWidth="420" HorizontalAlignment="Left"
                                     ToolTip="Печатается в чеке, если включён пункт «Адрес» и поле не пустое"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Данные в чеке" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ShowInnCheck" Content="ИНН" Style="{StaticResource ToggleSwitch}"
                                      ToolTip="Печатать ИНН компании в шапке чека"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Text="Добавление в чек" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="DoubleClickToCartRadio" Content="Двойной клик"
                                             Style="{StaticResource DatePill}" Margin="0,0,-1,0"
                                             Checked="ClickToCartMode_Changed"/>
                                <RadioButton x:Name="SingleClickToCartRadio" Content="Один клик"
                                             Style="{StaticResource DatePill}"
                                             Checked="ClickToCartMode_Changed"/>
                            </StackPanel>
                            <CheckBox x:Name="ResetManualAddQtyCheck"
                                      Content="Сбрасывать количество после добавления"
                                      Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ======================== Обновления ======================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Обновления" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок страницы -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Обновления" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="Проверка и установка новых версий кассы"
                               FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Контейнер для карточек (Вместо двух Border, наложенных друг на друга) -->
                <StackPanel Grid.Row="1">

                    <!-- Карточка 1: Обновления -->
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock x:Name="AppVersionText" FontSize="14" Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,12"/>

                            <!-- Отступ снизу 16px, чтобы кнопка не слипалась с прогресс-баром -->
                            <Button Content="Проверить обновления" Style="{StaticResource SettingsFlatButton}"
                            Click="CheckUpdate_Click" HorizontalAlignment="Left" MinWidth="220" Margin="0,0,0,16"/>

                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,0,0,4"
                                 Visibility="Collapsed" IsIndeterminate="False" Minimum="0" Maximum="100"/>

                            <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{DynamicResource BrushTextSoft}"
                               Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Карточка 2: Диагностика (Отступ сверху 16px, чтобы разъединить с первой карточкой) -->
                    <Border Style="{StaticResource SettingsCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Диагностика" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" Margin="0,0,0,6"/>

                            <TextBlock Text="Техническая информация каталога (для администратора и разработчика)."
                               FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,0,0,12"/>

                            <TextBlock x:Name="CatalogDiagnosticsText"
                               FontSize="11"
                               Foreground="{DynamicResource BrushTextSoft}"
                               TextWrapping="Wrap"
                               FontFamily="Consolas" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ======================== Операции ======================== -->
        <TabItem>
            <TabItem.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Операции" VerticalAlignment="Center"/>
                </StackPanel>
            </TabItem.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource BrushAccentSoft}" Margin="0,0,12,0">
                            <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Операции" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource BrushText}"/>
                            <TextBlock Text="QR-коды и логотипы банков для безналичной оплаты"
                                       FontSize="12" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="BankQrItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushCatalogTileBg}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                        BorderBrush="{DynamicResource BrushCatalogTileBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8"
                                                Background="{DynamicResource BrushInputAlt}" Margin="0,0,12,0">
                                            <Image Source="{Binding LogoPath}" Stretch="Uniform" Margin="6"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BankName}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushText}"/>
                                            <Image Source="{Binding QrCodePath, TargetNullValue={x:Null}}"
                                                   Width="64" Height="64" Stretch="Uniform" Margin="0,6,0,0"
                                                   Visibility="{Binding HasQrCode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Загрузить QR"
                                                Style="{StaticResource SettingsFlatButton}"
                                                Height="34" FontSize="13" Padding="12,4"
                                                Tag="{Binding}" Click="LoadQrCode_Click"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
