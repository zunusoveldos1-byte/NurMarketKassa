<Window x:Class="NurMarketKassa.Views.CashHistoryDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="История контроля наличности"
	Height="500"
	Width="700"
	WindowStartupLocation="CenterOwner"
	Style="{DynamicResource AppWindow}"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <Grid
		Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="*" />
            <RowDefinition
				Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
			Text="История открытий кассы"
			FontWeight="SemiBold"
			Foreground="{DynamicResource BrushText}"
			Margin="0,0,0,12" />
        <DataGrid
			x:Name="HistoryGrid"
			Grid.Row="1"
			AutoGenerateColumns="False"
			IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn
					Header="Дата и время"
					Width="160"
					Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" />
                <DataGridTextColumn
					Header="Сумма, сом"
					Width="120"
					Binding="{Binding Amount, StringFormat={}{0:N2}}" />
                <DataGridTextColumn
					Header="Пользователь"
					Width="*"
					Binding="{Binding UserId}" />
            </DataGrid.Columns>
        </DataGrid>
        <Button
			Grid.Row="2"
			Content="Закрыть"
			IsCancel="True"
			HorizontalAlignment="Right"
			Margin="0,12,0,0"
			Width="100"
			Height="32"
			Background="{DynamicResource BrushPanelSoft}"
			Foreground="{DynamicResource BrushText}"
			BorderBrush="{DynamicResource BrushBorderStrong}"
			BorderThickness="1" />
    </Grid>
</Window>
