<UserControl x:Class="NurMarketKassa.Views.ShiftHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:NurMarketKassa.Models;assembly=NurMarketKassa.Infrastructure"
             xmlns:wpfmodels="clr-namespace:NurMarketKassa.Models"
             xmlns:vm="clr-namespace:NurMarketKassa.ViewModels"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ShiftHistoryResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="История смен" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource BrushText}"/>
                <TextBlock Text="Список всех кассовых смен и их статусы"
                           FontSize="13" Foreground="{DynamicResource BrushTextSoft}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+  Новая операция" VerticalAlignment="Center"
                    Style="{DynamicResource TouchPrimaryButton}" Padding="18,10"
                    Command="{Binding NewOperationCommand}"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ShiftSettingsCard}" Padding="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Список кассовых смен" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushText}" Margin="16,14,16,0"/>
                    <DataGrid Grid.Row="1" Style="{StaticResource ShiftModernDataGrid}"
                              ItemsSource="{Binding PagedShifts}"
                              SelectedItem="{Binding SelectedShift, Mode=TwoWay}"
                              Margin="0,8,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер смены" Binding="{Binding ShiftNumber}" Width="*"/>
                            <DataGridTextColumn Header="Открыта" Binding="{Binding OpenedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="*"/>
                            <DataGridTextColumn Header="Закрыта" Binding="{Binding ClosedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="*"/>
                            <DataGridTextColumn Header="Кассир" Binding="{Binding Cashier}" Width="*"/>
                            <DataGridTemplateColumn Header="Статус" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ShiftModel}">
                                        <Border Height="24" CornerRadius="12" Padding="10,0"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#DC2626"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Fill" Value="#059669"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="#059669"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Выручка" Binding="{Binding Revenue, StringFormat='{}{0:N2} сом'}" Width="*"/>
                            <DataGridTemplateColumn Header="Действия" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type models:ShiftModel}">
                                        <Button Content="&#xE712;" Style="{StaticResource ShiftActionButton}"
                                                Command="{Binding DataContext.OpenShiftActionsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid Grid.Column="2" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ShiftSettingsCard}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Общий план по кассе" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,12"/>
                        <Grid Grid.Row="1" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Баланс на начало смены" Style="{StaticResource ShiftFieldLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OpeningBalanceText}" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Text="+ Внесено" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DepositedTotalText}" FontWeight="SemiBold"
                                       Foreground="#059669" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Text="- Изъято" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WithdrawnTotalText}" FontWeight="SemiBold"
                                       Foreground="#B91C1C" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="3" Text="Ожидаемый баланс" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExpectedBalanceText}" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="4" Text="Выручка" Style="{StaticResource ShiftFieldLabel}" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding RevenueTotalText}" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="5" Text="Фактический баланс" FontSize="13"
                                       Foreground="{DynamicResource BrushTextSoft}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ActualBalanceText}"
                                       FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/>

                            <Border Grid.Row="6" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="12,10"
                                    CornerRadius="8" Background="{DynamicResource BrushAccentSoft}">
                                <Grid>
                                    <TextBlock Text="Разница (факт − ожидаемый)" VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushTextSoft}" FontSize="12"/>
                                    <TextBlock Text="{Binding DifferenceText}" HorizontalAlignment="Right"
                                               FontWeight="Bold" FontSize="16"
                                               Foreground="{DynamicResource BrushAccentStrong}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource ShiftSettingsCard}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Последние операции" FontWeight="SemiBold" FontSize="15"
                                   Foreground="{DynamicResource BrushText}" Margin="0,0,0,10"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding RecentOperations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type wpfmodels:CashOperationModel}">
                                        <Border Style="{StaticResource ShiftOperationCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="32" Height="32" CornerRadius="16"
                                                        Background="{DynamicResource BrushPanel}" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="{Binding IconBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="13"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}"
                                                               FontSize="11" Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Cashier}" FontSize="11"
                                                               Foreground="{DynamicResource BrushTextSoft}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding AmountDisplay}" FontWeight="Bold"
                                                           Foreground="{Binding AmountBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="0,12,0,4" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Content="&#xE72B;" Style="{StaticResource ShiftPagerNavButton}"
                        Command="{Binding PreviousPageCommand}" ToolTip="Назад"/>
                <ItemsControl ItemsSource="{Binding ShiftPagerEntries}" Margin="4,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PagerEntry}">
                            <Button Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ShiftPagerButton}">
                                        <Setter Property="Content" Value="{Binding Display}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:PagerEntryKind.Ellipsis}">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentStrong}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Button.Command>
                                    <Binding Path="DataContext.GoToPageCommand" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                </Button.Command>
                                <Button.CommandParameter>
                                    <Binding Path="PageNumber"/>
                                </Button.CommandParameter>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="&#xE72A;" Style="{StaticResource ShiftPagerNavButton}"
                        Command="{Binding NextPageCommand}" ToolTip="Вперёд"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
