<Window x:Class="NurMarketKassa.Views.WarehouseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NurMarketKassa.Converters"
        Title="Склад — ревизия и списание"
        Height="720"
        Width="1100"
        MinHeight="500"
        MinWidth="800"
        Style="{DynamicResource AppWindow}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="WarehouseGrid" TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{DynamicResource BrushPanelSoft}" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource BrushInputAlt}" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
                <Setter Property="RowHeight" Value="40" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BrushBorder}" />
                <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
                <Setter Property="IsReadOnly" Value="False" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
            </Style>
            <Style x:Key="FormLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextSoft}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <TextBlock Text="Управление складом" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource BrushText}" VerticalAlignment="Center" DockPanel.Dock="Left" />
            <Button DockPanel.Dock="Right" Content="Закрыть" Style="{DynamicResource TouchSecondaryButton}"
                    Padding="14,8" Margin="12,0,0,0" Click="CloseButton_Click" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{DynamicResource BrushTextSoft}"
                       Text="Сканируйте штрих-код для быстрого ввода" />
        </DockPanel>

        <TabControl x:Name="WarehouseTabs" Grid.Row="1">
            <TabItem Header="Ревизия (Инвентаризация)">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="RevisionGrid"
                              Style="{StaticResource WarehouseGrid}"
                              ItemsSource="{Binding RevisionLines}"
                              SelectedItem="{Binding FocusedRevisionLine, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Штрих-код" Width="140" Binding="{Binding Barcode}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Наименование" Width="*" Binding="{Binding ProductName}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ожидаемый остаток" Width="150"
                                                Binding="{Binding ExpectedQty, StringFormat='{}{0:0.###}'}" IsReadOnly="True" />
                            <DataGridTextColumn Header="Фактический остаток" Width="150"
                                                Binding="{Binding ActualQty, StringFormat='{}{0:0.###}', UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Разница" Width="110"
                                                Binding="{Binding Difference, StringFormat='{}{0:0.###}'}" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Button Grid.Row="1" Content="Зафиксировать ревизию"
                            Style="{DynamicResource TouchPrimaryButton}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" Padding="18,10"
                            Command="{Binding CommitRevisionCommand}" />
                </Grid>
            </TabItem>
            <TabItem Header="Списание товара">
                <Grid Margin="8" MaxWidth="520" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Товар" />
                        <TextBox Style="{DynamicResource TouchTextBox}" IsReadOnly="True"
                                 Text="{Binding WriteOffProductName, Mode=OneWay}" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"
                                   Text="{Binding WriteOffBarcode, StringFormat='Штрих-код: {0}'}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Количество" />
                        <TextBox x:Name="WriteOffQuantityBox" Style="{DynamicResource TouchTextBox}"
                                 Text="{Binding WriteOffQuantity, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="0,0,0,16">
                        <TextBlock Style="{StaticResource FormLabel}" Text="Причина списания" />
                        <ComboBox ItemsSource="{Binding WriteOffReasonOptions}"
                                  SelectedItem="{Binding WriteOffReason}"
                                  Style="{DynamicResource TouchComboBox}" />
                    </StackPanel>
                    <Button Grid.Row="3" Content="Списать товар"
                            Style="{DynamicResource TouchPrimaryButton}"
                            HorizontalAlignment="Left" Padding="18,10"
                            Command="{Binding WriteOffCommand}" />
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.RowSpan="2" Background="#40000000" Panel.ZIndex="10"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Сохранение..." Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,0,12" />
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"
                             Foreground="{DynamicResource BrushAccent}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
