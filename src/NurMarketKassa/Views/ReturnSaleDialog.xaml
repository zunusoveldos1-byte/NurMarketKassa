<Window x:Class="NurMarketKassa.Views.ReturnSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Возврат по чеку"
        Height="760"
        Width="780"
        MinHeight="560"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">
    <Border Style="{StaticResource ElevatedCardBorder}" Margin="14" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Возврат товаров по чеку"
                       Style="{StaticResource DialogTitleText}"/>
            <TextBlock Grid.Row="1"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Сверху — список чеков. Выберите чек кнопкой «Выбрать». Ниже появится состав чека: отметьте товары и «Вернуть выбранные» с одной причиной или оформите «Вернуть весь чек» без выбора позиций."
                       Style="{StaticResource DialogLabelText}"/>

            <!-- Основной блок: верх = чеки, низ = содержимое -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition MinHeight="160" Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition MinHeight="220" Height="3*"/>
                </Grid.RowDefinitions>

                <!-- Шаг 1 -->
                <TextBlock Text="1. Чеки продаж"
                           Style="{StaticResource SectionTitleText}"/>
                <DockPanel Grid.Row="1"
                           Margin="0,6,0,0"
                           LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,0,8">
                        <Button x:Name="SalesLoadButton"
                                Content="Обновить"
                                Click="RefreshSales_Click"
                                Style="{StaticResource TouchSecondaryButton}"
                                MinWidth="110"/>
                        <Button x:Name="MoreSalesButton"
                                Content="Ещё"
                                Margin="8,0,0,0"
                                Click="MoreSales_Click"
                                Style="{StaticResource TouchGhostButton}"
                                MinWidth="90"/>
                    </StackPanel>
                    <Border Style="{StaticResource ModernSectionBorder}"
                            CornerRadius="10"
                            Padding="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Padding="8,8,8,8">
                            <ItemsControl ItemsSource="{Binding Sales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModernInfoPanel}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Summary}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource BrushText}"/>
                                                <Button Grid.Column="1"
                                                        Content="Выбрать"
                                                        Tag="{Binding SaleId}"
                                                        Click="SelectSale_Click"
                                                        Style="{StaticResource TouchPrimaryButton}"
                                                        MinWidth="100"
                                                        Padding="10,8"
                                                        Margin="10,0,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- Шаг 2 заголовок + сводка по выбранному чеку -->
                <TextBlock Grid.Row="2"
                           Margin="0,14,0,4"
                           Text="2. Содержимое выбранного чека"
                           Style="{StaticResource SectionTitleText}"/>

                <Border x:Name="SelectedChequeBar"
                        Grid.Row="3"
                        Margin="0,0,0,8"
                        Style="{StaticResource ModernInfoPanel}"
                        CornerRadius="6"
                        Padding="10,8"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SelectedSaleText"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="12"/>
                </Border>

                <!-- Позиции и действия -->
                <Border Grid.Row="4"
                        Style="{StaticResource ModernSectionBorder}"
                        CornerRadius="10"
                        Padding="0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top"
                                    Margin="10,10,10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="Все"
                                        Click="SelectAllReturnable_Click"
                                        Style="{StaticResource TouchGhostButton}"
                                        MinWidth="72"
                                        Padding="10,8"
                                        ToolTip="Отметить все доступные к возврату позиции"/>
                                <Button Grid.Column="1"
                                        Content="Снять"
                                        Margin="8,0,0,0"
                                        Click="ClearReturnSelection_Click"
                                        Style="{StaticResource TouchGhostButton}"
                                        MinWidth="72"
                                        Padding="10,8"
                                        ToolTip="Снять отметки"/>
                                <Button Grid.Column="3"
                                        x:Name="ReturnSelectedButton"
                                        Content="Вернуть выбранные"
                                        Margin="0,0,8,0"
                                        Click="ReturnSelected_Click"
                                        Style="{StaticResource TouchPrimaryButton}"
                                        MinWidth="180"
                                        Padding="12,10"/>
                                <Button Grid.Column="4"
                                        x:Name="ReturnWholeReceiptButton"
                                        Content="Вернуть весь чек"
                                        Click="ReturnWholeReceipt_Click"
                                        Style="{StaticResource TouchSecondaryButton}"
                                        MinWidth="170"
                                        Padding="12,10"
                                        ToolTip="Полный возврат всего чека одной операцией (причина указывается отдельно)"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="LinesPlaceholder"
                                   DockPanel.Dock="Top"
                                   Margin="12,0,12,8"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextSoft}"
                                   FontSize="13"
                                   Visibility="Visible"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,0,8,10">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModernInfoPanel}"
                                                CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanReturn}"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource BrushText}"/>
                                                    <TextBlock Text="{Binding SubLine}"
                                                               Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrushTextSoft}"/>
                                                    <TextBlock Text="{Binding LineSumText}"
                                                               Margin="0,2,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrushTextMuted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="3"
                       Margin="0,10,0,0"
                       Style="{StaticResource DialogErrorText}"/>

            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                <Expander Header="Ввести ID продажи вручную"
                          Style="{StaticResource PosExpander}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBox x:Name="SaleIdBox"
                                 Style="{StaticResource TouchTextBox}"
                                 MinHeight="40"/>
                        <Button Content="Загрузить чек"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                MinWidth="160"
                                Click="LoadById_Click"
                                Style="{StaticResource TouchSecondaryButton}"/>
                    </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Закрыть"
                            IsCancel="True"
                            Click="Close_Click"
                            Style="{StaticResource TouchGhostButton}"
                            MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
