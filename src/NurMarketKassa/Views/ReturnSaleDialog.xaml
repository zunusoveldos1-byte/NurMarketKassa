<Window
	x:Class="NurMarketKassa.Views.ReturnSaleDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Возврат по чеку"
	Height="820"
	Width="850"
	MinHeight="600"
	MinWidth="680"
	WindowStartupLocation="CenterOwner"
	Style="{StaticResource AppWindow}"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter
				x:Key="BoolToVis" />
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border
		Style="{StaticResource ElevatedCardBorder}"
		Margin="14"
		CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="*" />
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
				Text="Возврат товаров по чеку"
				Style="{StaticResource DialogTitleText}" />
            <TextBlock
				Grid.Row="1"
				Margin="0,8,0,0"
				TextWrapping="Wrap"
				Text="Сверху — список чеков. Выберите чек кнопкой «Выбрать». Ниже появится состав чека: отметьте товары и «Вернуть выбранные» с общей причиной или оформите «Вернуть весь чек»."
				Style="{StaticResource DialogLabelText}" />
            <Grid
				Row="2"
				Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition
						Height="Auto" />
                    <RowDefinition
						MinHeight="200"
						Height="3*" />
                    <RowDefinition
						Height="Auto" />
                    <RowDefinition
						Height="Auto" />
                    <RowDefinition
						MinHeight="200"
						Height="2*" />
                </Grid.RowDefinitions>
                <TextBlock
					Text="1. Чеки продаж"
					Style="{StaticResource SectionTitleText}" />
                <DockPanel
					Grid.Row="1"
					Margin="0,6,0,0"
					LastChildFill="True">
                    <StackPanel
						DockPanel.Dock="Top"
						Orientation="Horizontal"
						Margin="0,0,0,8">
                        <TextBox
							x:Name="SearchReceiptBox"
							Width="150"
							Style="{StaticResource TouchTextBox}"
							Margin="0,0,8,0"
							TextChanged="SearchReceiptBox_TextChanged" />
                        <Button
							Content="Обновить"
							Style="{StaticResource TouchSecondaryButton}"
							MinWidth="110"
							Click="RefreshSales_Click" />
                        <Button
							x:Name="MoreSalesButton"
							Content="Ещё"
							Margin="8,0,0,0"
							Style="{StaticResource TouchGhostButton}"
							MinWidth="90"
							Click="MoreSales_Click" />
                    </StackPanel>
                    <Border
						Style="{StaticResource ModernSectionBorder}"
						CornerRadius="10"
						Padding="0">
                        <Grid>
                            <ScrollViewer
								VerticalScrollBarVisibility="Auto"
								PanningMode="Both"
								Padding="8,8,8,8">
                                <ItemsControl
									ItemsSource="{Binding SalesView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
												Style="{StaticResource ModernInfoPanel}"
												CornerRadius="8"
												Padding="14,10"
												Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition
															Width="*" />
                                                        <ColumnDefinition
															Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
														TextWrapping="Wrap"
														MaxHeight="60"
														TextTrimming="CharacterEllipsis"
														VerticalAlignment="Center"
														Foreground="{StaticResource BrushText}"
														Text="{Binding Summary}" />
                                                    <Button
														Grid.Column="1"
														Content="Выбрать"
														Style="{StaticResource TouchPrimaryButton}"
														MinWidth="100"
														Padding="10,8"
														Margin="10,0,0,0"
														Tag="{Binding SaleId}"
														Click="SelectSale_Click" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ProgressBar
								IsIndeterminate="True"
								Height="4"
								VerticalAlignment="Top"
								Visibility="{Binding IsBusy, Converter='{StaticResource BoolToVis}', FallbackValue=Collapsed}" />
                        </Grid>
                    </Border>
                </DockPanel>
                <TextBlock
					Grid.Row="2"
					Margin="0,14,0,4"
					Text="2. Содержимое выбранного чека"
					Style="{StaticResource SectionTitleText}" />
                <Border
					x:Name="SelectedChequeBar"
					Grid.Row="3"
					Margin="0,0,0,8"
					Style="{StaticResource ModernInfoPanel}"
					CornerRadius="6"
					Padding="10,8"
					Visibility="Collapsed">
                    <TextBlock
						x:Name="SelectedSaleText"
						TextWrapping="Wrap"
						Foreground="{StaticResource BrushTextMuted}"
						FontSize="12" />
                </Border>
                <Border
					Grid.Row="4"
					Style="{StaticResource ModernSectionBorder}"
					CornerRadius="10"
					Padding="0">
                    <DockPanel
						LastChildFill="True">
                        <StackPanel
							DockPanel.Dock="Top"
							Margin="10,10,10,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
										Width="Auto" />
                                    <ColumnDefinition
										Width="Auto" />
                                    <ColumnDefinition
										Width="*" />
                                    <ColumnDefinition
										Width="Auto" />
                                    <ColumnDefinition
										Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
									Grid.Column="0"
									Content="Все"
									Style="{StaticResource TouchGhostButton}"
									MinWidth="72"
									Padding="10,8"
									ToolTip="Отметить все доступные к возврату позиции"
									Click="SelectAllReturnable_Click" />
                                <Button
									Grid.Column="1"
									Content="Снять"
									Margin="8,0,0,0"
									Style="{StaticResource TouchGhostButton}"
									MinWidth="72"
									Padding="10,8"
									ToolTip="Снять отметки"
									Click="ClearReturnSelection_Click" />
                                <Button
									x:Name="ReturnSelectedButton"
									Grid.Column="3"
									Content="Вернуть выбранные"
									Margin="0,0,8,0"
									Style="{StaticResource TouchPrimaryButton}"
									MinWidth="180"
									Padding="12,10"
									Click="ReturnSelected_Click" />
                                <Button
									x:Name="ReturnWholeReceiptButton"
									Grid.Column="4"
									Content="Вернуть весь чек"
									Style="{StaticResource TouchSecondaryButton}"
									MinWidth="170"
									Padding="12,10"
									ToolTip="Полный возврат всего чека одной операцией (причина указывается отдельно)"
									Click="ReturnWholeReceipt_Click" />
                            </Grid>
                        </StackPanel>
                        <TextBlock
							x:Name="LinesPlaceholder"
							DockPanel.Dock="Top"
							Margin="12,0,12,8"
							TextWrapping="Wrap"
							HorizontalAlignment="Center"
							TextAlignment="Center"
							Foreground="{StaticResource BrushTextSoft}"
							FontSize="13"
							Visibility="Visible" />
                        <ScrollViewer
							VerticalScrollBarVisibility="Auto"
							HorizontalScrollBarVisibility="Disabled"
							Padding="8,0,8,10">
                            <ItemsControl
								ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
											CornerRadius="8"
											Padding="10,8"
											Margin="0,0,0,6">
                                            <FrameworkElement.Style>
                                                <Style
													TargetType="{x:Type Border}">
                                                    <Setter
														Property="Background"
														Value="{StaticResource BrushWindowAlt}" />
                                                    <Style.Triggers>
                                                        <DataTrigger
															Value="False"
															Binding="{Binding CanReturn}">
                                                            <Setter
																Property="Background"
																Value="#E8F5E9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </FrameworkElement.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition
														Width="Auto" />
                                                    <ColumnDefinition
														Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox
													Grid.Column="0"
													VerticalAlignment="Center"
													Margin="0,0,12,0"
													IsChecked="{Binding IsSelected, Mode=TwoWay}"
													IsEnabled="{Binding CanReturn}" />
                                                <StackPanel
													Grid.Column="1">
                                                    <TextBlock
														FontWeight="SemiBold"
														TextWrapping="Wrap"
														Foreground="{StaticResource BrushText}"
														Text="{Binding Title}" />
                                                    <TextBlock
														Margin="0,4,0,0"
														FontSize="12"
														Foreground="{StaticResource BrushTextSoft}"
														Text="{Binding SubLine}" />
                                                    <TextBlock
														Margin="0,2,0,0"
														FontSize="12"
														Foreground="{StaticResource BrushTextMuted}"
														Text="{Binding LineSumText}" />
                                                    <TextBlock
														Margin="0,2,0,0"
														FontSize="11"
														Foreground="#FF808080"
														Text="{Binding RefundReason, StringFormat='Причина: {0}'}"
														Visibility="{Binding RefundReason, Converter='{StaticResource BoolToVis}', FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
            <TextBlock
				x:Name="ErrorText"
				Grid.Row="3"
				Margin="0,10,0,0"
				Style="{StaticResource DialogErrorText}" />
            <StackPanel
				Grid.Row="4"
				Margin="0,12,0,0">
                <Expander
					Header="Ввести ID продажи вручную"
					Style="{StaticResource PosExpander}">
                    <StackPanel
						Margin="0,10,0,0">
                        <TextBox
							x:Name="SaleIdBox"
							Style="{StaticResource TouchTextBox}"
							MinHeight="40" />
                        <Button
							Content="Загрузить чек"
							Margin="0,10,0,0"
							HorizontalAlignment="Left"
							MinWidth="160"
							Style="{StaticResource TouchSecondaryButton}"
							Click="LoadById_Click" />
                    </StackPanel>
                </Expander>
                <StackPanel
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Margin="0,14,0,0">
                    <Button
						Content="Закрыть"
						IsCancel="True"
						Style="{StaticResource TouchGhostButton}"
						MinWidth="110"
						Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
