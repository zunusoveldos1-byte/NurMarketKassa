<Window x:Class="NurMarketKassa.Views.ReturnSaleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Возврат по чеку"
        Height="820" Width="850"
        MinHeight="600" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}"
        xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style TargetType="GridViewColumnHeader">
                <EventSetter Event="Click" Handler="Header_Click"/>
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="Background" Value="{StaticResource BrushWindowAlt}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewColumnHeader">
                            <Border Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                                <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontWeight="SemiBold"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <Border Style="{StaticResource ElevatedCardBorder}" Margin="14" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- заголовок и подсказка -->
                <RowDefinition Height="*"/>
                <!-- адаптивный контент (блоки 1 и 2) -->
                <RowDefinition Height="Auto"/>
                <!-- ошибка -->
                <RowDefinition Height="Auto"/>
                <!-- подвал -->
            </Grid.RowDefinitions>

            <!-- Заголовок и подсказка -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="Возврат товаров по чеку"
                           Style="{StaticResource DialogTitleText}" />
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Сверху — список чеков. Выберите чек кнопкой «Выбрать». Ниже появится состав чека: отметьте товары и «Вернуть выбранные» с общей причиной или оформите «Вернуть весь чек»."
                           Style="{StaticResource DialogLabelText}" />
            </StackPanel>

            <!-- Адаптивный контейнер с двумя блоками -->
            <Grid x:Name="ContentGrid" Grid.Row="1" Margin="0,12,0,0">
                <!-- Блок 1: Чеки продаж -->
                <Grid x:Name="ChecksBlock">
                    <DockPanel Margin="0,6,0,0" LastChildFill="True">
                        <TextBlock Text="1. Чеки продаж"
                   DockPanel.Dock="Top"
                   Style="{StaticResource SectionTitleText}" />
                        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,6,0,8">
                            <TextBox x:Name="SearchReceiptBox" Width="150"
                     Style="{StaticResource TouchTextBox}"
                     Margin="0,0,8,0"
                     TextChanged="SearchReceiptBox_TextChanged" />
                            <Button Content="Обновить"
                    Style="{StaticResource TouchSecondaryButton}"
                    MinWidth="110"
                    Click="RefreshSales_Click" />
                            <Button x:Name="MoreSalesButton" Content="Ещё"
                    Margin="8,0,0,0"
                    Style="{StaticResource TouchGhostButton}"
                    MinWidth="90"
                    Click="MoreSales_Click" />
                        </StackPanel>
                        <Border Style="{StaticResource ModernSectionBorder}"
                CornerRadius="10" Padding="0">
                            <Grid>
                                <ListView x:Name="SalesListView"
                          ItemsSource="{Binding SalesView}"
                          SelectionMode="Single"
                          BorderThickness="0"
                          Background="Transparent"
                          Loaded="SalesListView_Loaded"
                          SizeChanged="SalesListView_SizeChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Номер чека"
                                            x:Name="ColSaleId">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SaleId}"
                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Дата"
                                            x:Name="ColSaleDate">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding SaleDate, StringFormat='dd.MM.yyyy HH:mm'}"
                                                   VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="Сумма"
                                            x:Name="ColTotalAmount">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding TotalAmount, StringFormat='{}{0:F2}'}"/>
                                            <Run Text=" сом"/>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header=""
                                            Width="120">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Выбрать"
                                                Style="{StaticResource TouchPrimaryButton}"
                                                MinWidth="100"
                                                Padding="10,8,10,8"
                                                Tag="{Binding SaleId}"
                                                Click="SelectSale_Click" />
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                                <ProgressBar IsIndeterminate="True"
                             Height="4"
                             VerticalAlignment="Top"
                             Visibility="{Binding IsBusy, Converter='{StaticResource BoolToVis}', FallbackValue=Collapsed}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- Блок 2: Содержимое выбранного чека -->
                <Grid x:Name="DetailsBlock">
                    <DockPanel x:Name="DetailsPanel" LastChildFill="True">
                        <TextBlock Text="2. Содержимое выбранного чека"
                                   DockPanel.Dock="Top"
                                   Style="{StaticResource SectionTitleText}"
                                   Margin="0,0,0,4" />
                        <Border x:Name="SelectedChequeBar"
                                DockPanel.Dock="Top"
                                Margin="0,0,0,8"
                                Style="{StaticResource ModernInfoPanel}"
                                CornerRadius="6"
                                Padding="10,8"
                                Visibility="Collapsed">
                            <TextBlock x:Name="SelectedSaleText"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12" />
                        </Border>
                        <!-- Кнопки действий -->
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Все"
                                        Style="{StaticResource TouchGhostButton}"
                                        MinWidth="72" Padding="10,8,10,8"
                                        ToolTip="Отметить все доступные к возврату позиции"
                                        Click="SelectAllReturnable_Click" />
                                <Button Grid.Column="1" Content="Снять"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource TouchGhostButton}"
                                        MinWidth="72" Padding="10,8,10,8"
                                        ToolTip="Снять отметки"
                                        Click="ClearReturnSelection_Click" />
                                <Button x:Name="ReturnSelectedButton"
                                        Grid.Column="3"
                                        Content="Вернуть выбранные"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource TouchPrimaryButton}"
                                        MinWidth="180" Padding="12,10"
                                        Click="ReturnSelected_Click" />
                                <Button x:Name="ReturnWholeReceiptButton"
                                        Grid.Column="4"
                                        Content="Вернуть весь чек"
                                        Style="{StaticResource TouchSecondaryButton}"
                                        MinWidth="170" Padding="12,10"
                                        ToolTip="Полный возврат всего чека одной операцией (причина указывается отдельно)"
                                        Click="ReturnWholeReceipt_Click" />
                            </Grid>
                        </StackPanel>
                        <TextBlock x:Name="LinesPlaceholder"
                                   DockPanel.Dock="Top"
                                   Margin="0,4,0,8"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource BrushTextSoft}"
                                   FontSize="13"
                                   Visibility="Visible" />
                        <!-- Список позиций (заполняет оставшееся место) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8,0,8,10">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10,8"
                                                Margin="0,0,0,6">
                                            <FrameworkElement.Style>
                                                <Style TargetType="{x:Type Border}">
                                                    <Setter Property="Background"
                                                            Value="{StaticResource BrushWindowAlt}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="False"
                                                                     Binding="{Binding CanReturn}">
                                                            <Setter Property="Background"
                                                                    Value="#E8F5E9" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </FrameworkElement.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          Margin="0,0,12,0"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanReturn}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               Foreground="{StaticResource BrushText}"
                                                               Text="{Binding Title}" />
                                                    <TextBlock Margin="0,4,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrushTextSoft}"
                                                               Text="{Binding SubLine}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               Text="{Binding LineSumText}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="11"
                                                               Foreground="#FF808080"
                                                               Text="{Binding RefundReason, StringFormat='Причина: {0}'}"
                                                               Visibility="{Binding RefundReason, Converter='{StaticResource BoolToVis}', FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- Сообщение об ошибке -->
            <TextBlock x:Name="ErrorText"
                       Grid.Row="2"
                       Margin="0,10,0,0"
                       Style="{StaticResource DialogErrorText}" />

            <!-- Подвал (Expander + Закрыть) -->
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <Expander Header="Ввести ID продажи вручную"
                          Style="{StaticResource PosExpander}">
                    <StackPanel Margin="0,10,0,0">
                        <TextBox x:Name="SaleIdBox"
                                 Style="{StaticResource TouchTextBox}"
                                 MinHeight="40" />
                        <Button Content="Загрузить чек"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                MinWidth="160"
                                Style="{StaticResource TouchSecondaryButton}"
                                Click="LoadById_Click" />
                    </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Закрыть"
                            IsCancel="True"
                            Style="{StaticResource TouchGhostButton}"
                            MinWidth="110"
                            Click="Close_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>