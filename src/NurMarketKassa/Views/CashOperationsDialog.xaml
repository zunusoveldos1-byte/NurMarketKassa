<Window x:Class="NurMarketKassa.Views.CashOperationsDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Внести / Изъять наличные"
	Height="550"
	Width="600"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize"
	Style="{DynamicResource AppWindow}"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <Style
				x:Key="OperationTypePill"
				TargetType="{x:Type RadioButton}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderBrush"
					Value="{DynamicResource BrushBorder}" />
                <Setter
					Property="Padding"
					Value="16,8" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="FontSize"
					Value="15" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type RadioButton}">
                            <Border
								x:Name="pill"
								Background="{TemplateBinding Control.Background}"
								BorderBrush="{TemplateBinding Control.BorderBrush}"
								BorderThickness="1"
								CornerRadius="10"
								Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="ToggleButton.IsChecked"
									Value="True">
                                    <Setter
										TargetName="pill"
										Value="{DynamicResource BrushAccent}"
										Property="Border.Background" />
                                    <Setter
										TargetName="pill"
										Value="{DynamicResource BrushAccent}"
										Property="Border.BorderBrush" />
                                    <Setter
										Property="Foreground"
										Value="#FFFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid
		Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="Auto" />
            <RowDefinition
				Height="*" />
        </Grid.RowDefinitions>
        <TextBlock
			Text="Операции с наличными"
			FontSize="18"
			FontWeight="Bold"
			Foreground="{DynamicResource BrushText}"
			Margin="0,0,0,12" />
        <StackPanel
			Grid.Row="1"
			Orientation="Horizontal"
			Margin="0,0,0,12">
            <RadioButton
				x:Name="DepositRadio"
				Content="Внесение"
				Style="{StaticResource OperationTypePill}"
				IsChecked="True"
				GroupName="OpType" />
            <RadioButton
				x:Name="WithdrawRadio"
				Content="Изъятие"
				Style="{StaticResource OperationTypePill}"
				Margin="12,0,0,0"
				GroupName="OpType" />
        </StackPanel>
        <Grid
			Row="2"
			Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
					Width="Auto" />
                <ColumnDefinition
					Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
				Text="Сумма (сом):"
				VerticalAlignment="Center"
				Foreground="{DynamicResource BrushText}"
				Margin="0,0,10,0" />
            <TextBox
				x:Name="AmountBox"
				Grid.Column="1"
				Style="{DynamicResource TouchTextBox}"
				FontSize="16"
				MinHeight="42" />
        </Grid>
        <Grid
			Row="3"
			Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
					Width="Auto" />
                <ColumnDefinition
					Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
				Text="Комментарий:"
				VerticalAlignment="Center"
				Foreground="{DynamicResource BrushText}"
				Margin="0,0,10,0" />
            <TextBox
				x:Name="CommentBox"
				Grid.Column="1"
				Style="{DynamicResource TouchTextBox}"
				MinHeight="42"
				TextWrapping="Wrap" />
        </Grid>
        <StackPanel
			Grid.Row="4"
			Orientation="Horizontal"
			Margin="0,0,0,10">
            <Button
				Content="Сохранить"
				Style="{DynamicResource TouchPrimaryButton}"
				Width="120"
				Height="40"
				Margin="0,0,10,0"
				Click="Save_Click" />
            <Button
				Content="Закрыть"
				IsCancel="True"
				Style="{DynamicResource TouchSecondaryButton}"
				Width="100"
				Height="40" />
        </StackPanel>
        <Border
			Grid.Row="5"
			Background="{DynamicResource BrushInputAlt}"
			CornerRadius="8"
			Padding="8">
            <DockPanel>
                <TextBlock
					DockPanel.Dock="Top"
					Text="История операций"
					FontWeight="SemiBold"
					Foreground="{DynamicResource BrushText}"
					Margin="0,0,0,6" />
                <ScrollViewer
					VerticalScrollBarVisibility="Auto">
                    <ItemsControl
						x:Name="HistoryItemsControl"
						Foreground="{DynamicResource BrushText}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
									Background="{DynamicResource BrushInput}"
									CornerRadius="6"
									Padding="8,4"
									Margin="0,2">
                                    <StackPanel
										Orientation="Horizontal">
                                        <TextBlock
											Margin="0,0,12,0"
											Text="{Binding CreatedAt, StringFormat='dd.MM HH:mm'}" />
                                        <TextBlock
											Margin="0,0,8,0"
											FontWeight="SemiBold"
											Text="{Binding Type}" />
                                        <TextBlock
											FontWeight="SemiBold"
											Foreground="{DynamicResource BrushAccent}"
											Text="{Binding Amount, StringFormat='{}{0:N2} сом'}" />
                                        <TextBlock
											Foreground="{DynamicResource BrushTextSoft}"
											Margin="4,0,0,0"
											Text="{Binding Comment, StringFormat=' ({0})'}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <TextBlock
			x:Name="ErrorText"
			Grid.Row="6"
			Foreground="{DynamicResource BrushDanger}"
			TextWrapping="Wrap"
			Margin="0,8,0,0" />
    </Grid>
</Window>
