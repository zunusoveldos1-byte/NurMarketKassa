<Window
	x:Class="NurMarketKassa.Views.ProductDetailWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Карточка товара"
	Height="600"
	Width="800"
	Style="{DynamicResource AppWindow}"
	WindowStartupLocation="CenterOwner"
	ResizeMode="NoResize"
	WindowStyle="None"
	AllowsTransparency="True"
	Background="#00FFFFFF"
	xmlns:views="clr-namespace:NurMarketKassa.Converters">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <Style
				x:Key="LabelText"
				TargetType="{x:Type TextBlock}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushTextSoft}" />
                <Setter
					Property="FontSize"
					Value="11" />
            </Style>
            <Style
				x:Key="ValueText"
				TargetType="{x:Type TextBlock}">
                <Setter
					Property="Foreground"
					Value="{DynamicResource BrushText}" />
                <Setter
					Property="FontSize"
					Value="13" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
            </Style>
            <Style
				x:Key="ActionButton"
				TargetType="{x:Type Button}">
                <Setter
					Property="Height"
					Value="32" />
                <Setter
					Property="Padding"
					Value="12,0" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="FontWeight"
					Value="SemiBold" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								Background="{TemplateBinding Control.Background}"
								CornerRadius="6"
								Padding="{TemplateBinding Control.Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>
    <Border
		Background="{DynamicResource BrushWindow}"
		CornerRadius="12"
		BorderBrush="{DynamicResource BrushBorder}"
		BorderThickness="1"
		Effect="{DynamicResource CardShadow}">
        <Grid
			Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition
					Height="Auto" />
                <RowDefinition
					Height="*" />
                <RowDefinition
					Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
        Padding="0,0,0,12"
        BorderBrush="{DynamicResource BrushBorder}"
        BorderThickness="0,0,0,1">
                <Grid>
                    <Button Content="✕"
                HorizontalAlignment="Right"
                Height="32"
                Background="#00FFFFFF"
                BorderThickness="0"
                Foreground="{DynamicResource BrushText}"
                FontSize="18"
                Click="Close_Click" />
                </Grid>
            </Border>
            <Grid
				Row="1"
				Margin="0,12,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
						Width="Auto" />
                    <ColumnDefinition
						Width="*" />
                </Grid.ColumnDefinitions>
                <Border
					Grid.Column="0"
					Width="160"
					Height="160"
					Background="{DynamicResource BrushInputAlt}"
					CornerRadius="12"
					Margin="0,0,16,0">
                    <TextBlock
						Text="📷"
						FontSize="48"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{DynamicResource BrushTextSoft}" />
                </Border>
                <Grid
					Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="Auto" />
                        <RowDefinition
							Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
						FontSize="20"
						FontWeight="Bold"
						Foreground="{DynamicResource BrushText}"
						Margin="0,0,0,8"
						Text="{Binding Product.ProductName, FallbackValue='Название товара'}" />
                    <StackPanel
						Grid.Row="1"
						Orientation="Horizontal"
						Margin="0,0,0,12">
                        <Border
							Background="{DynamicResource BrushInputAlt}"
							CornerRadius="6"
							Padding="8,4"
							Margin="0,0,8,0">
                            <TextBlock
								Foreground="{DynamicResource BrushText}"
								FontSize="13"
								Text="{Binding Product.Barcode, StringFormat='ШК: {0}', FallbackValue='ШК: 123456789'}" />
                        </Border>
                        <Border
							Background="{DynamicResource BrushInputAlt}"
							CornerRadius="6"
							Padding="8,4"
							Margin="0,0,8,0">
                            <TextBlock
								Foreground="{DynamicResource BrushText}"
								FontSize="13"
								Text="{Binding Product.Article, StringFormat='Артикул: {0}', FallbackValue='Артикул: ART-001'}" />
                        </Border>
                        <Border
							Background="{DynamicResource BrushInputAlt}"
							CornerRadius="6"
							Padding="8,4">
                            <TextBlock
								Foreground="{DynamicResource BrushText}"
								FontSize="13"
								Text="{Binding Product.Code, StringFormat='Код: {0}', FallbackValue='Код: 0001'}" />
                        </Border>
                    </StackPanel>
                    <GroupBox
						Grid.Row="2"
						Header="Информация"
						Foreground="{DynamicResource BrushText}"
						BorderBrush="{DynamicResource BrushBorder}">
                        <Grid
							Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
									Width="*" />
                                <ColumnDefinition
									Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition
									Height="Auto" />
                                <RowDefinition
									Height="Auto" />
                                <RowDefinition
									Height="Auto" />
                                <RowDefinition
									Height="Auto" />
                                <RowDefinition
									Height="Auto" />
                                <RowDefinition
									Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
								Grid.Row="0"
								Grid.Column="0"
								Text="Создан"
								Style="{StaticResource LabelText}" />
                            <TextBlock
								Grid.Row="0"
								Grid.Column="1"
								Style="{StaticResource ValueText}"
								Margin="0,0,0,4"
								Text="{Binding Product.CreatedAt, StringFormat='dd.MM.yyyy HH:mm', FallbackValue='01.05.2025 12:00'}" />
                            <TextBlock
								Grid.Row="1"
								Grid.Column="0"
								Text="Категория"
								Style="{StaticResource LabelText}" />
                            <TextBlock
								Grid.Row="1"
								Grid.Column="1"
								Style="{StaticResource ValueText}"
								Margin="0,0,0,4"
								Text="{Binding Product.Category, FallbackValue=Овощи}" />
                            <TextBlock
								Grid.Row="2"
								Grid.Column="0"
								Text="Страна"
								Style="{StaticResource LabelText}" />
                            <TextBlock
								Grid.Row="2"
								Grid.Column="1"
								Style="{StaticResource ValueText}"
								Margin="0,0,0,4"
								Text="{Binding Product.Country, FallbackValue=Кыргызстан}" />
                            <TextBlock
								Grid.Row="3"
								Grid.Column="0"
								Text="Срок годности"
								Style="{StaticResource LabelText}" />
                            <TextBlock
								Grid.Row="3"
								Grid.Column="1"
								Style="{StaticResource ValueText}"
								Margin="0,0,0,4"
								Text="{Binding Product.ExpiryDate, StringFormat=dd.MM.yyyy, FallbackValue=31.12.2025}" />
                            <TextBlock
								Grid.Row="4"
								Grid.Column="0"
								Text="Группа"
								Style="{StaticResource LabelText}" />
                            <TextBlock
								Grid.Row="4"
								Grid.Column="1"
								Style="{StaticResource ValueText}"
								Margin="0,0,0,4"
								Text="{Binding Product.Group, FallbackValue=Продовольственные}" />
                            <TextBlock
								Grid.Row="5"
								Grid.Column="0"
								Text="Описание"
								Style="{StaticResource LabelText}" />
                            <TextBlock
								Grid.Row="5"
								Grid.Column="1"
								Style="{StaticResource ValueText}"
								TextWrapping="Wrap"
								Text="{Binding Product.Description, FallbackValue='Свежая картошка'}" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </Grid>
            <Border
				Grid.Row="2"
				Background="{DynamicResource BrushPanel}"
				CornerRadius="12"
				Padding="16"
				Margin="0,12,0,0">
                <StackPanel
					Orientation="Horizontal"
					HorizontalAlignment="Right">
                    <StackPanel
						Margin="0,0,32,0">
                        <TextBlock
							Text="Цена продажи"
							Style="{StaticResource LabelText}"
							HorizontalAlignment="Right" />
                        <TextBlock
							FontSize="24"
							FontWeight="Bold"
							Foreground="{DynamicResource BrushAccent}"
							HorizontalAlignment="Right"
							Text="{Binding Product.Price, StringFormat='{}{0:N2} сом', FallbackValue='45.00 сом'}" />
                    </StackPanel>
                    <StackPanel
						Margin="0,0,32,0">
                        <TextBlock
							Text="Цена закупки"
							Style="{StaticResource LabelText}"
							HorizontalAlignment="Right" />
                        <TextBlock
							FontSize="24"
							FontWeight="Bold"
							Foreground="{DynamicResource BrushTextMuted}"
							HorizontalAlignment="Right"
							Text="{Binding Product.PurchasePrice, StringFormat='{}{0:N2} сом', FallbackValue='30.00 сом'}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock
							Text="Наценка"
							Style="{StaticResource LabelText}"
							HorizontalAlignment="Right" />
                        <TextBlock
							FontSize="24"
							FontWeight="Bold"
							Foreground="{DynamicResource BrushSuccess}"
							HorizontalAlignment="Right"
							Text="{Binding Product.MarkupPercent, StringFormat={}{0:P1}, FallbackValue='50.0 %'}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
