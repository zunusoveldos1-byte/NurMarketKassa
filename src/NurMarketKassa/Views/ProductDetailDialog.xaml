<Window x:Class="NurMarketKassa.Views.ProductDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подробнее о товаре" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="18" FontWeight="Bold" 
                   TextWrapping="Wrap" Margin="0,0,0,15"/>

        <!-- Основное содержимое -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Изображение -->
            <Border Grid.Column="0" Width="180" Height="180" Margin="0,0,20,0"
                    Background="{StaticResource BrushPanelSoft}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1" CornerRadius="6"
                    ClipToBounds="True">
                <Grid>
                    <Image x:Name="ProductImage" Source="{Binding Thumb}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="LowQuality"/>
                    <TextBlock x:Name="LoadingText" Text="Загрузка фото…" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}"/>
                    <TextBlock x:Name="NoPhotoText" Text="Нет фото" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushTextMuted}" Visibility="Collapsed"/>
                </Grid>
            </Border>

            <!-- Информация -->
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <!-- Штрихкод -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Штрихкод:" FontWeight="SemiBold" Width="90"
                               Foreground="{StaticResource BrushTextSoft}"/>
                    <TextBlock Text="{Binding Barcode}" 
                               Foreground="{StaticResource BrushText}"
                               FontFamily="Consolas" FontSize="13"/>
                </StackPanel>

                <!-- Цена -->
                <StackPanel Orientation="Horizontal" Margin="0,10">
                    <TextBlock Text="Цена:" FontWeight="SemiBold" Width="90"
                               Foreground="{StaticResource BrushTextSoft}"/>
                    <TextBlock Text="{Binding PriceLine}" 
                               Foreground="{StaticResource BrushAccentStrong}"
                               FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Кнопка закрытия -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Закрыть" Click="Close_Click" 
                    Style="{StaticResource TouchSecondaryButton}" Padding="12,8"/>
        </StackPanel>
    </Grid>
</Window>