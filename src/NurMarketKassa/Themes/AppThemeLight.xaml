			Property="TextOptions.TextFormattingMode"
			Value="Display" />
        <Setter
			Property="TextOptions.TextRenderingMode"
			Value="ClearType" />
        <Setter
			Property="RenderOptions.BitmapScalingMode"
			Value="LowQuality" />
