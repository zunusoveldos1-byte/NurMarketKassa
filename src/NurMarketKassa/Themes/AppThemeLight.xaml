<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BrushWindow" Color="#EFF3F8"/>
    <SolidColorBrush x:Key="BrushWindowAlt" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushPanelElevated" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushPanelSoft" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BrushInput" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushInputAlt" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushText" Color="#0F172A"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#334155"/>
    <SolidColorBrush x:Key="BrushTextSoft" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#F7D617"/>
    <SolidColorBrush x:Key="BrushAccentStrong" Color="#D6B500"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#FFF7C2"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#F7D617"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#FFF7C2"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#B45309"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#B91C1C"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#FEE2E2"/>
    <SolidColorBrush x:Key="BrushOverlay" Color="#D9F8FAFC"/>
    <SolidColorBrush x:Key="BrushFocus" Color="#2563EB"/>
    <SolidColorBrush x:Key="BrushSurfaceSubtle" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="BrushUiStatusMuted" Color="#64748B"/>
    <SolidColorBrush x:Key="BrushUiStatusOk" Color="#059669"/>
    <SolidColorBrush x:Key="BrushUiStatusWarn" Color="#D97706"/>
    <SolidColorBrush x:Key="BrushShiftOpenBg" Color="#DCFCE7"/>
    <SolidColorBrush x:Key="BrushShiftOpenBorder" Color="#22C55E"/>
    <SolidColorBrush x:Key="BrushShiftWarnBg" Color="#FEF3C7"/>
    <SolidColorBrush x:Key="BrushShiftWarnBorder" Color="#D97706"/>
    <SolidColorBrush x:Key="BrushToastNeutralBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushToastWarnBg" Color="#FDE68A"/>

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="16"
                      ShadowDepth="0"
                      Opacity="0.14"
                      Color="#64748B"/>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushWindow}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="ElevatedCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource BrushPanelElevated}"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style x:Key="ModernSectionBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="ModernInfoPanel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource BrushInputAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
    </Style>

    <Style x:Key="SectionCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSoft}"/>
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>

    <Style x:Key="TouchPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Foreground" Value="#111827"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.74"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.40"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TouchSecondaryButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushPanelSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="TouchDangerButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushDangerSoft}"/>
        <Setter Property="Foreground" Value="#7F1D1D"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="TouchGhostButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushInputAlt}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}"/>

    <Style x:Key="TouchMiniButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TouchTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BrushInput}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TouchPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource BrushInput}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="42"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TouchComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushInput}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="42"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TouchCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <Style x:Key="TouchRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <Style x:Key="DialogLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>
    <Style x:Key="DialogErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="DialogInlineValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
    </Style>

    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushInputAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="CatalogTileButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter Property="Width" Value="120"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="MinHeight" Value="132"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <Style x:Key="PosCatalogTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="PosCatalogTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PosExpander" TargetType="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8CB;"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <Binding Path="Header" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
