			Value="0" />
        <Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
        <Setter
			Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel
						Orientation="Horizontal">
                        <TextBlock
							FontFamily="Segoe MDL2 Assets"
							Text=""
							FontSize="14"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{StaticResource BrushAccent}" />
                        <TextBlock
							VerticalAlignment="Center"
							FontSize="12"
							FontWeight="SemiBold"
							Foreground="{StaticResource BrushTextMuted}"
							Text="{Binding Path=Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
