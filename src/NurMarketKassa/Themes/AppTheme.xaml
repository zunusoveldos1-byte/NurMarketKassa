    <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}"/>

    <Style x:Key="TouchMiniButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="TouchTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#252526"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#454545"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TouchPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="#2D2D2D"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#454545"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="42"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
                <Setter Property="BorderThickness" Value="0,0,0,2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TouchComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource BrushInput}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="42"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TouchCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <Style x:Key="TouchRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,2,12,2"/>
    </Style>

    <Style x:Key="DialogLabelText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSoft}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DialogTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>
    <Style x:Key="DialogErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="DialogInlineValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
    </Style>

    <Style x:Key="BadgeBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushInputAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

    <Style x:Key="CatalogTileButton" TargetType="Button" BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter Property="Width" Value="108"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="MinHeight" Value="118"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- Вкладки каталога на главном экране -->
    <Style x:Key="PosCatalogTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="PosCatalogTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Background" Value="#333333"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabRoot" Property="Background" Value="#3A3A3A"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabRoot" Property="Background" Value="#007ACC"/>
                            <Setter TargetName="TabRoot" Property="BorderBrush" Value="#2895E8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Expander: шапка с иконкой, единый вид в окнах -->
    <Style x:Key="PosExpander" TargetType="Expander">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE8CB;"
                                   FontSize="14"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushAccent}"/>
                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="12"
                                   FontWeight="SemiBold">
                            <TextBlock.Text>
                                <Binding Path="Header" RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}"/>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
