<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BrushWindow" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BrushWindowAlt" Color="#252526"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#252526"/>
    <SolidColorBrush x:Key="BrushPanelElevated" Color="#2B2B2C"/>
    <SolidColorBrush x:Key="BrushPanelSoft" Color="#333333"/>
    <SolidColorBrush x:Key="BrushInput" Color="#252526"/>
    <SolidColorBrush x:Key="BrushInputAlt" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="BrushBorder" Color="#454545"/>
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="BrushText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BrushTextMuted" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="BrushTextSoft" Color="#A9A9A9"/>
    <SolidColorBrush x:Key="BrushAccent" Color="#007ACC"/>
    <SolidColorBrush x:Key="BrushAccentStrong" Color="#2895E8"/>
    <SolidColorBrush x:Key="BrushAccentSoft" Color="#1F3B52"/>
    <SolidColorBrush x:Key="BrushSuccess" Color="#007ACC"/>
    <SolidColorBrush x:Key="BrushSuccessSoft" Color="#1F3B52"/>
    <SolidColorBrush x:Key="BrushWarning" Color="#D7BA7D"/>
    <SolidColorBrush x:Key="BrushWarningSoft" Color="#3A3122"/>
    <SolidColorBrush x:Key="BrushDanger" Color="#F14C4C"/>
    <SolidColorBrush x:Key="BrushDangerSoft" Color="#522626"/>
    <SolidColorBrush x:Key="BrushOverlay" Color="#D90A0F18"/>
    <SolidColorBrush x:Key="BrushFocus" Color="#007ACC"/>
    <SolidColorBrush x:Key="BrushSurfaceSubtle" Color="#252526"/>
    <Color x:Key="ColorPrimaryDefault">#007ACC</Color>
    <Color x:Key="ColorPrimaryHover">#1A88D6</Color>
    <Color x:Key="ColorPrimaryPressed">#0066B8</Color>
    <Color x:Key="ColorSecondaryDefault">#333333</Color>
    <Color x:Key="ColorSecondaryHover">#3D3D3D</Color>
    <Color x:Key="ColorSecondaryPressed">#2E2E2E</Color>
    <Color x:Key="ColorGhostDefault">#2D2D2D</Color>
    <Color x:Key="ColorGhostHover">#383838</Color>
    <Color x:Key="ColorGhostPressed">#252526</Color>
    <Color x:Key="ColorDangerDefault">#F14C4C</Color>
    <Color x:Key="ColorDangerHover">#FF6666</Color>
    <Color x:Key="ColorDangerPressed">#D64545</Color>

    <!-- Статусы UI / смена / тосты (используются из кода MainWindow) -->
    <SolidColorBrush x:Key="BrushUiStatusMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="BrushUiStatusOk" Color="#34D399"/>
    <SolidColorBrush x:Key="BrushUiStatusWarn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="BrushShiftOpenBg" Color="#143D2C"/>
    <SolidColorBrush x:Key="BrushShiftOpenBorder" Color="#166534"/>
    <SolidColorBrush x:Key="BrushShiftWarnBg" Color="#422706"/>
    <SolidColorBrush x:Key="BrushShiftWarnBorder" Color="#B45309"/>
    <SolidColorBrush x:Key="BrushToastNeutralBg" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrushToastWarnBg" Color="#B45309"/>

    <DropShadowEffect x:Key="CardShadow"
                      BlurRadius="10"
                      ShadowDepth="0"
                      Opacity="0.10"
                      Color="#000000"/>

    <Style x:Key="AppWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BrushWindow}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality"/>
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushPanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="ElevatedCardBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource BrushPanelElevated}"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>
    <Style x:Key="ModernSectionBorder" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource BrushSurfaceSubtle}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style x:Key="ModernInfoPanel" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Background" Value="{StaticResource BrushInputAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <Style x:Key="SectionTitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
    </Style>

    <Style x:Key="SectionCaptionText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSoft}"/>
    </Style>

    <Style x:Key="MetricValueText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
    </Style>

    <Style x:Key="TouchPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushAccentStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <SolidColorBrush x:Key="AnimatedBackgroundBrush" Color="{StaticResource ColorPrimaryDefault}"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="Root"
                            Background="{StaticResource AnimatedBackgroundBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorPrimaryHover}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorPrimaryPressed}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.45"
                                                         Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter TargetName="Root"
                                    Property="Background"
                                    Value="{StaticResource AnimatedBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushFocus}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TouchSecondaryButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushPanelSoft}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderStrong}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <SolidColorBrush x:Key="AnimatedBackgroundBrush" Color="{StaticResource ColorSecondaryDefault}"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="Root"
                            Background="{StaticResource AnimatedBackgroundBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorSecondaryHover}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorSecondaryPressed}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TouchDangerButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <SolidColorBrush x:Key="AnimatedBackgroundBrush" Color="{StaticResource ColorDangerDefault}"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="Root"
                            Background="{StaticResource AnimatedBackgroundBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorDangerHover}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorDangerPressed}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TouchGhostButton" TargetType="Button" BasedOn="{StaticResource TouchPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushInputAlt}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ControlTemplate.Resources>
                        <SolidColorBrush x:Key="AnimatedBackgroundBrush" Color="{StaticResource ColorGhostDefault}"/>
                    </ControlTemplate.Resources>
                    <Border x:Name="Root"
                            Background="{StaticResource AnimatedBackgroundBrush}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorGhostHover}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Root"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="{StaticResource ColorGhostPressed}"
                                                        Duration="0:0:0.2"/>
                                    </Storyboard>
