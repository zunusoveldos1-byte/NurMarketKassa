		BasedOn="{StaticResource TouchSecondaryButton}">
        <Setter
			Property="Width"
			Value="108" />
        <Setter
			Property="Padding"
			Value="4" />
        <Setter
			Property="Margin"
			Value="4" />
        <Setter
			Property="MinHeight"
			Value="118" />
        <Setter
			Property="VerticalContentAlignment"
			Value="Stretch" />
        <Setter
			Property="HorizontalContentAlignment"
			Value="Stretch" />
    </Style>
    <Style
		x:Key="PosCatalogTabControl"
		TargetType="{x:Type TabControl}">
        <Setter
			Property="Background"
			Value="#00FFFFFF" />
        <Setter
			Property="BorderThickness"
			Value="0" />
        <Setter
			Property="Padding"
			Value="0" />
    </Style>
    <Style
		x:Key="PosCatalogTabItem"
		TargetType="{x:Type TabItem}">
        <Setter
			Property="Foreground"
			Value="{StaticResource BrushTextMuted}" />
        <Setter
			Property="FontSize"
			Value="13" />
        <Setter
			Property="FontWeight"
			Value="SemiBold" />
        <Setter
			Property="Padding"
			Value="16,10" />
        <Setter
			Property="Margin"
			Value="0,0,6,0" />
        <Setter
			Property="Background"
			Value="#333333" />
        <Setter
			Property="BorderBrush"
			Value="{StaticResource BrushBorder}" />
        <Setter
			Property="BorderThickness"
			Value="1" />
        <Setter
			Property="Template">
            <Setter.Value>
                <ControlTemplate
					TargetType="{x:Type TabItem}">
                    <Border
						x:Name="TabRoot"
						Background="{TemplateBinding Control.Background}"
						BorderBrush="{TemplateBinding Control.BorderBrush}"
						BorderThickness="{TemplateBinding Control.BorderThickness}"
						CornerRadius="5"
						Padding="{TemplateBinding Control.Padding}">
                        <ContentPresenter
							ContentSource="Header"
							HorizontalAlignment="Center"
							VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger
							Property="UIElement.IsMouseOver"
							Value="True">
                            <Setter
								TargetName="TabRoot"
								Property="Border.Background"
								Value="#3A3A3A" />
                        </Trigger>
                        <Trigger
							Property="TabItem.IsSelected"
							Value="True">
                            <Setter
								TargetName="TabRoot"
								Property="Border.Background"
								Value="#007ACC" />
                            <Setter
								TargetName="TabRoot"
								Property="Border.BorderBrush"
								Value="#2895E8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger
				Property="TabItem.IsSelected"
				Value="True">
                <Setter
					Property="Foreground"
					Value="#FFFFFF" />
                <Setter
					Property="FontWeight"
					Value="Bold" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style
		x:Key="PosExpander"
		TargetType="{x:Type Expander}">
        <Setter
			Property="Background"
			Value="#00FFFFFF" />
        <Setter
			Property="Foreground"
			Value="{StaticResource BrushTextMuted}" />
        <Setter
			Property="FontSize"
			Value="12" />
        <Setter
			Property="FontWeight"
			Value="SemiBold" />
        <Setter
			Property="Padding"
			Value="0" />
        <Setter
			Property="BorderThickness"
			Value="0" />
        <Setter
			Property="UIElement.SnapsToDevicePixels"
			Value="True" />
        <Setter
			Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel
						Orientation="Horizontal">
                        <TextBlock
							FontFamily="Segoe MDL2 Assets"
							Text=""
							FontSize="14"
							Margin="0,0,8,0"
							VerticalAlignment="Center"
							Foreground="{StaticResource BrushAccent}" />
                        <TextBlock
							VerticalAlignment="Center"
							FontSize="12"
							FontWeight="SemiBold"
							Foreground="{StaticResource BrushTextMuted}"
							Text="{Binding Path=Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
