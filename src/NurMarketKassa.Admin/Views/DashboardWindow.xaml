<Window x:Class="NurMarketKassa.Admin.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:NurMarketKassa.Converters;assembly=NurCrmKassa"
        xmlns:adminConv="clr-namespace:NurMarketKassa.Admin.Converters"
        Title="NurMarket Admin"
        Height="860"
        Width="1280"
        MinHeight="640"
        MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Loaded="Window_Loaded">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <adminConv:TerminalStatusToBrushConverter x:Key="TerminalStatusBrush" />
            <adminConv:AdminSectionToVisibilityConverter x:Key="SectionVis" />
            <adminConv:AdminSectionNavActiveConverter x:Key="NavActive" />

            <SolidColorBrush x:Key="SidebarBg" Color="#1A1A1A" />
            <SolidColorBrush x:Key="SidebarBorder" Color="#2A2A2A" />
            <SolidColorBrush x:Key="NavActiveBg" Color="#2D4F9E" />
            <SolidColorBrush x:Key="NavHoverBg" Color="#252525" />
            <SolidColorBrush x:Key="ContentBg" Color="#1E1E1E" />
            <SolidColorBrush x:Key="CardBg" Color="#252526" />
            <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
            <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />

            <Style x:Key="NavButton" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Margin" Value="8,4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="navBorder" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavHoverBg}" />
                                </Trigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource NavActive}">
                                            <Binding Path="DataContext.SelectedSection" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="navBorder" Property="Background" Value="{StaticResource NavActiveBg}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AdminGridColumnHeader" TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="#2A2A2A" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="#3A3A3A" />
            </Style>
            <Style x:Key="AdminGridCell" TargetType="{x:Type DataGridCell}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
            <Style x:Key="AdminGridRow" TargetType="{x:Type DataGridRow}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Style.Triggers>
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#2A2A2A" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TerminalGridRow" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource AdminGridRow}">
                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource TerminalStatusBrush}}" />
            </Style>
            <Style x:Key="AdminGrid" TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="AlternatingRowBackground" Value="#2A2A2A" />
                <Setter Property="AlternationCount" Value="2" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="#3A3A3A" />
                <Setter Property="RowHeight" Value="38" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#3A3A3A" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource AdminGridColumnHeader}" />
                <Setter Property="CellStyle" Value="{StaticResource AdminGridCell}" />
                <Setter Property="RowStyle" Value="{StaticResource AdminGridRow}" />
            </Style>
            <Style x:Key="PanelTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>
            <Style x:Key="CardBorder" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="BorderBrush" Value="#3A3A3A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </FrameworkElement.Resources>

    <Grid Background="{StaticResource ContentBg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель навигации -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}" BorderBrush="{StaticResource SidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,20,0,16">
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,24">
                    <TextBlock Text="NurMarket" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Admin" FontFamily="Segoe UI" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,0">
                    <Button Content="↻  Обновить данные" Click="Refresh_Click"
                            Background="#2A2A2A" Foreground="White" BorderBrush="#3A3A3A"
                            BorderThickness="1" Padding="14,10" Margin="8,0,8,12" Cursor="Hand" />
                    <TextBlock Text="{Binding DbStatusText}" Foreground="{StaticResource TextMuted}"
                               FontSize="12" Margin="16,0,16,4" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" Foreground="#6B7280"
                               FontSize="11" Margin="16,0,16,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="4,0,4,0">
                    <Button Style="{StaticResource NavButton}" Tag="Terminals" Click="NavTerminals_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖥" Margin="0,0,10,0" />
                            <TextBlock Text="Мониторинг касс" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Logs" Click="NavLogs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,10,0" />
                            <TextBlock Text="Логи и события" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="Finance" Click="NavFinance_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" Margin="0,0,10,0" />
                            <TextBlock Text="Отчеты и продажи" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Контентная зона -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <!-- Терминалы -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Terminals}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Активные кассы и терминалы" />
                    <DataGrid Grid.Row="1" Style="{StaticResource AdminGrid}"
                              RowStyle="{StaticResource TerminalGridRow}"
                              ItemsSource="{Binding Terminals}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Устройство" Width="*" Binding="{Binding DeviceName}" />
                            <DataGridTextColumn Header="Статус" Width="100" Binding="{Binding StatusLabel}" />
                            <DataGridTextColumn Header="Последняя активность" Width="200"
                                                Binding="{Binding LastSeen, StringFormat='dd.MM.yyyy HH:mm:ss'}" />
                            <DataGridTextColumn Header="Событий (24ч)" Width="120" Binding="{Binding EventCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Логи -->
            <Border Style="{StaticResource CardBorder}"
                    Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Logs}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Логи синхронизации и событий" />
                    <DataGrid Grid.Row="1" Style="{StaticResource AdminGrid}" ItemsSource="{Binding SyncLogs}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Width="160"
                                                Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" />
                            <DataGridTextColumn Header="Категория" Width="110" Binding="{Binding Category}" />
                            <DataGridTextColumn Header="Действие" Width="140" Binding="{Binding Action}" />
                            <DataGridTextColumn Header="Устройство" Width="140" Binding="{Binding DeviceName}" />
                            <DataGridTextColumn Header="Детали" Width="*" Binding="{Binding Details}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Финансы и склад -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedSection, Converter={StaticResource SectionVis}, ConverterParameter=Finance}">
                <StackPanel>
                    <TextBlock Style="{StaticResource PanelTitle}" Text="Финансы, продажи и движение остатков" />

                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Период отчёта" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="С" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="0,0,8,0" />
                                <DatePicker SelectedDate="{Binding ReportFrom}" Width="140" />
                                <TextBlock Text="по" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" Margin="16,0,8,0" />
                                <DatePicker SelectedDate="{Binding ReportTo}" Width="140" />
                                <Button Content="Excel (продажи)" Click="ExportSalesExcel_Click"
                                        Background="#374151" Foreground="White" Padding="12,8" Margin="20,0,0,0" Cursor="Hand" />
                                <Button Content="PDF (продажи)" Click="ExportSalesPdf_Click"
                                        Background="#374151" Foreground="White" Padding="12,8" Margin="8,0,0,0" Cursor="Hand" />
                                <Button Content="Excel (ledger)" Click="ExportLedgerExcel_Click"
                                        Background="#374151" Foreground="White" Padding="12,8" Margin="8,0,0,0" Cursor="Hand" />
                                <Button Content="PDF (ledger)" Click="ExportLedgerPdf_Click"
                                        Background="#374151" Foreground="White" Padding="12,8" Margin="8,0,0,0" Cursor="Hand" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="280" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Сводка продаж (7 дней)" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AdminGrid}" ItemsSource="{Binding SalesSummary}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Дата" Width="120"
                                                            Binding="{Binding Date, StringFormat='dd.MM.yyyy'}" />
                                        <DataGridTextColumn Header="Чеков" Width="80" Binding="{Binding SaleCount}" />
                                        <DataGridTextColumn Header="Сумма, сом" Width="*"
                                                            Binding="{Binding TotalAmount, StringFormat='{}{0:N2}'}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="280" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Складские события (audit)" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                                <DataGrid Grid.Row="1" Style="{StaticResource AdminGrid}" ItemsSource="{Binding StockEvents}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Время" Width="140"
                                                            Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" />
                                        <DataGridTextColumn Header="Действие" Width="100" Binding="{Binding Action}" />
                                        <DataGridTextColumn Header="Товар ID" Width="*" Binding="{Binding ProductId}" />
                                        <DataGridTextColumn Header="Кол-во" Width="80" Binding="{Binding Quantity}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="320" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Журнал stock_ledger" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10" />
                            <DataGrid Grid.Row="1" Style="{StaticResource AdminGrid}" ItemsSource="{Binding StockLedger}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Время" Width="150"
                                                        Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" />
                                    <DataGridTextColumn Header="Товар ID" Width="*" Binding="{Binding ProductId}" />
                                    <DataGridTextColumn Header="Дельта" Width="90" Binding="{Binding Delta, StringFormat='{}{0:0.###}'}" />
                                    <DataGridTextColumn Header="Причина" Width="100" Binding="{Binding Reason}" />
                                    <DataGridTextColumn Header="Ссылка" Width="160" Binding="{Binding ReferenceId}" />
                                    <DataGridTextColumn Header="Устройство" Width="120" Binding="{Binding DeviceName}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Оверлей загрузки -->
            <Border Background="#80000000" Panel.ZIndex="20"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Загрузка данных..." Foreground="White" FontSize="18" Margin="0,0,0,12" />
                    <ProgressBar IsIndeterminate="True" Width="240" Height="8" Foreground="#3B82F6" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
