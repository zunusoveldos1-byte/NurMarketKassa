<Window x:Class="NurMarketKassaSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка Nur Market Kassa"
        Icon="pack://application:,,,/Assets/app-logo.png"
        Width="520"
        Height="280"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/app-logo.png"
                   Width="44"
                   Height="44"
                   Margin="0,0,12,0"
                   RenderOptions.BitmapScalingMode="LowQuality"/>
            <TextBlock Text="Установка Nur Market Kassa"
                       FontSize="22"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Margin="0,12,0,0"
                   Text="Приложение будет установлено в LocalAppData\\Programs\\NurMarketKassa"
                   TextWrapping="Wrap"/>

        <TextBox x:Name="LogBox"
                 Grid.Row="2"
                 Margin="0,14,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="3"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="InstallButton"
                    Content="Установить"
                    Width="120"
                    Height="36"
                    Margin="0,0,8,0"
                    Click="Install_Click"/>
            <Button x:Name="CloseButton"
                    Content="Закрыть"
                    Width="120"
                    Height="36"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
